      "dc-live-name": "{{asset "/js/components/live-name.js"}}",
      "dc-time": "{{asset "/js/components/dc-time.js"}}",
      "dc-theme-cycle": "{{asset "/js/components/theme-cycle.js"}}",
      "dc-ctx-sheet": "{{asset "/js/components/ctx-sheet.js"}}",
      "dc-editor": "{{asset "/js/components/editor.js"}}",
      "dc-jingle-picker": "{{asset "/js/components/jingle-picker.js"}}",
      "dc-notify-volume": "{{asset "/js/components/notify-volume.js"}}",
      "dc-assistant-volume": "{{asset "/js/components/assistant-volume.js"}}",
      "dc-push-settings": "{{asset "/js/components/push-settings.js"}}",
      "dc-backup-busy": "{{asset "/js/components/backup-busy.js"}}",
      "dc-backup-sections": "{{asset "/js/components/backup-sections.js"}}",
      "dc-backup-list": "{{asset "/js/components/backup-list.js"}}",
      "dc-backup-upload": "{{asset "/js/components/backup-upload.js"}}",
      "coder-file-upload": "{{asset "/js/components/coder-file-upload.js"}}",
      "terminal-attach": "{{asset "/js/components/terminal-attach.js"}}",
      "terminal-tabs": "{{asset "/js/components/terminal-tabs.js"}}",
      "terminal-input": "{{asset "/js/components/terminal-input.js"}}",
      "terminal-setting-select": "{{asset "/js/components/terminal-setting-select.js"}}",
      "terminal-scroll-zone": "{{asset "/js/components/terminal-scroll-zone.js"}}",
      "terminal-swipe-nav": "{{asset "/js/components/terminal-swipe-nav.js"}}",
      "terminal-split": "{{asset "/js/components/terminal-split.js"}}",
      "terminal-direction-pad": "{{asset "/js/components/terminal-direction-pad.js"}}",
      "@marein/js-scriptune": "https://cdn.jsdelivr.net/npm/@marein/js-scriptune@0.0.1/src/scriptune.min.js",
      "@codemirror/autocomplete": "https://cdn.jsdelivr.net/npm/@codemirror/autocomplete@6.17.0/dist/index.js",
      "@codemirror/commands": "https://cdn.jsdelivr.net/npm/@codemirror/commands@6.6.0/dist/index.js",
      "@codemirror/lang-cpp": "https://cdn.jsdelivr.net/npm/@codemirror/lang-cpp@6.0.2/dist/index.js",
      "@codemirror/lang-css": "https://cdn.jsdelivr.net/npm/@codemirror/lang-css@6.2.1/dist/index.js",
      "@codemirror/lang-go": "https://cdn.jsdelivr.net/npm/@codemirror/lang-go@6.0.0/dist/index.js",
      "@codemirror/lang-html": "https://cdn.jsdelivr.net/npm/@codemirror/lang-html@6.4.9/dist/index.js",
      "@codemirror/lang-java": "https://cdn.jsdelivr.net/npm/@codemirror/lang-java@6.0.1/dist/index.js",
      "@codemirror/lang-javascript": "https://cdn.jsdelivr.net/npm/@codemirror/lang-javascript@6.2.2/dist/index.js",
      "@codemirror/lang-json": "https://cdn.jsdelivr.net/npm/@codemirror/lang-json@6.0.1/dist/index.js",
      "@codemirror/lang-markdown": "https://cdn.jsdelivr.net/npm/@codemirror/lang-markdown@6.2.5/dist/index.js",
      "@codemirror/lang-php": "https://cdn.jsdelivr.net/npm/@codemirror/lang-php@6.0.1/dist/index.js",
      "@codemirror/lang-python": "https://cdn.jsdelivr.net/npm/@codemirror/lang-python@6.1.6/dist/index.js",
      "@codemirror/lang-rust": "https://cdn.jsdelivr.net/npm/@codemirror/lang-rust@6.0.1/dist/index.js",
      "@codemirror/lang-sql": "https://cdn.jsdelivr.net/npm/@codemirror/lang-sql@6.7.0/dist/index.js",
      "@codemirror/lang-xml": "https://cdn.jsdelivr.net/npm/@codemirror/lang-xml@6.1.0/dist/index.js",
      "@codemirror/lang-yaml": "https://cdn.jsdelivr.net/npm/@codemirror/lang-yaml@6.1.1/dist/index.js",
      "@codemirror/language": "https://cdn.jsdelivr.net/npm/@codemirror/language@6.10.2/dist/index.js",
      "@codemirror/lint": "https://cdn.jsdelivr.net/npm/@codemirror/lint@6.8.1/dist/index.js",
      "@codemirror/merge": "https://cdn.jsdelivr.net/npm/@codemirror/merge@6.12.2/dist/index.js",
      "@codemirror/search": "https://cdn.jsdelivr.net/npm/@codemirror/search@6.5.6/dist/index.js",
      "@codemirror/state": "https://cdn.jsdelivr.net/npm/@codemirror/state@6.4.1/dist/index.js",
      "@codemirror/theme-one-dark": "https://cdn.jsdelivr.net/npm/@codemirror/theme-one-dark@6.1.2/dist/index.js",
      "@codemirror/view": "https://cdn.jsdelivr.net/npm/@codemirror/view@6.26.3/dist/index.js",
      "@lezer/common": "https://cdn.jsdelivr.net/npm/@lezer/common@1.2.3/dist/index.js",
      "@lezer/cpp": "https://cdn.jsdelivr.net/npm/@lezer/cpp@1.1.6/dist/index.js",
      "@lezer/css": "https://cdn.jsdelivr.net/npm/@lezer/css@1.3.3/dist/index.js",
      "@lezer/go": "https://cdn.jsdelivr.net/npm/@lezer/go@1.0.1/dist/index.js",
      "@lezer/highlight": "https://cdn.jsdelivr.net/npm/@lezer/highlight@1.2.1/dist/index.js",
      "@lezer/html": "https://cdn.jsdelivr.net/npm/@lezer/html@1.3.13/dist/index.js",
      "@lezer/java": "https://cdn.jsdelivr.net/npm/@lezer/java@1.1.3/dist/index.js",
      "@lezer/javascript": "https://cdn.jsdelivr.net/npm/@lezer/javascript@1.5.4/dist/index.js",
      "@lezer/json": "https://cdn.jsdelivr.net/npm/@lezer/json@1.0.3/dist/index.js",
      "@lezer/lr": "https://cdn.jsdelivr.net/npm/@lezer/lr@1.4.2/dist/index.js",
      "@lezer/markdown": "https://cdn.jsdelivr.net/npm/@lezer/markdown@1.6.4/dist/index.js",
      "@lezer/php": "https://cdn.jsdelivr.net/npm/@lezer/php@1.0.5/dist/index.js",
      "@lezer/python": "https://cdn.jsdelivr.net/npm/@lezer/python@1.1.19/dist/index.js",
      "@lezer/rust": "https://cdn.jsdelivr.net/npm/@lezer/rust@1.0.2/dist/index.js",
      "@lezer/xml": "https://cdn.jsdelivr.net/npm/@lezer/xml@1.0.6/dist/index.js",
      "@lezer/yaml": "https://cdn.jsdelivr.net/npm/@lezer/yaml@1.0.4/dist/index.js",
      "codemirror": "https://cdn.jsdelivr.net/npm/codemirror@6.0.1/dist/index.js",
      "crelt": "https://cdn.jsdelivr.net/npm/crelt@1.0.6/index.js",
      "style-mod": "https://cdn.jsdelivr.net/npm/style-mod@4.1.3/src/style-mod.js",
      "w3c-keyname": "https://cdn.jsdelivr.net/npm/w3c-keyname@2.2.8/index.js"
      {{- range pluginElements}},
      "{{.Name}}": "{{.URL}}"{{end}}
    }
  }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js"></script>
  <script type="module" src="{{asset "/js/pe.js"}}"></script>
  <script type="module" src="{{asset "/js/components/app.js"}}"></script>
</head>
{{end}}

{{/* One alert for a flash that belongs to no project row. The pages put it at
     the top of their work body through work_body.gohtml, so it sits inside the
     column that scrolls and never widens the shell. */}}
{{define "flash.gohtml"}}
{{if and .Flash.Message (eq .FlashProject "")}}
{{template "notice.gohtml" (dict "Level" .Flash.Level "Message" .Flash.Message "Dismiss" true)}}
{{end}}
{{end}}

{{/* One notice, the same everywhere: Tabler's alert with the icon in front,
     names in monospace (see the notice function), the close cross when the
     notice is a flash. Level is success, error, warning or info. */}}
{{define "notice.gohtml"}}
{{$level := .Level}}{{if eq $level "error"}}{{$level = "danger"}}{{end}}
<div class="alert alert-{{$level}}{{if .Dismiss}} alert-dismissible{{end}} dc-notice {{if .Class}}{{.Class}}{{else}}mb-3{{end}}" role="alert">
  <div class="d-flex gap-2">
    <i class="ti {{if eq $level "success"}}ti-circle-check{{else if eq $level "danger"}}ti-alert-circle{{else if eq $level "warning"}}ti-alert-triangle{{else}}ti-info-circle{{end}} icon alert-icon" aria-hidden="true"></i>
    <div class="text-break min-w-0">{{notice .Message}}</div>
  </div>
  {{if .Dismiss}}<a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>{{end}}
</div>
{{end}}

{{define "login_start.gohtml"}}{{template "html_head.gohtml" .}}{{$appName := "Dev Cockpit"}}
<body class="dc-body">
  <div data-page-content>
  <main class="dc-login">
    <div class="dc-login-box">
      <a href="/login" class="dc-login-brand text-reset text-decoration-none" aria-label="{{$appName}}">
        <span class="dc-rail-mark m-0"><i class="ti ti-dashboard icon" aria-hidden="true"></i></span>
        <span>{{$appName}}</span>
      </a>
      {{if .Flash.Message}}
      {{template "notice.gohtml" (dict "Level" .Flash.Level "Message" .Flash.Message "Dismiss" true)}}
      {{end}}
{{end}}

{{define "login_end.gohtml"}}
      <div class="d-flex justify-content-center align-items-center gap-3 mt-3 text-secondary small">
        <span>Version {{appVersion}}</span>
        <span aria-hidden="true">·</span>
        {{template "theme_cycle.gohtml" (dict "Class" "btn btn-sm btn-icon btn-ghost-secondary")}}
      </div>
    </div>
  </main>
  </div>
</body>
</html>{{end}}

{{/* The shell: a rail of areas on the left, an optional list column, the work
     surface, one status line, and on phones a tab bar instead of the rail.
     app_start opens the shell and paints the rail, the page then renders its
     own list column (ctx_*.gohtml) and its work surface (work_*.gohtml), and
     app_end closes with the status line, the tab bar and the overlays that
     live next to the swapped region. The list column is optional, the grid
     reads its presence from the DOM. */}}
{{define "app_start.gohtml"}}{{template "html_head.gohtml" .}}
<body class="dc-body">
  <div data-page-content>
  <div class="dc-app" data-area="{{.ActiveTab}}">
  {{if .User}}{{template "shell_rail.gohtml" .}}{{end}}
{{end}}

{{define "app_end.gohtml"}}
    </div>
  </main>
{{template "app_close.gohtml" .}}
{{end}}

{{/* Everything after the work surface: the status line, the tab bar, the
     overlays next to the swapped region. A page whose work surface is a custom
     element closes that element itself and calls this directly. */}}
{{define "app_close.gohtml"}}
  {{if .User}}
  {{template "shell_status.gohtml" .}}
  {{template "shell_tabbar.gohtml" .}}
  {{end}}
  </div>
  {{if .User}}{{template "ctx_sheet.gohtml" .}}{{template "assistant_memory_sheet.gohtml" .}}{{end}}
  {{if and .User (not .HasTabStrip)}}{{template "terminal_tabs_switcher.gohtml" .}}{{end}}
  </div>
  <div class="toast-container position-fixed top-0 end-0 p-3" data-dc-toasts></div>
  {{if .User}}
  <!-- The create dialog, next to the swapped page region so it outlives a
       boosted navigation and no fixed page context can put it under its own backdrop. The form inside comes from
       the server, from the very page the link points at; the dialog holds the
       head and the close. -->
  <dc-form-modal>
    <div class="modal modal-blur fade" data-form-modal tabindex="-1" aria-labelledby="dc-form-modal-title" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" data-form-modal-content>
          <div class="modal-header">
            <h3 class="modal-title" id="dc-form-modal-title" data-form-modal-title></h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
        </div>
      </div>
    </div>
  </dc-form-modal>
  {{template "host_status_float.gohtml" .}}
  {{end}}
</body>
</html>{{end}}

{{/* The rail: one entry per area, the assistant's light among them, and at the
     foot the settings, the docs and the small controls that used to sit in the
     header (theme, update, bell, logout). */}}
{{define "shell_rail.gohtml"}}
<nav class="dc-rail d-print-none" aria-label="Areas">
  <a class="dc-rail-mark" href="/projects" title="Dev Cockpit" aria-label="Dev Cockpit"><i class="ti ti-dashboard icon" aria-hidden="true"></i></a>
  <a class="dc-rail-btn{{if eq .ActiveTab "projects"}} active{{end}}" href="/projects"><i class="ti ti-folders icon" aria-hidden="true"></i><span>Projects</span></a>
  {{with .QuickNav.TerminalsURL}}
  <a class="dc-rail-btn{{if eq $.ActiveTab "terminals"}} active{{end}}" href="{{.}}"><span class="dc-news-anchor"><i class="ti ti-terminal-2 icon" aria-hidden="true"></i>{{template "news_dot.gohtml" (dict "Any" true "Hidden" (not $.QuickNav.TerminalNews) "Label" "Something new in a terminal")}}</span><span>Terminals</span></a>
  {{else}}
  <span class="dc-rail-btn" aria-disabled="true" title="Nothing is running. Start a coder or a shell in a project."><i class="ti ti-terminal-2 icon" aria-hidden="true"></i><span>Terminals</span></span>
  {{end}}
  <a class="dc-rail-btn{{if eq .ActiveTab "editor"}} active{{end}}" href="/editor"><i class="ti ti-code icon" aria-hidden="true"></i><span>Editor</span></a>
  <a class="dc-rail-btn{{if eq .ActiveTab "assistant"}} active{{end}}" href="/assistant" data-assistant-link title="Assistant"><span class="dc-term-icon assistant{{if .AssistantNews}} news{{end}}"{{if .AssistantID}} data-notify-target="{{.AssistantID}}"{{end}}><i class="ti ti-sparkles icon" aria-hidden="true"></i>{{template "news_dot.gohtml"}}</span><span>Assistant</span></a>
  <span class="dc-rail-gap"></span>
  <div class="dc-rail-foot">
    <a class="dc-rail-btn{{if eq .ActiveTab "settings"}} active{{end}}" href="/settings/general"><i class="ti ti-settings icon" aria-hidden="true"></i><span>Settings</span>{{if .BackupReviewCount}}<span class="dc-rail-count" title="Backup files to resolve" aria-label="Backup files to resolve">{{.BackupReviewCount}}</span>{{end}}</a>
    <a class="dc-rail-btn{{if eq .ActiveTab "docs"}} active{{end}}" href="/docs"><i class="ti ti-book icon" aria-hidden="true"></i><span>Docs</span></a>
    <span class="dc-rail-sep"></span>
    {{template "theme_cycle.gohtml" (dict "Class" "dc-rail-mini")}}
    {{/* Hidden until an update exists. It is a button, not a row: an update is
         the one thing here that asks to be done, not navigated to. */}}
    <button type="button" class="dc-rail-mini dc-rail-update js-update-flag d-none" data-update-open title="Update available" aria-label="Update available">
      <i class="ti ti-arrow-up-circle" aria-hidden="true"></i><span class="js-update-version visually-hidden"></span>
    </button>
    <dc-notifications class="dc-rail-notify">{{template "notify_bell.gohtml" "dropend"}}</dc-notifications>
    <form method="post" action="/logout" data-no-pe>
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <button type="submit" class="dc-rail-mini" aria-label="Logout" title="Logout"><i class="ti ti-logout icon" aria-hidden="true"></i></button>
    </form>
  </div>
</nav>
{{end}}

{{/* The phone has no rail, so the controls from its foot stand at the end of
     every work head instead: the server status, the bell, and one menu with
     the theme, the update and the logout. work_body.gohtml places it. */}}
{{define "shell_head_tools.gohtml"}}
{{if .User}}
<div class="dc-head-tools d-lg-none">
  {{template "host_status.gohtml" .}}
  <dc-notifications>{{template "notify_bell.gohtml" ""}}</dc-notifications>
  <div class="dropdown">
    <button type="button" class="btn btn-icon btn-ghost-secondary" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="More" title="More">
      <i class="ti ti-dots-vertical" aria-hidden="true"></i>
    </button>
    <div class="dropdown-menu dropdown-menu-end">
      {{template "theme_cycle.gohtml" (dict "Class" "dropdown-item" "Label" true)}}
      <div class="js-update-flag d-none">
        <div class="dropdown-divider"></div>
        <button type="button" class="dropdown-item" data-update-open>
          <i class="ti ti-arrow-up-circle me-2" aria-hidden="true"></i>Update to <span class="js-update-version ms-1"></span>
        </button>
      </div>
      <div class="dropdown-divider"></div>
      <form method="post" action="/logout" data-no-pe>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <button type="submit" class="dropdown-item">
          <i class="ti ti-logout me-2" aria-hidden="true"></i>Logout
        </button>
      </form>
    </div>
  </div>
</div>
{{end}}
{{end}}

{{/* The status line under the shell: the server, the version. */}}
{{define "shell_status.gohtml"}}
<footer class="dc-status d-print-none">
  {{template "host_status_bar.gohtml" .}}
  <span class="dc-status-gap"></span>
  <span class="dc-status-item" title="Version">Version {{appVersion}} <dc-update-check id="dc-update" data-version="{{appVersion}}"></dc-update-check></span>
</footer>
{{end}}

{{/* The phone's areas, one tab each, the same five as the rail. */}}
{{define "shell_tabbar.gohtml"}}
<nav class="dc-tabbar d-print-none" aria-label="Areas">
  <button type="button" class="dc-tabbar-btn{{if eq .ActiveTab "projects"}} active{{end}}" data-ctx-area="projects"><i class="ti ti-folders icon" aria-hidden="true"></i><span>Projects</span></button>
  <button type="button" class="dc-tabbar-btn{{if eq $.ActiveTab "terminals"}} active{{end}}" data-ctx-area="terminals"><span class="dc-news-anchor"><i class="ti ti-terminal-2 icon" aria-hidden="true"></i>{{template "news_dot.gohtml" (dict "Any" true "Hidden" (not $.QuickNav.TerminalNews) "Label" "Something new in a terminal")}}</span><span>Terminals</span></button>
  <a class="dc-tabbar-btn{{if eq .ActiveTab "editor"}} active{{end}}" href="/editor"><i class="ti ti-code icon" aria-hidden="true"></i><span>Editor</span></a>
  <button type="button" class="dc-tabbar-btn{{if eq .ActiveTab "assistant"}} active{{end}}" data-ctx-area="assistant" data-assistant-link><span class="dc-term-icon assistant{{if .AssistantNews}} news{{end}}"{{if .AssistantID}} data-notify-target="{{.AssistantID}}"{{end}}><i class="ti ti-sparkles icon" aria-hidden="true"></i>{{template "news_dot.gohtml"}}</span><span>Assistant</span></button>
  <button type="button" class="dc-tabbar-btn{{if eq .ActiveTab "settings"}} active{{end}}" data-ctx-area="settings"><i class="ti ti-settings icon" aria-hidden="true"></i><span>Settings</span>{{if .BackupReviewCount}}<span class="dc-tabbar-count" title="Backup files to resolve" aria-label="Backup files to resolve">{{.BackupReviewCount}}</span>{{end}}</button>
</nav>
{{end}}

{{/* The list column. ctx_start takes a dict with Title and an optional Count,
     leaves the head open for the page's tools, ctx_body closes the head and
     opens the scrolling list, ctx_end closes the column. */}}
{{define "ctx_start.gohtml"}}
<aside class="dc-ctx d-print-none">
  <div class="dc-ctx-head">
    <button type="button" class="btn btn-icon btn-ghost-secondary dc-work-toggle" data-dc-focus="work" aria-label="Back"><i class="ti ti-arrow-left" aria-hidden="true"></i></button>
    <h1 class="dc-ctx-title">{{.Title}}</h1>
{{end}}

{{/* The phone's filter over a list column, a row under the head that hides
     rows as one types; the desktop column shows the whole list. The argument
     is the placeholder. */}}
{{define "ctx_filter.gohtml"}}
  <div class="dc-ctx-filter d-lg-none">
    <div class="dc-filter">
      <i class="ti ti-search" aria-hidden="true"></i>
      <input type="text" class="dc-filter-input" data-ctx-filter placeholder="{{.}}" aria-label="{{.}}" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false">
      <span class="dc-filter-side">
        <button type="button" class="dc-filter-clear d-none" data-ctx-filter-clear aria-label="Clear the filter" title="Clear the filter"><i class="ti ti-x" aria-hidden="true"></i></button>
      </span>
    </div>
  </div>
{{end}}

{{define "ctx_body.gohtml"}}
  </div>
  <div class="dc-ctx-body">
{{end}}

{{define "ctx_end.gohtml"}}
  </div>
  <div class="dc-ctx-resize" data-ctx-resize aria-hidden="true"></div>
</aside>
{{end}}

{{/* The work surface. work_start opens it with the head and the button that
     brings the list column up on a phone, the page fills the head, and one of
     the work_body templates closes the head and opens the body: padded for
     forms and boards, filling for the surfaces that size themselves (the
     terminal, the editor). */}}
{{define "work_start.gohtml"}}
<main class="dc-work">
  <div class="dc-work-head">
{{end}}

{{define "work_body.gohtml"}}
    {{template "shell_head_tools.gohtml" .}}
  </div>
  <div class="dc-work-body dc-work-pad">
    {{template "flash.gohtml" .}}
{{end}}

{{define "work_body_fill.gohtml"}}
    {{template "shell_head_tools.gohtml" .}}
  </div>
  <div class="dc-work-body dc-work-fill">
    {{template "flash.gohtml" .}}
{{end}}
