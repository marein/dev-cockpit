{{define "quicknav.gohtml"}}
<dc-quicknav class="quicknav dropup d-print-none">
  <button type="button" class="btn btn-icon quicknav-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Coders and projects" title="Coders and projects">
    <i class="ti ti-layout-grid quicknav-ico-open"></i>
    <i class="ti ti-x quicknav-ico-close"></i>
    <span class="dc-notify-badge{{if eq .QuickNav.UnreadCount 0}} d-none{{end}}" data-notify-count aria-hidden="true">{{if gt .QuickNav.UnreadCount 99}}99+{{else}}{{.QuickNav.UnreadCount}}{{end}}</span>
  </button>
  <div class="dropdown-menu dropdown-menu-end quicknav-menu" data-quicknav-url="/quicknav">
    <div class="quicknav-list">{{template "quicknav_items.gohtml" .}}</div>
  </div>
</dc-quicknav>
{{end}}

{{define "quicknav_items.gohtml"}}
<div data-quicknav-tabs data-quicknav-current-project="{{.QuickNav.CurrentProject}}">
  <div class="quicknav-top">
    <div class="d-flex align-items-stretch">
      <div class="quicknav-seg flex-fill" role="tablist">
        <button type="button" class="quicknav-seg-btn active" data-quicknav-tab="active"><i class="ti ti-activity me-1"></i>Active</button>
        <button type="button" class="quicknav-seg-btn" data-quicknav-tab="projects"><i class="ti ti-folders me-1"></i>Projects</button>
      </div>
      <a href="/assistant" class="link-secondary text-decoration-none flex-shrink-0 quicknav-assistant" title="Assistant" aria-label="Assistant" data-quicknav-assistant>
        <span class="dc-term-icon assistant{{if .AssistantNews}} news{{end}}"{{if .AssistantID}} data-notify-target="{{.AssistantID}}"{{end}}><i class="ti ti-sparkles"></i></span>
      </a>
    </div>
    {{if .QuickNav.CurrentProject}}
    <div class="quicknav-context d-flex align-items-center gap-2 px-3 pb-2">
      <span class="text-truncate small fw-medium flex-fill">{{.QuickNav.CurrentProject}}</span>
      <a href="/projects/{{.QuickNav.CurrentProject}}/editor?return={{urlquery .QuickNav.CurrentPath}}" class="btn btn-sm btn-ghost-secondary px-2 py-1" title="Editor for {{.QuickNav.CurrentProject}}" aria-label="Open editor for current project">
        <i class="ti ti-code"></i>
      </a>
      <a href="/coders/new?project={{urlquery .QuickNav.CurrentProject}}&amp;return={{urlquery .QuickNav.CurrentPath}}" class="btn btn-sm btn-ghost-secondary px-2 py-1" title="New coder in {{.QuickNav.CurrentProject}}" aria-label="New coder in current project">
        <i class="ti ti-robot"></i><i class="ti ti-plus ms-1"></i>
      </a>
      {{if .QuickNav.CurrentProjectPath}}
      <form method="post" action="/shells/new" class="d-flex">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="project" value="{{.QuickNav.CurrentProjectPath}}">
        <button type="submit" class="btn btn-sm btn-ghost-secondary px-2 py-1" title="New shell in {{.QuickNav.CurrentProject}}" aria-label="New shell in current project">
          <i class="ti ti-terminal-2"></i><i class="ti ti-plus ms-1"></i>
        </button>
      </form>
      {{end}}
    </div>
    {{end}}
    <div class="quicknav-search" data-pb-head hidden>
      <div class="input-icon">
        <span class="input-icon-addon"><i class="ti ti-search" aria-hidden="true"></i></span>
        <input type="text" class="form-control form-control-sm" data-pb-filter placeholder="Search projects…" aria-label="Search projects" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" enterkeyhint="go" data-1p-ignore data-lpignore="true">
      </div>
    </div>
  </div>

  <div data-quicknav-pane="active">
    <div class="quicknav-active-list" data-quicknav-active-list>
      {{range .QuickNav.Strip}}
      {{if .Members}}
      {{$g := .}}
      <div class="quicknav-group" data-qn-block="{{.ID}}">
        <div class="quicknav-swipe-row" data-qn-group="{{.ID}}">
          <a class="dropdown-item quicknav-active-item d-flex align-items-center gap-2 {{if .IsActive $.QuickNav.CurrentID}}active{{end}}" href="{{.URL}}" draggable="false"
             data-tab-id="{{.ID}}" data-tab-kind="split" data-tab-name="{{.Name}}" data-tab-project="{{.Project}}" data-tab-members="{{.MemberIDs}}" data-tab-member-kinds="{{.MemberKinds}}"{{if .IsActive $.QuickNav.CurrentID}} aria-current="true"{{end}}>
            <span class="dc-term-icon running{{if .Working}} working{{end}}{{if .HasNews}} news{{end}} flex-shrink-0" data-notify-targets="{{.MemberIDs}}" aria-hidden="true"><i class="ti ti-layout"></i></span>
            <span class="d-flex flex-column min-w-0">
              <span class="text-truncate">{{.Name}}</span>
              <span class="text-secondary small text-truncate">{{if .Project}}{{.Project}} · {{end}}{{len .Members}} terminals</span>
            </span>
            <span class="quicknav-drag-handle flex-shrink-0 ms-auto" data-qn-drag-handle aria-hidden="true"><i class="ti ti-grip-vertical"></i></span>
          </a>
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-rename quicknav-swipe-slot3" data-qn-rename aria-label="Rename split view {{.Name}}" title="Rename split view">
            <i class="ti ti-pencil" aria-hidden="true"></i>
          </button>
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-ungroup" data-qn-ungroup aria-label="Ungroup split view {{.Name}}" title="Ungroup split view">
            <i class="ti ti-layout-off" aria-hidden="true"></i>
          </button>
          <button type="button" class="quicknav-swipe-delete" data-qn-delete aria-label="Close all terminals in {{.Name}}" title="Close all terminals">
            <i class="ti ti-trash" aria-hidden="true"></i>
          </button>
        </div>
        {{range $g.Members}}
        <div class="quicknav-swipe-row quicknav-group-row" data-qn-group-member="{{$g.ID}}">
          <a class="dropdown-item quicknav-active-item d-flex align-items-center gap-2 {{if and (eq .ID $.QuickNav.Focus) (eq $g.ID $.QuickNav.CurrentID)}}active{{end}}" href="{{.URL}}" draggable="false"
             data-tab-id="{{.ID}}" data-tab-kind="{{.Kind}}" data-tab-name="{{.Name}}" data-tab-project="{{.Project}}"{{if and (eq .ID $.QuickNav.Focus) (eq $g.ID $.QuickNav.CurrentID)}} aria-current="true"{{end}}>
            <span class="dc-term-icon running{{if .Working}} working{{end}}{{if .HasNews}} news{{end}}{{if and .Coder (index $.Steered .ID)}} steered{{end}} flex-shrink-0" data-notify-target="{{.ID}}"{{if .Coder}} title="{{coderLabel .Coder}}" aria-label="{{coderLabel .Coder}}"{{else}} aria-hidden="true"{{end}}>{{if .Coder}}{{template "coder_icon.gohtml" .Coder}}{{else}}<i class="ti ti-terminal-2"></i>{{end}}</span>
            <span class="d-flex flex-column min-w-0">
              <span class="text-truncate">{{.Name}}</span>
              {{if .Project}}<span class="text-secondary small text-truncate">{{.Project}}</span>{{end}}
            </span>            <span class="quicknav-drag-handle flex-shrink-0 ms-auto" data-qn-drag-handle aria-hidden="true"><i class="ti ti-grip-vertical"></i></span>
          </a>
          {{if eq .Kind "shell"}}
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-rename quicknav-swipe-slot3" data-qn-rename aria-label="Rename shell {{.Name}}" title="Rename shell">
            <i class="ti ti-pencil" aria-hidden="true"></i>
          </button>
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-ungroup" data-qn-remove aria-label="Remove {{.Name}} from split view" title="Remove from split view">
            <i class="ti ti-layout-off" aria-hidden="true"></i>
          </button>
          <button type="button" class="quicknav-swipe-delete" data-qn-delete aria-label="Delete shell {{.Name}}" title="Delete shell">
            <i class="ti ti-trash" aria-hidden="true"></i>
          </button>
          {{else}}
          {{if index $.Steered .ID}}
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-steer quicknav-swipe-slot4" data-qn-release aria-label="Release coder {{.Name}}" title="Release coder">
            <i class="ti ti-steering-wheel-off" aria-hidden="true"></i>
          </button>
          {{else}}
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-steer quicknav-swipe-slot4" data-qn-steer data-steer-prefill="{{index $.SteerPrefill .ID}}" aria-label="Steer coder {{.Name}}" title="Steer coder">
            <i class="ti ti-steering-wheel" aria-hidden="true"></i>
          </button>
          {{end}}
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-ungroup quicknav-swipe-slot3" data-qn-remove aria-label="Remove {{.Name}} from split view" title="Remove from split view">
            <i class="ti ti-layout-off" aria-hidden="true"></i>
          </button>
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-stop" data-qn-delete aria-label="Stop coder {{.Name}}" title="Stop coder">
            <i class="ti ti-player-stop" aria-hidden="true"></i>
          </button>
          <button type="button" class="quicknav-swipe-delete" data-qn-purge aria-label="Delete coder {{.Name}}" title="Delete coder">
            <i class="ti ti-trash" aria-hidden="true"></i>
          </button>
          {{end}}
        </div>
        {{end}}
      </div>
      {{else}}
      <div class="quicknav-swipe-row">
        <a class="dropdown-item quicknav-active-item d-flex align-items-center gap-2 {{if eq .ID $.QuickNav.CurrentID}}active{{end}}" href="{{.URL}}" draggable="false"
           data-tab-id="{{.ID}}" data-tab-kind="{{.Kind}}" data-tab-name="{{.Name}}" data-tab-project="{{.Project}}"{{if eq .ID $.QuickNav.CurrentID}} aria-current="true"{{end}}>
          <span class="dc-term-icon running{{if .Working}} working{{end}}{{if .HasNews}} news{{end}}{{if and .Coder (index $.Steered .ID)}} steered{{end}} flex-shrink-0" data-notify-target="{{.ID}}"{{if .Coder}} title="{{coderLabel .Coder}}" aria-label="{{coderLabel .Coder}}"{{else}} aria-hidden="true"{{end}}>{{if .Coder}}{{template "coder_icon.gohtml" .Coder}}{{else}}<i class="ti ti-terminal-2"></i>{{end}}</span>
          <span class="d-flex flex-column min-w-0">
            <span class="text-truncate">{{.Name}}</span>
            {{if .Project}}<span class="text-secondary small text-truncate">{{.Project}}</span>{{end}}
          </span>          <span class="quicknav-drag-handle flex-shrink-0 ms-auto" data-qn-drag-handle aria-hidden="true"><i class="ti ti-grip-vertical"></i></span>
        </a>
        {{if eq .Kind "shell"}}
        <button type="button" class="quicknav-swipe-delete quicknav-swipe-rename" data-qn-rename aria-label="Rename shell {{.Name}}" title="Rename shell">
          <i class="ti ti-pencil" aria-hidden="true"></i>
        </button>
        <button type="button" class="quicknav-swipe-delete" data-qn-delete aria-label="Delete shell {{.Name}}" title="Delete shell">
          <i class="ti ti-trash" aria-hidden="true"></i>
        </button>
        {{else}}
        {{if index $.Steered .ID}}
        <button type="button" class="quicknav-swipe-delete quicknav-swipe-steer quicknav-swipe-slot3" data-qn-release aria-label="Release coder {{.Name}}" title="Release coder">
          <i class="ti ti-steering-wheel-off" aria-hidden="true"></i>
        </button>
        {{else}}
        <button type="button" class="quicknav-swipe-delete quicknav-swipe-steer quicknav-swipe-slot3" data-qn-steer data-steer-prefill="{{index $.SteerPrefill .ID}}" aria-label="Steer coder {{.Name}}" title="Steer coder">
          <i class="ti ti-steering-wheel" aria-hidden="true"></i>
        </button>
        {{end}}
        <button type="button" class="quicknav-swipe-delete quicknav-swipe-stop" data-qn-delete aria-label="Stop coder {{.Name}}" title="Stop coder">
          <i class="ti ti-player-stop" aria-hidden="true"></i>
        </button>
        <button type="button" class="quicknav-swipe-delete" data-qn-purge aria-label="Delete coder {{.Name}}" title="Delete coder">
          <i class="ti ti-trash" aria-hidden="true"></i>
        </button>
        {{end}}
      </div>
      {{end}}
      {{end}}
      {{if not .QuickNav.Active}}<span class="dropdown-item-text text-secondary small">No active coders or shells</span>{{end}}
    </div>
    <div class="dropdown-divider"></div>
    <a class="dropdown-item d-flex align-items-center gap-2" href="/coders/new?{{if .QuickNav.CurrentProject}}project={{urlquery .QuickNav.CurrentProject}}&amp;{{end}}return={{urlquery .QuickNav.CurrentPath}}">
      <i class="ti ti-robot flex-shrink-0"></i><span>New coder</span>
    </a>
    <a class="dropdown-item d-flex align-items-center gap-2" href="/shells/new?{{if .QuickNav.CurrentProject}}project={{urlquery .QuickNav.CurrentProject}}&amp;{{end}}return={{urlquery .QuickNav.CurrentPath}}">
      <i class="ti ti-terminal-2 flex-shrink-0"></i><span>New shell</span>
    </a>
  </div>

  <div data-quicknav-pane="projects" hidden>
    <div data-project-browser>
      <div data-pb-list>
        <div class="quicknav-pb-list" data-pb-rows role="listbox" aria-label="Projects"></div>
        <div class="quicknav-pb-empty text-secondary small" data-pb-empty hidden>No matches.</div>
        <div data-pb-source hidden>
          {{range .QuickNav.AllProjects}}
          <button type="button" class="quicknav-pb-row{{if eq .Name $.QuickNav.CurrentProject}} quicknav-pb-current{{end}}" data-pb-drill="{{.Name}}" data-project-name="{{.Name}}" data-project-active="{{if .Active}}true{{else}}false{{end}}" data-project-used="{{.LastUsedUnix}}"{{if .WorktreeOf}} data-project-worktree-of="{{.WorktreeOf}}"{{end}}{{if .Worktree}} data-project-worktree{{end}} data-project-search="{{.Search}}"{{if eq .Name $.QuickNav.CurrentProject}} aria-current="true"{{end}} title="{{.Name}}{{if .Worktree}}, worktree of {{if .WorktreeOf}}{{.WorktreeOf}}{{else}}{{.WorktreeMain}}{{end}}{{end}}{{if .Branch}} on {{.Branch}}{{end}}">
            <span class="quicknav-pb-line">
              <i class="ti {{if .Worktree}}ti-git-fork{{else if .Repo}}ti-folder-code{{else}}ti-folder{{end}}" aria-hidden="true"></i>
              <span class="quicknav-pb-repo">{{if .Repo}}{{.Repo}}{{else}}{{.Name}}{{end}}</span>
              {{if .Branch}}<span class="quicknav-pb-branch"><i class="ti ti-git-branch" aria-hidden="true"></i> {{.Branch}}</span>{{end}}
              <span class="quicknav-pb-fill" aria-hidden="true"></span>
              {{if eq .Name $.QuickNav.CurrentProject}}<i class="ti ti-check quicknav-pb-check" aria-hidden="true"></i>{{end}}
              <span class="status-dot status-dot-animated status-blue quicknav-pb-dot{{if not .HasNews}} d-none{{end}}" data-notify-project-dot data-notify-projects="qn-project-{{.Name}}" aria-label="Something new in this project"></span>
              <i class="ti ti-chevron-right quicknav-pb-go" aria-hidden="true"></i>
            </span>
            {{if .Worktree}}<span class="quicknav-pb-sub">{{.Name}}{{if not .WorktreeOf}}<span class="quicknav-pb-outside"><i class="ti ti-external-link" aria-hidden="true"></i>{{.WorktreeMain}}</span>{{end}}</span>{{end}}
          </button>
          {{end}}
        </div>
        {{if not .QuickNav.AllProjects}}<span class="dropdown-item-text text-secondary small">No projects</span>{{end}}
      </div>

      {{range .QuickNav.AllProjects}}
      <div id="qn-project-{{.Name}}" data-pb-detail="{{.Name}}" hidden>
        <button type="button" class="quicknav-detail-title dropdown-item d-flex align-items-center gap-2" data-pb-back>
          <i class="ti ti-chevron-left flex-shrink-0"></i><span class="text-truncate">{{.Name}}</span>
        </button>
        <div class="d-flex align-items-center justify-content-end gap-1 px-3 pb-2" data-pb-actions>
          {{if .Docker.Stacks}}
          <button type="button" class="btn btn-sm btn-ghost-secondary px-2 py-2" data-docker-project-menu data-docker-project="{{.Name}}" title="Compose in {{.Name}}" aria-label="Compose actions for {{.Name}}">
            <span class="dc-term-icon{{if .Docker.AnyRunning}} running{{end}}{{if .Docker.Working}} dc-docker-working{{end}}" aria-hidden="true"><i class="ti ti-brand-docker"></i></span>
            {{range .Docker.Stacks}}<span hidden data-docker-stack data-stack-label="{{.Label}}" data-stack-running="{{.Running}}" data-stack-total="{{.Total}}"{{if .Busy}} data-stack-busy="1"{{end}}{{if .RunID}} data-stack-run="{{.RunID}}" data-stack-run-action="{{.RunAction}}"{{if .RunGoing}} data-stack-run-going="1"{{end}}{{end}}></span>{{end}}
            {{range $.QuickNav.DockerActions}}<span hidden data-docker-action data-action-id="{{.ID}}" data-action-icon="{{.Icon}}" data-action-label="{{.Label}}" data-action-command="{{.Command}}"{{if .Confirm}} data-action-confirm="1"{{end}}></span>{{end}}
          </button>
          {{end}}
          {{if .GitRepo}}
          <button type="button" class="btn btn-sm btn-ghost-secondary px-2 py-2" data-git-project-menu data-git-project="{{.Name}}"{{if not .Worktree}} data-git-worktree="/projects/new?create={{urlquery (worktreeChoice .Name)}}"{{end}} data-git-fetch="/projects/{{.Name}}/fetch" data-git-commit="{{.EditorURL}}&amp;view=commit" data-git-compare="{{.EditorURL}}&amp;view=compare" title="Git in {{.Name}}" aria-label="Git actions for {{.Name}}">
            <i class="ti ti-brand-git"></i>
          </button>
          {{end}}
          <a href="{{.EditorURL}}" class="btn btn-sm btn-ghost-secondary px-2 py-2" title="Editor for {{.Name}}" aria-label="Open editor for {{.Name}}">
            <i class="ti ti-code"></i>
          </a>
          <a href="{{.NewCoderURL}}" class="btn btn-sm btn-ghost-secondary px-2 py-2" title="New coder in {{.Name}}" aria-label="New coder in {{.Name}}">
            <i class="ti ti-robot"></i><i class="ti ti-plus ms-1"></i>
          </a>
          <form method="post" action="/shells/new" class="d-flex">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <input type="hidden" name="project" value="{{.Path}}">
            <button type="submit" class="btn btn-sm btn-ghost-secondary px-2 py-2" title="New shell in {{.Name}}" aria-label="New shell in {{.Name}}">
              <i class="ti ti-terminal-2"></i><i class="ti ti-plus ms-1"></i>
            </button>
          </form>
        </div>
        <div class="dropdown-divider"></div>
        <div data-qn-fold="{{.Name}}-terminals">
        {{range .Terminals}}
        <div class="quicknav-swipe-row">
          <a class="dropdown-item quicknav-active-item d-flex align-items-center gap-2 {{if eq .ID $.QuickNav.CurrentID}}active{{end}}" href="{{.URL}}" draggable="false"
             data-tab-id="{{.ID}}" data-tab-kind="{{.Kind}}" data-tab-name="{{.Name}}"{{if eq .ID $.QuickNav.CurrentID}} aria-current="true"{{end}}>
            <span class="dc-term-icon running{{if index $.Working .ID}} working{{end}}{{if .HasNews}} news{{end}}{{if and .Coder (index $.Steered .ID)}} steered{{end}} flex-shrink-0" data-notify-target="{{.ID}}"{{if .Coder}} title="{{coderLabel .Coder}}" aria-label="{{coderLabel .Coder}}"{{else}} aria-hidden="true"{{end}}>{{if .Coder}}{{template "coder_icon.gohtml" .Coder}}{{else}}<i class="ti ti-terminal-2"></i>{{end}}</span><span class="text-truncate">{{.Name}}</span>          </a>
          {{if eq .Kind "shell"}}
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-rename" data-qn-rename aria-label="Rename shell {{.Name}}" title="Rename shell">
            <i class="ti ti-pencil" aria-hidden="true"></i>
          </button>
          <button type="button" class="quicknav-swipe-delete" data-qn-delete aria-label="Delete shell {{.Name}}" title="Delete shell">
            <i class="ti ti-trash" aria-hidden="true"></i>
          </button>
          {{else}}
          {{if index $.Steered .ID}}
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-steer quicknav-swipe-slot3" data-qn-release aria-label="Release coder {{.Name}}" title="Release coder">
            <i class="ti ti-steering-wheel-off" aria-hidden="true"></i>
          </button>
          {{else}}
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-steer quicknav-swipe-slot3" data-qn-steer data-steer-prefill="{{index $.SteerPrefill .ID}}" aria-label="Steer coder {{.Name}}" title="Steer coder">
            <i class="ti ti-steering-wheel" aria-hidden="true"></i>
          </button>
          {{end}}
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-stop" data-qn-delete aria-label="Stop coder {{.Name}}" title="Stop coder">
            <i class="ti ti-player-stop" aria-hidden="true"></i>
          </button>
          <button type="button" class="quicknav-swipe-delete" data-qn-purge aria-label="Delete coder {{.Name}}" title="Delete coder">
            <i class="ti ti-trash" aria-hidden="true"></i>
          </button>
          {{end}}
        </div>
        {{end}}
        {{range .InactiveCoders}}
        <div class="quicknav-swipe-row">
          <form method="post" action="{{.URL}}">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <button type="submit" class="dropdown-item quicknav-active-item d-flex align-items-center gap-2"
               data-tab-id="{{.ID}}" data-tab-kind="inactive" data-tab-name="{{.Name}}">
              <span class="dc-term-icon{{if .HasNews}} news{{end}} flex-shrink-0" data-notify-target="{{.ID}}" title="{{coderLabel .Coder}}" aria-label="{{coderLabel .Coder}}">{{template "coder_icon.gohtml" .Coder}}</span><span class="text-truncate">{{.Name}}</span>
            </button>
          </form>
          <button type="button" class="quicknav-swipe-delete" data-qn-delete aria-label="Delete inactive coder {{.Name}}" title="Delete inactive coder">
            <i class="ti ti-trash" aria-hidden="true"></i>
          </button>
        </div>
        {{end}}
        </div>
        {{if .Docker.Containers}}
        <div class="dropdown-divider"></div>
        {{range .Docker.Containers}}
        <div class="quicknav-swipe-row" data-chip data-chip-kind="docker" data-chip-id="{{.ID}}" data-chip-name="{{.DisplayName}}"
             data-docker-running="{{if .Running}}1{{end}}" data-docker-ports="{{.PortsLabel}}">
          <button type="button" class="dropdown-item quicknav-active-item d-flex align-items-center gap-2" data-chip-main-menu
                  title="{{.Name}}" aria-label="Actions for {{.Name}}">
            <span class="dc-term-icon{{if .Running}} running{{end}}{{if .Unwell}} text-danger{{end}} flex-shrink-0" aria-hidden="true"><i class="ti ti-brand-docker"></i></span>
            <span class="text-truncate">{{.DisplayName}}</span>
          </button>
          <button type="button" class="quicknav-swipe-delete quicknav-swipe-logs" data-docker-logs aria-label="Logs of {{.DisplayName}}" title="Logs">
            <i class="ti ti-file-text" aria-hidden="true"></i>
          </button>
          {{range .Links}}<span hidden data-docker-link data-link-scheme="{{.Scheme}}" data-link-host="{{.Host}}" data-link-port="{{if .Port}}{{.Port}}{{end}}" data-link-path="{{.Path}}"></span>{{end}}
        </div>
        {{end}}
        {{end}}
      </div>
      {{end}}
    </div>
  </div>
</div>
{{end}}
