{{/* The @ of a message box: a popup over the box that offers the projects
     and then the folders and files of the one picked, a folder walked into by
     picking it, filled by dc-file-mention. It stands in the box's form, which
     it is placed against, and names the box it listens to. The project rows
     arrive from file_mention_projects.gohtml into the hidden source, a file or
     folder row is the template below, so none of this markup is built a
     second time in the browser. */}}
{{define "file_mention.gohtml"}}
<dc-file-mention input="[data-assistant-input]" bound=".dc-assistant-main" projects-url="/mention/projects" files-url="/mention/files">
  <div class="card dc-mention" data-mention-panel hidden>
    <div class="d-flex align-items-center gap-1 ps-2 pe-3 py-1 border-bottom position-relative dc-mention-head">
      <button type="button" class="btn btn-icon btn-sm btn-ghost-secondary border-0" data-mention-back aria-label="Back to the projects" title="Back to the projects" hidden><i class="ti ti-chevron-left" aria-hidden="true"></i></button>
      <span class="d-flex align-items-center gap-2 min-w-0 ps-1 small fw-medium" data-mention-crumb>
        <i class="ti ti-at text-primary" aria-hidden="true" data-mention-crumb-icon></i><span class="d-flex min-w-0"><span class="text-truncate text-secondary fw-normal dc-mention-trail" data-mention-trail hidden></span><span class="text-truncate" data-mention-title>Projects</span></span>
      </span>
      <span class="ms-auto ps-2 small text-secondary text-nowrap" data-mention-count aria-live="polite"></span>
      <div class="progress progress-sm rounded-0 position-absolute start-0 bottom-0 w-100 dc-mention-busy" data-mention-busy hidden><div class="progress-bar progress-bar-indeterminate"></div></div>
    </div>
    <div class="dc-mention-list" role="listbox" id="dc-mention-list" aria-label="Projects, folders and files to mention" data-mention-list></div>
    <div class="d-flex flex-wrap gap-3 px-3 py-1 border-top small text-secondary dc-mention-foot" aria-hidden="true">
      <span><kbd>&uarr;</kbd> <kbd>&darr;</kbd> move</span>
      <span><kbd>Enter</kbd> or <kbd>Tab</kbd> pick</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>
  <div hidden data-mention-projects></div>
  <template data-mention-file-template>
    <div class="editor-palette-row" role="option" aria-selected="false">
      <span class="editor-palette-line"><i class="ti ti-file" aria-hidden="true" data-mention-icon></i><span class="text-truncate" data-mention-name></span><i class="ti ti-chevron-right ms-auto" aria-hidden="true" data-mention-walk hidden></i></span>
      <span class="editor-palette-sub" data-mention-dir></span>
    </div>
  </template>
  <template data-mention-note-template>
    <div class="editor-palette-empty small text-secondary" role="status" data-mention-note></div>
  </template>
</dc-file-mention>
{{end}}

{{define "file_mention_projects.gohtml"}}
{{range .Projects}}
<div class="editor-palette-row" role="option" aria-selected="false"{{template "project_palette_attrs.gohtml" .}}>
  {{template "project_palette_body.gohtml" .}}
</div>
{{end}}
{{end}}
