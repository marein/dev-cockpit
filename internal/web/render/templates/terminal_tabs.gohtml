{{/* The strip fragment. */}}
{{define "terminal_tabs.gohtml"}}
<terminal-tabs class="d-print-none" data-tabs-url="{{.Access.Base}}/terminal-tabs"{{if .Access.Guest}} data-tabs-guest{{end}}>
  {{template "terminal_tabs_core.gohtml" .}}
</terminal-tabs>
{{end}}

{{define "terminal_tabs_switcher.gohtml"}}
<terminal-tabs hidden data-tabs-url="/terminal-tabs">
  {{template "terminal_tabs_core.gohtml" .}}
</terminal-tabs>
{{end}}

{{define "terminal_tabs_core.gohtml"}}
  {{template "terminal_tabs_strip.gohtml" .}}
  {{template "terminal_tabs_new.gohtml" .}}
{{end}}

{{/* The list of live terminals, one row each, a split view as one row. It is
     the list column of the terminal pages and the body of the strip fragment
     the component pulls on every terminals event. */}}
{{define "terminal_tabs_strip.gohtml"}}
  <div class="terminal-tabs-strip list-group list-group-flush dc-rows" data-tabs-strip role="tablist" aria-label="Active coders and shells">
    {{/* Data for the switcher's assistant rows: one link per living assistant
         carrying the name the list column shows and what it is doing, or the
         overview while there is none, since the area then opens on the empty
         state that makes the first one. A guest's are the link's assistants
         under the link's address, and none is no row. It stands in the
         strip, so every pull of the strip brings it along, and first, so
         the last row stays the last child and draws no line under it. */}}
    <div class="d-none">
      {{if and (not .QuickNav.Assistants) (not .Access.Guest)}}
      <a data-tabs-assistant href="/assistants" title="Assistants">
        <span class="terminal-tab-icon dc-term-icon assistant" aria-hidden="true"><i class="ti ti-sparkles"></i></span><span>Assistants</span>
      </a>
      {{end}}
      {{range .QuickNav.Assistants}}
      <a data-tabs-assistant-instance="{{.ID}}" data-assistant-name="{{template "assistant_title.gohtml" .Title}}" href="{{.URL}}" tabindex="-1">
        <span class="terminal-tab-icon dc-term-icon assistant{{if .Running}} working{{end}}{{if .News}} news{{end}}"{{with .Running}} data-working-since="{{.}}"{{end}} data-notify-target="{{.ID}}" aria-hidden="true"><i class="ti ti-sparkles"></i>{{template "news_dot.gohtml"}}</span>
      </a>
      {{end}}
    </div>
    {{range .QuickNav.Strip}}
    {{if .Members}}
    <a class="terminal-tab terminal-tab-split list-group-item list-group-item-action{{if .IsActive $.QuickNav.CurrentID}} active{{end}}"
       href="{{.URL}}" role="tab" draggable="false"
       aria-selected="{{if .IsActive $.QuickNav.CurrentID}}true{{else}}false{{end}}"
       data-tab-id="{{.ID}}" data-tab-kind="split" data-tab-name="{{.Name}}" data-tab-project="{{.Project}}" data-tab-members="{{.MemberIDs}}" data-tab-member-kinds="{{.MemberKinds}}" data-tab-member-cols="{{.MemberCols}}"
       title="{{.Name}}{{if .Project}} ({{.Project}}){{end}}">
      <span class="terminal-tab-icon dc-term-icon running{{if .Working}} working{{end}}{{if .HasNews}} news{{end}}"{{with .Working}} data-working-since="{{.}}"{{end}} data-tab-icon data-notify-targets="{{.MemberIDs}}" aria-hidden="true"><i class="ti ti-layout"></i>{{template "news_dot.gohtml"}}</span>
      {{$t := .}}<span class="d-none" aria-hidden="true">{{range $t.Members}}<span class="dc-term-icon running{{if .Working}} working{{end}}{{if .HasNews}} news{{end}}{{if and .Coder (index $.Steered .ID)}} steered{{end}}"{{with .Working}} data-working-since="{{.}}"{{end}} data-notify-target="{{.ID}}"{{if eq .Launcher "ollama"}} data-launcher="ollama"{{end}} data-member-name="{{.Name}}" data-member-url="/splits/{{$t.ID}}?focus={{.ID}}">{{if .Coder}}{{template "coder_icon.gohtml" (dict "ID" .Coder "Launcher" .Launcher)}}{{else}}<i class="ti ti-terminal-2"></i>{{end}}{{template "news_dot.gohtml"}}</span>{{end}}</span>
      <span class="terminal-tab-text">
        <span class="terminal-tab-name">{{.Name}}</span>
        <span class="terminal-tab-project">{{if .Project}}{{.Project}} · {{end}}{{len .Members}} terminals</span>
      </span>
      <span class="terminal-tab-close" data-tab-close role="button" tabindex="-1" aria-label="Close all terminals in {{.Name}}" title="Close all terminals">
        <i class="ti ti-x" aria-hidden="true"></i>
      </span>
      <span class="terminal-tab-menu d-lg-none" data-tab-menu role="button" tabindex="-1" aria-label="Options for {{.Name}}" title="Options"><i class="ti ti-dots" aria-hidden="true"></i></span>
      <span class="terminal-tab-grip d-lg-none" data-tab-grip aria-hidden="true"><i class="ti ti-grip-vertical"></i></span>
    </a>
    {{range $t.Members}}
    <a class="terminal-tab-member list-group-item list-group-item-action is-nested d-lg-none{{if and (eq $t.ID $.QuickNav.CurrentID) (eq .ID $.QuickNav.Focus)}} active{{end}}"
       href="/splits/{{$t.ID}}?focus={{.ID}}" role="tab" draggable="false"
       data-tab-id="{{.ID}}" data-tab-kind="{{.Kind}}" data-tab-name="{{.Name}}" data-tab-project="{{.Project}}" data-tab-group="{{$t.ID}}"
       {{- if .Coder}}{{if index $.Steered .ID}} data-tab-steered="1"{{end}}{{with index $.SteerPrefill .ID}} data-tab-steer-prefill="{{.}}"{{end}}{{with coderRename .Coder}} data-tab-renames="{{.}}"{{end}} data-tab-coder-label="{{coderLabel .Coder}}"{{end}}
       title="{{.Name}}{{if .Project}} ({{.Project}}){{end}}">
      <span class="terminal-tab-icon dc-term-icon running{{if .Working}} working{{end}}{{if .HasNews}} news{{end}}{{if and .Coder (index $.Steered .ID)}} steered{{end}}"{{with .Working}} data-working-since="{{.}}"{{end}} data-tab-icon data-notify-target="{{.ID}}"{{if eq .Launcher "ollama"}} data-launcher="ollama"{{end}} aria-hidden="true">{{if .Coder}}{{template "coder_icon.gohtml" (dict "ID" .Coder "Launcher" .Launcher)}}{{else}}<i class="ti ti-terminal-2"></i>{{end}}{{template "news_dot.gohtml"}}</span>
      <span class="terminal-tab-text">
        <span class="terminal-tab-name">{{.Name}}</span>
        {{if .Project}}<span class="terminal-tab-project">{{.Project}}</span>{{end}}
      </span>
      <span class="terminal-tab-menu" data-tab-menu role="button" tabindex="-1" aria-label="Options for {{.Name}}" title="Options"><i class="ti ti-dots" aria-hidden="true"></i></span>
      <span class="terminal-tab-grip" data-tab-grip aria-hidden="true"><i class="ti ti-grip-vertical"></i></span>
    </a>
    {{end}}
    {{else}}
    <a class="terminal-tab list-group-item list-group-item-action{{if eq .ID $.QuickNav.CurrentID}} active{{end}}"
       href="{{.URL}}" role="tab" draggable="false"
       aria-selected="{{if eq .ID $.QuickNav.CurrentID}}true{{else}}false{{end}}"
       data-tab-id="{{.ID}}" data-tab-kind="{{.Kind}}" data-tab-name="{{.Name}}" data-tab-project="{{.Project}}"
       {{- if .Coder}}{{if index $.Steered .ID}} data-tab-steered="1"{{end}}{{with index $.SteerPrefill .ID}} data-tab-steer-prefill="{{.}}"{{end}}{{with coderRename .Coder}} data-tab-renames="{{.}}"{{end}} data-tab-coder-label="{{coderLabel .Coder}}"{{end}}
       title="{{.Name}}{{if .Project}} ({{.Project}}){{end}}">
      <span class="terminal-tab-icon dc-term-icon running{{if .Working}} working{{end}}{{if .HasNews}} news{{end}}{{if and .Coder (index $.Steered .ID)}} steered{{end}}"{{with .Working}} data-working-since="{{.}}"{{end}} data-tab-icon data-notify-target="{{.ID}}"{{if eq .Launcher "ollama"}} data-launcher="ollama"{{end}} aria-hidden="true">{{if .Coder}}{{template "coder_icon.gohtml" (dict "ID" .Coder "Launcher" .Launcher)}}{{else}}<i class="ti ti-terminal-2"></i>{{end}}{{template "news_dot.gohtml"}}</span>
      <span class="terminal-tab-text">
        <span class="terminal-tab-name">{{.Name}}</span>
        {{if .Project}}<span class="terminal-tab-project">{{.Project}}</span>{{end}}
      </span>
      {{if or (not $.Access.Guest) (and .Coder ($.Access.Can "terminals"))}}<span class="terminal-tab-close" data-tab-close role="button" tabindex="-1" aria-label="{{if .Coder}}Stop coder{{else}}Delete shell{{end}} {{.Name}}" title="{{if .Coder}}Stop coder{{else}}Delete shell{{end}}">
        <i class="ti ti-x" aria-hidden="true"></i>
      </span>{{end}}
      {{if not $.Access.Guest}}<span class="terminal-tab-menu d-lg-none" data-tab-menu role="button" tabindex="-1" aria-label="Options for {{.Name}}" title="Options"><i class="ti ti-dots" aria-hidden="true"></i></span>
      <span class="terminal-tab-grip d-lg-none" data-tab-grip aria-hidden="true"><i class="ti ti-grip-vertical"></i></span>{{end}}
    </a>
    {{end}}
    {{end}}
    {{if not .QuickNav.Strip}}<div class="p-3 text-secondary small">Nothing is running.</div>{{end}}
  </div>
{{end}}

{{/* The plus menu: new coder or shell, the inactive coders to resume, and
     the data of the switcher's editor rows. Cmd+T opens it. A strip refresh
     swaps the rows alone, the filter keeps what is typed. */}}
{{define "terminal_tabs_new.gohtml"}}{{if .Access.Can "terminals"}}
  <div class="dropdown terminal-tabs-new">
    <button type="button" class="btn btn-icon btn-ghost-secondary terminal-tabs-new-btn" data-tabs-new-menu data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="New coder or shell" title="New coder or shell (Cmd+T)">
      <i class="ti ti-plus"></i>
    </button>
    <div class="dropdown-menu dropdown-menu-end terminal-tabs-new-menu" data-own-selection>
      <div class="editor-sheet-filter">
        <i class="ti ti-search" aria-hidden="true"></i>
        <input type="text" class="editor-sheet-filter-input" data-tabs-new-filter placeholder="Filter" aria-label="Filter the menu" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off">
        <span class="editor-sheet-filter-side">
          <button type="button" class="editor-sheet-filter-clear" data-tabs-new-filter-clear aria-label="Clear the filter" title="Clear the filter"><i class="ti ti-x" aria-hidden="true"></i></button>
        </span>
      </div>
      <div class="terminal-tabs-new-rows py-1" data-tabs-new-rows>
        <a class="dropdown-item d-flex align-items-center gap-2" data-tabs-new="coder" href="/coders/new?{{if .QuickNav.CurrentProject}}project={{urlquery .QuickNav.CurrentProject}}&amp;{{end}}return={{urlquery .QuickNav.CurrentPath}}">
          <i class="ti ti-robot flex-shrink-0"></i><span>New coder</span>
        </a>
        <a class="dropdown-item d-flex align-items-center gap-2" data-tabs-new="shell" href="/shells/new?{{if .QuickNav.CurrentProject}}project={{urlquery .QuickNav.CurrentProject}}&amp;{{end}}return={{urlquery .QuickNav.CurrentPath}}">
          <i class="ti ti-terminal-2 flex-shrink-0"></i><span>New shell</span>
        </a>
        {{if and .QuickNav.HasInactiveCoders (not .Access.Guest)}}
        <div class="dropdown-divider" data-tabs-resume-divider></div>
        <h6 class="dropdown-header" data-tabs-resume-head>Inactive coders</h6>
        <div data-tabs-resume-projects>
        {{range $p := .QuickNav.AllProjects}}{{if $p.InactiveCoders}}
        <div data-project-name="{{$p.Name}}" data-project-active="{{if $p.Active}}true{{else}}false{{end}}" data-project-used="{{$p.LastUsedUnix}}">
        <h6 class="dropdown-header terminal-tabs-resume-project"><i class="ti ti-folder me-1"></i>{{$p.Name}}</h6>
        <div data-tabs-resume-fold="{{$p.Name}}">
        {{range $p.InactiveCoders}}
        <form method="post" action="{{.URL}}" data-tab-resume>
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <button type="submit" class="dropdown-item d-flex align-items-center gap-2"
                  data-resume-id="{{.ID}}" data-resume-name="{{.Name}}" data-resume-project="{{$p.Name}}"
                  title="Resume coder {{.Name}}">
            <span class="terminal-tab-icon dc-term-icon{{if .HasNews}} news{{end}}" data-resume-icon data-notify-target="{{.ID}}"{{if eq .Launcher "ollama"}} data-launcher="ollama"{{end}} aria-hidden="true">{{template "coder_icon.gohtml" (dict "ID" .Coder "Launcher" .Launcher)}}{{template "news_dot.gohtml"}}</span>
            <span class="text-truncate">{{.Name}}</span>
          </button>
        </form>
        {{end}}
        </div>
        </div>
        {{end}}{{end}}
        </div>
        {{end}}
        {{/* The switcher's editor rows: one editor link per project sorted
             client side like the resume groups, never shown in the menu,
             which offers only what creates a terminal. */}}
        {{if not .Access.Guest}}
        <div class="d-none" data-tabs-editors>
          {{range $p := .QuickNav.AllProjects}}
          <a data-editor-project="{{$p.Name}}"{{with $p.SearchTags}} data-editor-tags="{{join . " "}}"{{end}} data-project-name="{{$p.Name}}" data-project-active="{{if $p.Active}}true{{else}}false{{end}}" data-project-used="{{$p.LastUsedUnix}}" href="{{$p.EditorURL}}" tabindex="-1"><span class="terminal-tab-icon dc-term-icon" aria-hidden="true"><i class="ti ti-code"></i></span> {{if $p.Tags}}<span class="terminal-switcher-name dc-tagged"><span class="text-truncate">{{$p.Name}}</span>{{template "tag_pie.gohtml" $p.Tags}}</span>{{else}}<span class="terminal-switcher-name text-truncate">{{$p.Name}}</span>{{end}} <span class="terminal-switcher-project text-truncate">Editor</span></a>
          {{end}}
        </div>
        {{end}}
        <div class="dropdown-item-text text-secondary small" data-tabs-new-none hidden>No matches</div>
      </div>
    </div>
  </div>
{{end}}{{end}}
