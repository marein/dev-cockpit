{{define "coder_page_start.gohtml"}}
{{$nav := .SettingsNav}}
<div class="page-header d-print-none mb-3">
  <div class="d-flex align-items-center gap-2">
    <div class="flex-fill min-w-0">
      <h2 class="page-title text-truncate mb-0">Settings</h2>
    </div>
  </div>
</div>

<div class="card">
  <div class="row g-0">
    <div class="col-12 col-md-3 border-end">
      <div class="card-body">
        {{template "settings_nav" $nav}}
      </div>
    </div>
    <div class="col-12 col-md-9">
      <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" data-coder-sections>
          <li class="nav-item">
            <a class="nav-link{{if eq $nav.Section "instructions"}} active{{end}}" href="{{.Base}}/instructions"><i class="ti ti-file-description me-1 d-none d-sm-inline-block"></i>Instructions</a>
          </li>
          <li class="nav-item">
            <a class="nav-link{{if eq $nav.Section "agents"}} active{{end}}" href="{{.Base}}/agents"><i class="ti ti-robot me-1 d-none d-sm-inline-block"></i>Agents</a>
          </li>
          <li class="nav-item">
            <a class="nav-link{{if eq $nav.Section "skills"}} active{{end}}" href="{{.Base}}/skills"><i class="ti ti-tool me-1 d-none d-sm-inline-block"></i>Skills</a>
          </li>
        </ul>
      </div>
      <div class="card-body">
{{end}}

{{define "coder_page_end.gohtml"}}
      </div>
    </div>
  </div>
</div>
{{end}}
