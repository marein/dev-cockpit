{{/* The shell every coder settings page shares: the settings column with the
     coder picked in it, the section tabs in the work head, and the coder's name
     at the head's end while more than one coder is active. */}}
{{define "coder_page_start.gohtml"}}
{{$nav := .SettingsNav}}
{{template "settings_ctx.gohtml" .}}
{{template "work_start.gohtml" .}}
<nav class="nav nav-bordered dc-work-tabs" aria-label="Sections" data-coder-sections>
  <a class="nav-link{{if eq $nav.Section "instructions"}} active{{end}}" href="{{.Base}}/instructions"><i class="ti ti-file-description me-1 dc-hide-xs"></i>Instructions</a>
  <a class="nav-link{{if eq $nav.Section "agents"}} active{{end}}" href="{{.Base}}/agents"><i class="ti ti-robot me-1 dc-hide-xs"></i>Agents</a>
  <a class="nav-link{{if eq $nav.Section "skills"}} active{{end}}" href="{{.Base}}/skills"><i class="ti ti-tool me-1 dc-hide-xs"></i>Skills</a>
</nav>
{{if .MultiCoder}}<span class="ms-auto d-flex align-items-center gap-2 text-secondary small flex-shrink-0"><span class="dc-term-icon" aria-hidden="true">{{template "coder_icon.gohtml" $nav.Selected}}</span><span class="dc-hide-xs">{{coderLabel $nav.Selected}}</span></span>{{end}}
{{template "work_body.gohtml" .}}
<div class="dc-narrow">
{{end}}

{{define "coder_page_end.gohtml"}}
</div>
{{end}}
