{{define "project_editor.gohtml"}}
{{template "app_start.gohtml" .}}
<main class="dc-work">
  <div class="dc-work-body dc-work-fill">
    {{template "flash.gohtml" .}}
<dc-editor class="editor"
     data-editor-name="{{.Project.Name}}"
     data-editor-project-path="{{.Project.Path}}"
     data-editor-grants="{{.Access.Grants}}"{{if .Access.Guest}}
     data-editor-guest{{end}}
     data-editor-max-kib="{{.MaxEditKiB}}"
     data-editor-diff-max-lines="{{.DiffMaxLines}}"
     data-editor-diff-max-kib="{{.DiffMaxKiB}}"
     data-editor-autosave="{{if and .Autosave (.Access.Can "files")}}1{{end}}"
     data-editor-lsp="{{.LSPExts}}"
     data-editor-lsp-names="{{.LSPNames}}"
     data-editor-terminal="{{.Terminal}}"
     data-editor-view="{{.View}}"
     data-editor-file="{{.File}}"
     data-editor-line="{{.Line}}"
     data-editor-col="{{.Col}}"
     data-editor-pair="{{if .Suggested}}suggested{{end}}">
  <div class="editor-body">
    <div class="editor-tree-col">
      <div class="dc-ctx-head editor-pane-header">
        <button type="button" class="editor-project-switch d-flex align-items-center min-w-0 flex-fill" data-editor-project-switch aria-haspopup="dialog" aria-expanded="false" aria-label="Switch project" title="Switch project (Ctrl+Shift+P)">
          <span class="dc-trunc dc-mono">{{.Project.Name}}</span>
          <i class="ti ti-chevron-down icon icon-xs editor-project-caret" aria-hidden="true"></i>
        </button>
        <div data-editor-project-list hidden>
          {{template "editor_projects.gohtml" .}}
        </div>
        <div class="dc-ctx-tools">
          <button type="button" class="btn btn-icon btn-ghost-secondary" data-editor-commit-toggle aria-pressed="false" aria-label="Commit changes" title="Commit changes" hidden>
            <i class="ti ti-git-commit" aria-hidden="true"></i>
          </button>
          <button type="button" class="btn btn-icon btn-ghost-secondary" data-editor-revdiff-toggle aria-pressed="false" aria-label="Compare" title="Compare" hidden>
            <i class="ti ti-git-compare" aria-hidden="true"></i>
          </button>
          <button type="button" class="btn btn-icon btn-ghost-secondary" data-editor-refresh aria-label="Refresh files" title="Refresh">
            <i class="ti ti-refresh" aria-hidden="true"></i>
          </button>
        </div>
      </div>
      <div class="editor-tree" data-editor-tree role="tree">
        <div class="text-secondary small p-3">Loading…</div>
      </div>
      <div class="editor-commit" data-editor-commit hidden>
        <div class="d-flex align-items-center gap-2 px-2 py-2 border-bottom">
          <span class="small fw-medium text-truncate flex-fill">Commit to <span class="fw-bold" data-editor-commit-branch></span></span>
          <button type="button" class="btn btn-sm btn-ghost-secondary p-1 flex-shrink-0" data-editor-commit-group aria-pressed="false" aria-label="Group by folder" title="Group by folder">
            <i class="ti ti-folders"></i>
          </button>
          <button type="button" class="btn btn-sm btn-ghost-secondary p-1 flex-shrink-0" data-editor-commit-close aria-label="Back to the files" title="Back to the files">
            <i class="ti ti-x"></i>
          </button>
        </div>
        <div class="editor-commit-filter" data-editor-commit-filter-row>
          <i class="ti ti-search" aria-hidden="true"></i>
          <input type="text" class="editor-commit-filter-input" data-editor-commit-filter placeholder="Filter changes" aria-label="Filter the changes" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off">
          <span class="editor-commit-filter-side">
            <span class="editor-commit-filter-count" data-editor-commit-filter-count></span>
            <button type="button" class="editor-commit-filter-clear" data-editor-commit-filter-clear aria-label="Clear the filter" title="Clear the filter">
              <i class="ti ti-x"></i>
            </button>
          </span>
        </div>
        <label class="d-flex align-items-center gap-2 m-0 px-2 py-1 border-bottom small editor-commit-all">
          <input class="form-check-input m-0 flex-shrink-0" type="checkbox" data-editor-commit-all aria-label="Select all changes">
          <span class="text-secondary" data-editor-commit-summary></span>
        </label>
        <div class="editor-commit-list" data-editor-commit-list></div>
        <div class="editor-commit-foot border-top p-2 d-flex flex-column gap-2">
          <div class="alert alert-danger small mb-0 py-1 px-2 editor-commit-error" data-editor-commit-error hidden></div>
          <textarea class="form-control form-control-sm editor-commit-message" data-editor-commit-message rows="3" placeholder="Commit message" aria-label="Commit message" spellcheck="false"></textarea>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <label class="form-check m-0 small">
              <input class="form-check-input" type="checkbox" data-editor-commit-amend>
              <span class="form-check-label">Amend</span>
            </label>
            <span class="small text-warning ms-auto" data-editor-commit-length></span>
            <div class="btn-group flex-shrink-0 ms-auto">
              <button type="button" class="btn btn-sm btn-primary" data-editor-commit-button disabled>
                <span class="spinner-border spinner-border-sm me-1" style="width: 1em; height: 1em" data-editor-commit-spin aria-hidden="true" hidden></span><i class="ti ti-git-commit me-1" data-editor-commit-icon></i>Commit
              </button>
              <button type="button" class="btn btn-sm btn-primary dropdown-toggle dropdown-toggle-split" data-editor-commit-more data-bs-toggle="dropdown" aria-expanded="false" aria-label="More ways to commit" disabled></button>
              <div class="dropdown-menu dropdown-menu-end">
                <button type="button" class="dropdown-item" data-editor-commit-push>
                  <i class="ti ti-upload me-2"></i>Commit and push
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="editor-commit" data-editor-revdiff hidden>
        <div class="d-flex align-items-center gap-2 px-2 py-2 border-bottom">
          <span class="small fw-medium text-truncate flex-fill">Compare</span>
          <button type="button" class="btn btn-sm btn-ghost-secondary p-1 flex-shrink-0" data-editor-revdiff-group aria-pressed="false" aria-label="Group by folder" title="Group by folder">
            <i class="ti ti-folders"></i>
          </button>
          <button type="button" class="btn btn-sm btn-ghost-secondary p-1 flex-shrink-0" data-editor-revdiff-close aria-label="Back to the files" title="Back to the files">
            <i class="ti ti-x"></i>
          </button>
        </div>
        <div class="d-flex flex-column gap-1 px-2 py-2 border-bottom">
          <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill min-w-0 d-flex align-items-center gap-2 px-2 text-start" data-editor-revdiff-pick="from" title="Pick the revision to compare from">
              <i class="ti ti-git-branch flex-shrink-0" data-editor-revdiff-icon="from" aria-hidden="true"></i>
              <span class="small opacity-75 flex-shrink-0">from</span>
              <span class="text-truncate" data-editor-revdiff-name="from">…</span>
            </button>
          </div>
          <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill min-w-0 d-flex align-items-center gap-2 px-2 text-start" data-editor-revdiff-pick="to" title="Pick the revision to compare to">
              <i class="ti ti-git-branch flex-shrink-0" data-editor-revdiff-icon="to" aria-hidden="true"></i>
              <span class="small opacity-75 flex-shrink-0">to</span>
              <span class="text-truncate" data-editor-revdiff-name="to">…</span>
            </button>
          </div>
          <div class="d-flex align-items-center gap-1">
            <select class="form-select form-select-sm flex-fill min-w-0" data-editor-revdiff-mode aria-label="What to compare">
              <option value="since">What the branch changed since it split</option>
              <option value="direct">Everything that differs between the two</option>
            </select>
            <button type="button" class="btn btn-sm btn-ghost-secondary p-1 flex-shrink-0" data-editor-revdiff-reset aria-label="Back to the suggested pair" title="Back to the suggested pair" hidden>
              <i class="ti ti-restore"></i>
            </button>
          </div>
        </div>
        <div class="editor-commit-filter" data-editor-revdiff-filter-row>
          <i class="ti ti-search" aria-hidden="true"></i>
          <input type="text" class="editor-commit-filter-input" data-editor-revdiff-filter placeholder="Filter changes" aria-label="Filter the changes" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off">
          <span class="editor-commit-filter-side">
            <span class="editor-commit-filter-count" data-editor-revdiff-filter-count></span>
            <button type="button" class="editor-commit-filter-clear" data-editor-revdiff-filter-clear aria-label="Clear the filter" title="Clear the filter">
              <i class="ti ti-x"></i>
            </button>
          </span>
        </div>
        <div class="d-flex align-items-center gap-2 px-2 py-1 border-bottom small">
          <span class="text-secondary" data-editor-revdiff-summary></span>
        </div>
        <div class="alert alert-danger small mb-0 py-1 px-2 mx-2 mt-2 editor-commit-error" data-editor-revdiff-error hidden></div>
        <div class="editor-commit-list" data-editor-revdiff-list></div>
      </div>
      <div class="editor-drop-hint" data-editor-drop-hint hidden></div>
      <input type="file" data-editor-upload-input multiple hidden>
      <input type="file" data-editor-upload-dir-input webkitdirectory multiple hidden>
    </div>

    <div class="editor-splitter" data-editor-splitter></div>

    <div class="editor-pane-col">
      <div class="editor-groups" data-editor-groups>
        {{template "editor_group.gohtml" (dict "Editor" . "Chrome" true)}}
      </div>
      <template data-editor-group-template>{{template "editor_group.gohtml" (dict "Editor" . "Chrome" false)}}</template>
      <div class="editor-drop-zone" data-editor-drop-zone hidden></div>
      {{/* Every entry keeps its whole width and hugs its content with the same
           padding, so the entries stand at even gaps; the message yields its
           room first. Where the entries do not fit, and on a phone always, the
           texts marked data-statusbar-text step back together and the icons
           and the cursor position stay (fitStatusbar in editor.js). */}}
      <div class="editor-statusbar small d-flex align-items-center gap-2 px-2 py-1 border-top" data-editor-statusbar>
        <span class="text-truncate flex-fill text-secondary" data-editor-status></span>
        <span class="d-inline-flex align-items-center gap-1 px-2 text-secondary text-nowrap flex-shrink-0" data-editor-lsp-index style="font-size: 0.85em" hidden>
          <span data-editor-lsp-index-label data-statusbar-text></span>
          <span class="progress" style="width: 3.5rem; height: 3px"><span class="progress-bar" data-editor-lsp-index-bar></span></span>
        </span>
        <button type="button" class="btn btn-sm py-0 px-2 min-w-0 border-0 bg-transparent text-secondary text-nowrap d-inline-flex align-items-center gap-1 mw-100 flex-shrink-0" data-editor-git-status aria-label="Git" hidden>
          <i class="ti ti-git-branch" aria-hidden="true" data-editor-git-icon></i><span class="spinner-border spinner-border-sm" style="width: 1em; height: 1em" data-editor-git-spin aria-hidden="true" hidden></span><span class="text-truncate" style="max-width: 9rem" data-editor-git-branch data-statusbar-text></span><span data-editor-git-ab data-statusbar-text hidden></span>
        </button>
        {{if not .Access.Guest}}<button type="button" class="btn btn-sm py-0 px-2 min-w-0 border-0 bg-transparent text-secondary text-nowrap d-inline-flex align-items-center gap-1 flex-shrink-0" data-editor-forge-status aria-label="Forge" hidden></button>{{end}}
        <button type="button" class="btn btn-sm py-0 px-2 min-w-0 border-0 bg-transparent text-secondary text-nowrap d-inline-flex align-items-center gap-1 flex-shrink-0" data-editor-docker-status hidden>
          <i class="ti ti-brand-docker" aria-hidden="true"></i><span data-editor-docker-status-text data-statusbar-text hidden></span>
        </button>
        <button type="button" class="btn btn-sm py-0 px-2 min-w-0 border-0 bg-transparent text-secondary d-inline-flex align-items-center flex-shrink-0" data-editor-term-status aria-label="Terminals" title="Terminals (Ctrl+J)">
          <i class="ti ti-terminal-2" aria-hidden="true"></i>
        </button>
        {{if not .Access.Guest}}<button type="button" class="btn btn-sm py-0 px-2 min-w-0 border-0 bg-transparent text-purple d-inline-flex align-items-center flex-shrink-0" data-editor-asst-status aria-label="Assistants" title="Assistants (Ctrl+I)">
          <i class="ti ti-sparkles" aria-hidden="true"></i>
        </button>{{end}}
        <span class="text-secondary text-nowrap d-inline-flex align-items-center gap-1 px-2 flex-shrink-0" data-editor-readonly hidden>
          <i class="ti ti-lock" aria-hidden="true"></i><span class="d-inline-flex align-items-center gap-1 min-w-0" data-statusbar-text>Read only<span class="text-truncate d-none d-md-inline" style="max-width: 20rem" data-editor-readonly-path></span></span>
        </span>
        <span class="text-secondary text-nowrap px-2 flex-shrink-0" data-editor-pos hidden></span>
      </div>
    </div>

    <div class="editor-backdrop" data-editor-backdrop hidden></div>

    <div class="editor-panels" data-editor-panels hidden>
      <div class="dropdown-menu editor-settings-menu p-3" data-editor-settings-menu>
        <div class="mb-2">
          <label class="form-label small mb-1">Tab width</label>
          <select class="form-select form-select-sm" data-editor-setting="tab_size">
            <option value="2">2</option>
            <option value="4">4</option>
            <option value="8">8</option>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small mb-1">Indentation</label>
          <select class="form-select form-select-sm" data-editor-indent>
            <option value="tab">Tab</option>
            <option value="2spaces">2 spaces</option>
            <option value="4spaces">4 spaces</option>
          </select>
          <input type="text" class="form-control form-control-sm" data-editor-indent-display disabled hidden>
          <div class="form-text small mt-1" data-editor-indent-hint hidden>From .editorconfig</div>
        </div>
        <div class="mb-2">
          <label class="form-label small mb-1">Font size</label>
          <select class="form-select form-select-sm" data-editor-setting="font_size">
            <option>10</option><option>11</option><option>12</option><option>13</option>
            <option>14</option><option>15</option><option>16</option><option>18</option>
            <option>20</option><option>24</option>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small mb-1">Diff view</label>
          <select class="form-select form-select-sm" data-editor-setting="diff_view">
            <option value="auto">Automatic, by width</option>
            <option value="side">Side by side</option>
            <option value="inline">Inline</option>
          </select>
        </div>
        <label class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" data-editor-setting="diff_collapse">
          <span class="form-check-label small">Fold unchanged parts of a diff</span>
        </label>
        <label class="form-check form-switch mb-0">
          <input class="form-check-input" type="checkbox" data-editor-setting="line_wrap">
          <span class="form-check-label small">Wrap long lines</span>
        </label>
      </div>
      <div class="dropdown-menu terminal-settings-menu" data-editor-term-settings-menu>
        {{template "terminal_settings.gohtml"}}
      </div>
      <div class="dropdown-menu" data-editor-docker-menu>
        <div data-editor-docker-list></div>
      </div>
    </div>

    <div class="editor-sheet" data-editor-sheet hidden>
      <div class="editor-sheet-panel" role="dialog" aria-modal="true" aria-label="Open files" data-editor-sheet-panel>
        <div class="editor-sheet-head d-flex align-items-center gap-2 px-3 py-2 border-bottom">
          <span class="fw-medium" data-editor-sheet-title></span>
          <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary ms-auto" data-editor-sheet-close aria-label="Close">
            <i class="ti ti-x"></i>
          </button>
        </div>
        <div class="editor-sheet-filter" data-editor-sheet-filter-row hidden>
          <i class="ti ti-search" aria-hidden="true"></i>
          <input type="text" class="editor-sheet-filter-input" data-editor-sheet-filter placeholder="Filter" aria-label="Filter the list" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off">
          <span class="editor-sheet-filter-side">
            <span class="editor-sheet-filter-count" data-editor-sheet-filter-count></span>
            <button type="button" class="editor-sheet-filter-clear" data-editor-sheet-filter-clear aria-label="Clear the filter" title="Clear the filter">
              <i class="ti ti-x"></i>
            </button>
          </span>
        </div>
        <div class="editor-sheet-body" data-editor-sheet-body></div>
        <div class="text-secondary small px-3 py-2" data-editor-sheet-empty hidden></div>
      </div>
    </div>

    <div class="editor-palette" data-editor-palette hidden>
      <div class="editor-palette-panel" role="dialog" aria-label="Switch project">
        <div class="editor-palette-head">
          <input type="text" class="form-control" placeholder="Switch project…" data-editor-project-filter autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" aria-label="Switch project" enterkeyhint="go">
        </div>
        <div class="editor-palette-list" data-editor-palette-list role="listbox">
          <div class="editor-palette-empty text-secondary small" data-editor-project-empty hidden>No matches.</div>
        </div>
      </div>
    </div>

    <div class="editor-quickopen" data-editor-quickopen hidden>
      <div class="editor-quickopen-panel">
        <div class="position-relative flex-shrink-0">
          <input type="text" class="form-control" placeholder="Go to file…" data-editor-quickopen-input autocomplete="off" spellcheck="false" aria-label="Go to file">
          <div class="editor-quickopen-actions position-absolute top-50 end-0 translate-middle-y me-2" data-editor-quickopen-actions>
            <div class="btn-group" role="group" aria-label="Search for" data-editor-quickopen-kinds hidden>
              <button type="button" class="btn btn-sm btn-ghost-secondary px-2" data-editor-quickopen-kind="files" title="Files (Ctrl+Shift+O)" aria-pressed="true">Files</button>
              <button type="button" class="btn btn-sm btn-ghost-secondary px-2" data-editor-quickopen-kind="types" title="Types (Ctrl+O)" aria-pressed="false">Types</button>
            </div>
            <button type="button" class="btn btn-sm btn-ghost-secondary px-2" data-editor-quickopen-case title="Match case" aria-label="Match case" aria-pressed="false" hidden>Aa</button>
            <button type="button" class="btn btn-sm btn-ghost-secondary px-2 font-monospace" data-editor-quickopen-regex title="Regular expression" aria-pressed="false" hidden>.*</button>
          </div>
        </div>
        <input type="text" class="form-control" placeholder="Replace with…" data-editor-quickopen-replace autocomplete="off" spellcheck="false" aria-label="Replace with" hidden>
        <div class="editor-quickopen-context d-flex align-items-center gap-2 px-3 py-1 small text-secondary border-bottom" data-editor-quickopen-context hidden>
          <span class="editor-quickopen-slot" role="button" tabindex="0" data-editor-quickopen-folder-slot title="Folder to search: whole project"></span>
          <span class="editor-quickopen-slot ms-auto justify-content-end" role="button" tabindex="0" data-editor-quickopen-mask-slot title="Files to search: all files"></span>
          <span class="text-truncate" data-editor-quickopen-structure hidden></span>
        </div>
        <div class="editor-quickopen-list" data-editor-quickopen-list role="listbox"></div>
        <div class="editor-quickopen-foot d-flex align-items-center gap-2 px-3 py-1 small text-secondary border-top" data-editor-quickopen-foot>
          <span data-editor-quickopen-foot-left></span>
          <span class="ms-auto text-end" data-editor-quickopen-foot-right></span>
          <button type="button" class="btn btn-sm btn-primary py-0" data-editor-quickopen-replace-all hidden></button>
        </div>
      </div>
    </div>
  </div>
  <div data-editor-term-modals-host></div>
  {{if .Access.Can "comments"}}<div hidden>
    <div style="padding: 0.25rem 0.75rem 0.5rem" data-editor-sheet-unfiltered data-editor-project-comment-form>
      {{template "project_comment_field.gohtml" (dict "Small" false)}}
    </div>
  </div>{{end}}
  {{- if .Access.Can "comments"}}
  {{/* The field a press on a line number opens under the line. */}}
  <template data-editor-line-comment>
    {{- if .Access.Guest}}{{template "line_comment_field.gohtml" (dict "Hint" "The comment follows this line as the file changes, but works best when the line keeps its content.")}}
    {{- else}}{{template "line_comment_field.gohtml" (dict "Hint" "The comment follows this line as the file changes, but works best when the line keeps its content. The assistant can read and manage all line comments.")}}{{end}}
  </template>
  {{- end}}
  <div data-editor-comment-modal-host>
    <div class="modal modal-blur fade" data-editor-comment-modal tabindex="-1" aria-labelledby="editor-comment-modal-title" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <div class="min-w-0">
              <h3 class="modal-title" id="editor-comment-modal-title" data-editor-comment-title>Project comment</h3>
              <div class="text-secondary small d-flex min-w-0 mt-1" hidden data-editor-comment-place></div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" data-editor-comment-thread></div>
        </div>
      </div>
    </div>
  </div>
</dc-editor>

{{template "editor_shortcuts_modal.gohtml" .}}

{{template "app_end.gohtml" .}}
{{end}}
