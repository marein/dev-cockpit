{{define "project_editor.gohtml"}}
{{template "app_start.gohtml" .}}
<div class="page-header d-print-none mb-3">
  <div class="d-flex align-items-center gap-2">
    <div class="flex-fill min-w-0">
      {{template "project_breadcrumb.gohtml" .Project.Name}}
      <h2 class="page-title text-break">Editor</h2>
    </div>
    <div class="flex-shrink-0">
      <a class="btn btn-outline-secondary btn-icon" href="{{.Return}}" aria-label="Back" title="Back">
        <i class="ti ti-arrow-left"></i>
      </a>
    </div>
  </div>
</div>

<dc-editor class="card editor"
     data-editor-name="{{.Project.Name}}"
     data-editor-project-path="{{.Project.Path}}"
     data-editor-max-kib="{{.MaxEditKiB}}"
     data-editor-diff-max-lines="{{.DiffMaxLines}}"
     data-editor-diff-max-kib="{{.DiffMaxKiB}}"
     data-editor-lsp="{{.LSPExts}}"
     data-editor-terminal="{{.Terminal}}">
  <div class="editor-body">
    <div class="editor-tree-col">
      <div class="editor-pane-header d-flex align-items-center gap-2 px-2 py-2 border-bottom">
        <div class="dropdown min-w-0 flex-fill">
          <button type="button" class="editor-project-switch d-flex align-items-center gap-2 min-w-0 w-100" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Switch project" title="Switch project (Ctrl+Shift+P)">
            <i class="ti ti-folder"></i>
            <span class="text-truncate small fw-medium">{{.Project.Name}}</span>
            <i class="ti ti-chevron-down editor-project-caret"></i>
          </button>
          <div class="dropdown-menu editor-project-menu">
            <div class="editor-project-search">
              <input type="search" class="form-control form-control-sm" data-editor-project-filter placeholder="Search projects" aria-label="Search projects" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false">
            </div>
            <div data-editor-project-list>
              {{template "editor_projects.gohtml" .}}
            </div>
            <div class="dropdown-item-text text-secondary small" data-editor-project-empty hidden>No matches</div>
          </div>
        </div>
        <button type="button" class="btn btn-sm btn-ghost-secondary p-1" data-editor-commit-toggle aria-pressed="false" aria-label="Commit changes" title="Commit changes" hidden>
          <i class="ti ti-git-commit"></i>
        </button>
        <button type="button" class="btn btn-sm btn-ghost-secondary p-1" data-editor-refresh aria-label="Refresh files" title="Refresh">
          <i class="ti ti-refresh"></i>
        </button>
      </div>
      <div class="editor-tree" data-editor-tree role="tree">
        <div class="text-secondary small p-3">Loading…</div>
      </div>
      <div class="editor-commit" data-editor-commit hidden>
        <div class="d-flex align-items-center gap-2 px-2 py-2 border-bottom">
          <span class="small fw-medium text-truncate flex-fill">Commit to <span class="fw-bold" data-editor-commit-branch></span></span>
          <button type="button" class="btn btn-sm btn-ghost-secondary p-1 flex-shrink-0" data-editor-commit-group aria-pressed="false" aria-label="Group by folder" title="Group by folder">
            <i class="ti ti-folders"></i>
          </button>
          <button type="button" class="btn btn-sm btn-ghost-secondary p-1 flex-shrink-0" data-editor-commit-close aria-label="Back to the files" title="Back to the files">
            <i class="ti ti-x"></i>
          </button>
        </div>
        <label class="d-flex align-items-center gap-2 m-0 px-2 py-1 border-bottom small editor-commit-all">
          <input class="form-check-input m-0 flex-shrink-0" type="checkbox" data-editor-commit-all aria-label="Select all changes">
          <span class="text-secondary" data-editor-commit-summary></span>
        </label>
        <div class="editor-commit-list" data-editor-commit-list></div>
        <div class="border-top p-2 d-flex flex-column gap-2">
          <div class="alert alert-danger small mb-0 py-1 px-2 editor-commit-error" data-editor-commit-error hidden></div>
          <textarea class="form-control form-control-sm editor-commit-message" data-editor-commit-message rows="3" placeholder="Commit message" aria-label="Commit message" spellcheck="false"></textarea>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <label class="form-check m-0 small">
              <input class="form-check-input" type="checkbox" data-editor-commit-amend>
              <span class="form-check-label">Amend</span>
            </label>
            <span class="small text-warning ms-auto" data-editor-commit-length></span>
            <div class="btn-group flex-shrink-0 ms-auto">
              <button type="button" class="btn btn-sm btn-primary" data-editor-commit-button disabled>
                <span class="spinner-border spinner-border-sm me-1" style="width: 1em; height: 1em" data-editor-commit-spin aria-hidden="true" hidden></span><i class="ti ti-git-commit me-1" data-editor-commit-icon></i>Commit
              </button>
              <button type="button" class="btn btn-sm btn-primary dropdown-toggle dropdown-toggle-split" data-editor-commit-more data-bs-toggle="dropdown" aria-expanded="false" aria-label="More ways to commit" disabled></button>
              <div class="dropdown-menu dropdown-menu-end">
                <button type="button" class="dropdown-item" data-editor-commit-push>
                  <i class="ti ti-upload me-2"></i>Commit and push
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="editor-drop-hint" data-editor-drop-hint hidden></div>
      <input type="file" data-editor-upload-input multiple hidden>
      <input type="file" data-editor-upload-dir-input webkitdirectory multiple hidden>
    </div>

    <div class="editor-splitter" data-editor-splitter></div>

    <div class="editor-pane-col">
      <div class="editor-pane-header d-flex align-items-stretch border-bottom">
        <button type="button" class="editor-drawer-toggle" data-editor-drawer-toggle aria-label="Toggle file tree" title="Files">
          <i class="ti ti-folder"></i>
        </button>
        <div class="editor-tabs" data-editor-tabs role="tablist"></div>
        <div class="editor-actions d-flex align-items-center gap-1 px-2 flex-shrink-0">
          <button type="button" class="btn btn-sm btn-primary" data-editor-save disabled hidden>
            <i class="ti ti-device-floppy"></i><span class="d-none d-sm-inline ms-1">Save</span>
          </button>
          <div class="dropdown d-flex">
            <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary" data-bs-toggle="dropdown" data-editor-menu aria-label="Editor actions" title="Editor actions">
              <i class="ti ti-dots-vertical"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end" data-editor-menu-list>
              <button type="button" class="dropdown-item" data-editor-files-item>
                <i class="ti ti-files me-2"></i>Open files<span class="badge bg-secondary-lt ms-2" data-editor-files-count></span>
              </button>
              <button type="button" class="dropdown-item" data-editor-quick-open-item>
                <i class="ti ti-file-search me-2"></i>Go to file
              </button>
              <button type="button" class="dropdown-item" data-editor-find-item disabled>
                <i class="ti ti-search me-2"></i>Find in file
              </button>
              <button type="button" class="dropdown-item" data-editor-search-project-item>
                <i class="ti ti-list-search me-2"></i>Find in files
              </button>
              <button type="button" class="dropdown-item" data-editor-replace-project-item>
                <i class="ti ti-replace me-2"></i>Replace in files
              </button>
              <button type="button" class="dropdown-item" data-editor-goto disabled>
                <i class="ti ti-arrow-bar-to-down me-2"></i>Go to line
              </button>
              <button type="button" class="dropdown-item" data-editor-reindex-item hidden>
                <i class="ti ti-refresh me-2"></i>Reindex
              </button>
              <div class="dropdown-divider"></div>
              <button type="button" class="dropdown-item" data-editor-settings-item>
                <i class="ti ti-adjustments me-2"></i>Editor settings
              </button>
              <button type="button" class="dropdown-item" data-editor-term-item aria-pressed="false" hidden>
                <i class="ti ti-terminal-2 me-2"></i>Terminal
              </button>
              <button type="button" class="dropdown-item" data-editor-docker-item hidden>
                <i class="ti ti-brand-docker me-2"></i>Docker
              </button>
              <button type="button" class="dropdown-item" data-editor-comments-item>
                <i class="ti ti-messages me-2"></i>Line comments<span class="badge bg-secondary-lt ms-2" data-editor-comments-count hidden></span>
              </button>
              <button type="button" class="dropdown-item" data-editor-git-item hidden>
                <i class="ti ti-git-branch me-2"></i>Git<span class="badge bg-secondary-lt ms-2" data-editor-git-item-count hidden></span>
              </button>
              <button type="button" class="dropdown-item" data-editor-fullscreen aria-pressed="false" hidden>
                <i class="ti ti-maximize me-2"></i>Fullscreen
              </button>
              <div class="dropdown-divider"></div>
              <button type="button" class="dropdown-item" data-editor-save-all disabled>
                <i class="ti ti-device-floppy me-2"></i>Save all
              </button>
              <div class="dropdown-divider"></div>
              <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#editor-shortcuts-modal">
                <i class="ti ti-keyboard me-2"></i>Keyboard shortcuts
              </button>
            </div>
          </div>
          <a class="btn btn-sm btn-icon btn-ghost-secondary editor-back" href="{{.Return}}" aria-label="Back" title="Back">
            <i class="ti ti-arrow-left"></i>
          </a>
        </div>
      </div>
      <div class="d-flex align-items-stretch border-bottom" data-editor-compare hidden>
        <div class="d-flex align-items-center gap-2 px-2 py-1 flex-fill min-w-0">
          <i class="ti ti-file flex-shrink-0"></i>
          <span class="small text-truncate" data-editor-compare-name="left"></span>
          <button type="button" class="btn btn-sm btn-primary ms-auto flex-shrink-0" data-editor-compare-save="left" disabled>
            <i class="ti ti-device-floppy"></i><span class="d-none d-sm-inline ms-1">Save</span>
          </button>
        </div>
        <div class="d-flex align-items-center gap-2 px-2 py-1 flex-fill min-w-0 border-start">
          <i class="ti ti-file flex-shrink-0"></i>
          <span class="small text-truncate" data-editor-compare-name="right"></span>
          <button type="button" class="btn btn-sm btn-primary ms-auto flex-shrink-0" data-editor-compare-save="right" disabled>
            <i class="ti ti-device-floppy"></i><span class="d-none d-sm-inline ms-1">Save</span>
          </button>
        </div>
      </div>
      <div class="editor-surface" data-editor-surface>
        <div class="editor-placeholder text-secondary" data-editor-placeholder>
          <i class="ti ti-files fs-1 d-block mb-2"></i>
          <div>Select a file to view and edit it.</div>
          <div class="small mt-1">Files up to {{.MaxEditSize}} can be edited.</div>
          <button type="button" class="btn btn-sm btn-outline-secondary mt-3 editor-placeholder-browse" data-editor-browse>
            <i class="ti ti-folder me-1"></i>Browse files
          </button>
          <div class="small mt-3 editor-placeholder-keys">
            <kbd>Ctrl</kbd>+<kbd>O</kbd> go to file
            <span class="mx-1">·</span>
            <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>F</kbd> find in files
            <span class="mx-1">·</span>
            <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>H</kbd> replace in files
            <span class="mx-1">·</span>
            <kbd>Ctrl</kbd>+<kbd>S</kbd> save
            <span class="mx-1">·</span>
            <kbd>Ctrl</kbd>+<kbd>F</kbd> find in file
            <span class="mx-1">·</span>
            <kbd>Ctrl</kbd>+<kbd>Tab</kbd> next tab
            <span class="mx-1 d-none d-md-inline">·</span>
            <span class="d-none d-md-inline"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>P</kbd> switch project</span>
            <span class="mx-1 d-none d-md-inline">·</span>
            <span class="d-none d-md-inline"><kbd>Ctrl</kbd>+<kbd>B</kbd> go to definition</span>
            <span class="mx-1 d-none d-md-inline">·</span>
            <span class="d-none d-md-inline"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>X</kbd> close tab</span>
            <span class="mx-1 d-none d-md-inline">·</span>
            <span class="d-none d-md-inline"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Enter</kbd> fullscreen</span>
            <span class="mx-1 d-none d-md-inline">·</span>
            <span class="d-none d-md-inline"><kbd>Ctrl</kbd>+<kbd>K</kbd> commit</span>
            <span class="mx-1 d-none d-md-inline">·</span>
            <span class="d-none d-md-inline"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>G</kbd> git</span>
            <span class="mx-1 d-none d-md-inline">·</span>
            <span class="d-none d-md-inline"><kbd>Ctrl</kbd>+<kbd>J</kbd> terminal</span>
            <span class="mx-1 d-none d-md-inline">·</span>
            <span class="d-none d-md-inline"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>D</kbd> docker</span>
          </div>
        </div>
        <div class="editor-merge" data-editor-merge hidden></div>
        <div class="editor-preview markdown" data-editor-preview-pane hidden></div>
        <div class="editor-viewer" data-editor-viewer hidden></div>
      </div>
      <div class="editor-term-panel" data-editor-term-panel hidden>
        <div class="editor-term-splitter" data-editor-term-splitter></div>
        <div class="editor-term-head d-flex align-items-center border-top border-bottom">
          <div class="editor-term-tabs-host flex-fill min-w-0" data-editor-term-tabs-host></div>
          <div class="d-flex align-items-center gap-1 px-2 flex-shrink-0">
            <div class="d-flex align-items-center" data-editor-term-foots-host></div>
            <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary" data-terminal-refresh aria-label="Refresh stream" title="Refresh stream">
              <i class="ti ti-refresh"></i>
            </button>
            <div class="dropdown d-flex">
              <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary" data-editor-term-plus data-bs-toggle="dropdown" aria-expanded="false" aria-label="New coder or shell" title="New coder or shell (Cmd+T)">
                <i class="ti ti-plus"></i>
              </button>
              <div class="dropdown-menu dropdown-menu-end editor-term-new-menu">
                <a class="dropdown-item" href="/coders/new?project={{urlquery .Project.Name}}&amp;return=/projects/{{urlquery .Project.Name}}/editor&amp;panel=1">
                  <i class="ti ti-robot me-2"></i>New coder
                </a>
                <button type="button" class="dropdown-item" data-editor-term-new>
                  <i class="ti ti-terminal-2 me-2"></i>New shell
                </button>
                <div data-editor-term-resume-host></div>
              </div>
            </div>
            <div class="dropdown d-flex">
              <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Terminal settings" title="Terminal settings">
                <i class="ti ti-settings"></i>
              </button>
              <div class="dropdown-menu dropdown-menu-end terminal-settings-menu">
                <terminal-setting-select
                  setting="font-size"
                  storage-key="dc-terminal-font-size"
                  default-value="14"
                  options="10,11,12,13,14,15,16,18,20,24"
                  icon="text-size"
                  label="Font size"
                  title="Font size"
                ></terminal-setting-select>
                <terminal-setting-select
                  setting="theme"
                  storage-key="dc-terminal-theme"
                  default-value="auto"
                  options="auto:Standard,solarized-auto:Solarized,gruvbox-auto:Gruvbox,catppuccin-auto:Catppuccin,one-auto:One,tokyonight-auto:Tokyo Night,everforest-auto:Everforest,rosepine-auto:Rosé Pine,ayu-auto:Ayu"
                  icon="palette"
                  label="Theme"
                  title="Terminal theme"
                ></terminal-setting-select>
              </div>
            </div>
            <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary" data-editor-term-hide aria-label="Hide terminal panel" title="Hide terminal panel (Ctrl+J)">
              <i class="ti ti-chevron-down"></i>
            </button>
          </div>
        </div>
        <div class="editor-term-body" data-editor-term-body>
          <div class="editor-term-empty text-secondary small p-3" data-editor-term-empty hidden>
            <i class="ti ti-terminal-2 me-1"></i>No terminals are running in this project.
            <button type="button" class="btn btn-sm btn-outline-secondary ms-2" data-editor-term-new-empty>
              <i class="ti ti-plus me-1"></i>New shell
            </button>
          </div>
        </div>
      </div>
      <div class="editor-statusbar small d-flex align-items-center gap-2 px-2 py-1 border-top">
        <span class="text-truncate flex-fill text-secondary" data-editor-status></span>
        <span class="d-inline-flex align-items-center gap-1 text-secondary text-nowrap" data-editor-lsp-index style="font-size: 0.85em" hidden>
          <span data-editor-lsp-index-label></span>
          <span class="progress" style="width: 3.5rem; height: 3px"><span class="progress-bar" data-editor-lsp-index-bar></span></span>
        </span>
        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-secondary text-nowrap d-inline-flex align-items-center gap-1 mw-100" data-editor-git-status aria-label="Git" hidden>
          <i class="ti ti-git-branch" aria-hidden="true" data-editor-git-icon></i><span class="spinner-border spinner-border-sm" style="width: 1em; height: 1em" data-editor-git-spin aria-hidden="true" hidden></span><span class="text-truncate" style="max-width: 9rem" data-editor-git-branch></span><span data-editor-git-ab hidden></span>
        </button>
        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-secondary text-nowrap d-inline-flex align-items-center gap-1" data-editor-docker-status hidden>
          <i class="ti ti-brand-docker" aria-hidden="true"></i><span data-editor-docker-status-text></span>
        </button>
        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-secondary text-nowrap d-inline-flex align-items-center" data-editor-term-status aria-pressed="false" aria-label="Terminal" title="Terminal (Ctrl+J)" hidden>
          <i class="ti ti-terminal-2" aria-hidden="true"></i>
        </button>
        <span class="text-secondary text-nowrap d-inline-flex align-items-center gap-1" data-editor-readonly hidden>
          <i class="ti ti-lock" aria-hidden="true"></i>Read only<span class="text-truncate d-none d-md-inline" style="max-width: 20rem" data-editor-readonly-path></span>
        </span>
        <span class="text-secondary text-nowrap" data-editor-pos hidden></span>
      </div>
    </div>

    <div class="editor-backdrop" data-editor-backdrop hidden></div>

    <div class="editor-panels" data-editor-panels hidden>
      <div class="dropdown-menu editor-settings-menu p-3" data-editor-settings-menu>
        <div class="mb-2">
          <label class="form-label small mb-1">Tab width</label>
          <select class="form-select form-select-sm" data-editor-setting="tab_size">
            <option value="2">2</option>
            <option value="4">4</option>
            <option value="8">8</option>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small mb-1">Indentation</label>
          <select class="form-select form-select-sm" data-editor-indent>
            <option value="tab">Tab</option>
            <option value="2spaces">2 spaces</option>
            <option value="4spaces">4 spaces</option>
          </select>
          <input type="text" class="form-control form-control-sm" data-editor-indent-display disabled hidden>
          <div class="form-text small mt-1" data-editor-indent-hint hidden>From .editorconfig</div>
        </div>
        <div class="mb-2">
          <label class="form-label small mb-1">Font size</label>
          <select class="form-select form-select-sm" data-editor-setting="font_size">
            <option>10</option><option>11</option><option>12</option><option>13</option>
            <option>14</option><option>15</option><option>16</option><option>18</option>
            <option>20</option><option>24</option>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small mb-1">Diff view</label>
          <select class="form-select form-select-sm" data-editor-setting="diff_view">
            <option value="auto">Automatic, by width</option>
            <option value="side">Side by side</option>
            <option value="inline">Inline</option>
          </select>
        </div>
        <label class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" data-editor-setting="diff_collapse">
          <span class="form-check-label small">Fold unchanged parts of a diff</span>
        </label>
        <label class="form-check form-switch mb-0">
          <input class="form-check-input" type="checkbox" data-editor-setting="line_wrap">
          <span class="form-check-label small">Wrap long lines</span>
        </label>
      </div>
      <div class="dropdown-menu" data-editor-docker-menu>
        <div data-editor-docker-list></div>
      </div>
    </div>

    <div class="editor-sheet" data-editor-sheet hidden>
      <div class="editor-sheet-panel" role="dialog" aria-modal="true" aria-label="Open files" data-editor-sheet-panel>
        <div class="editor-sheet-head d-flex align-items-center gap-2 px-3 py-2 border-bottom">
          <span class="fw-medium" data-editor-sheet-title></span>
          <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary ms-auto" data-editor-sheet-close aria-label="Close">
            <i class="ti ti-x"></i>
          </button>
        </div>
        <div class="editor-sheet-body" data-editor-sheet-body></div>
      </div>
    </div>

    <div class="editor-quickopen" data-editor-quickopen hidden>
      <div class="editor-quickopen-panel">
        <div class="position-relative flex-shrink-0">
          <input type="text" class="form-control" placeholder="Go to file…" data-editor-quickopen-input autocomplete="off" spellcheck="false" aria-label="Go to file">
          <div class="editor-quickopen-actions position-absolute top-50 end-0 translate-middle-y me-2" data-editor-quickopen-actions>
            <button type="button" class="btn btn-sm btn-ghost-secondary px-2" data-editor-quickopen-case title="Match case" aria-label="Match case" aria-pressed="false" hidden>Aa</button>
            <button type="button" class="btn btn-sm btn-ghost-secondary px-2 font-monospace" data-editor-quickopen-regex title="Regular expression" aria-pressed="false" hidden>.*</button>
          </div>
        </div>
        <input type="text" class="form-control" placeholder="Replace with…" data-editor-quickopen-replace autocomplete="off" spellcheck="false" aria-label="Replace with" hidden>
        <div class="editor-quickopen-context d-flex align-items-center gap-2 px-3 py-1 small text-secondary border-bottom" data-editor-quickopen-context hidden>
          <span class="editor-quickopen-slot" role="button" tabindex="0" data-editor-quickopen-folder-slot title="Folder to search: whole project"></span>
          <span class="editor-quickopen-slot ms-auto justify-content-end" role="button" tabindex="0" data-editor-quickopen-mask-slot title="Files to search: all files"></span>
        </div>
        <div class="editor-quickopen-list" data-editor-quickopen-list role="listbox"></div>
        <div class="editor-quickopen-foot d-flex align-items-center gap-2 px-3 py-1 small text-secondary border-top" data-editor-quickopen-foot>
          <span data-editor-quickopen-foot-left></span>
          <span class="ms-auto text-end" data-editor-quickopen-foot-right></span>
          <button type="button" class="btn btn-sm btn-primary py-0" data-editor-quickopen-replace-all hidden></button>
        </div>
      </div>
    </div>
  </div>
  <div data-editor-term-modals-host></div>
  <div data-editor-comment-modal-host>
    <div class="modal modal-blur fade" data-editor-comment-modal tabindex="-1" aria-labelledby="editor-comment-modal-title" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h3 class="modal-title" id="editor-comment-modal-title" data-editor-comment-title>Line comment</h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="text-secondary small text-truncate" data-editor-comment-place></div>
            <div class="text-secondary small font-monospace text-truncate mt-1" data-editor-comment-code hidden></div>
            <textarea class="form-control mt-3" rows="4" data-editor-comment-text placeholder="What about this line?" aria-label="Comment"></textarea>
            <div class="invalid-feedback">A comment is required.</div>
            <small class="form-hint mt-2">The comment follows this line as the file changes, but works best when the line keeps its content. The assistant can read and manage all line comments.</small>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal" data-editor-comment-cancel>Cancel</button>
            <button type="button" class="btn btn-primary" data-editor-comment-save>Add</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</dc-editor>

{{template "editor_shortcuts_modal.gohtml"}}

{{template "app_end.gohtml" .}}
{{end}}
