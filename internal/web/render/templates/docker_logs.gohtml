{{define "docker_logs.gohtml"}}
{{template "app_start.gohtml" .}}
{{template "work_start.gohtml" .}}
<a href="{{.Back}}" class="btn btn-icon btn-ghost-secondary" aria-label="Back to the editor" title="Back to the editor"><i class="ti ti-arrow-left" aria-hidden="true"></i></a>
<h1 class="dc-work-title dc-mono">{{.Container}}</h1>
<span class="text-secondary small dc-trunc dc-hide-xs flex-shrink-0">{{.Project}}</span>
{{template "work_body.gohtml" .}}
<dc-docker-run class="d-block" output-url="{{.OutputURL}}"{{if .Running}} follow{{end}}>
  <div class="card">
    <div class="card-body">
      <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
        <span class="badge{{if .Running}} bg-blue-lt{{else}} bg-secondary-lt{{end}}" data-run-status>{{.Status}}</span>
        <span class="text-secondary small">Logs, the last {{.Tail}} lines</span>
      </div>
      <pre class="mb-0 overflow-auto dc-run-output" data-run-output data-docker-logs>{{.Output}}</pre>
    </div>
  </div>
</dc-docker-run>
{{template "app_end.gohtml" .}}
{{end}}
