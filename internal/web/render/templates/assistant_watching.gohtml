{{/* The aside is one thing with three tabs, and this file holds what says so:
     the button that opens it and the strip that picks the tab. The coders and
     the triggers are the assistant carrying on by itself, without anybody
     asking again, which is why the aside is called Watching: a steered coder
     is watched while it works, a trigger is waited for until it fires. The
     projects are where those coders work, so they stand first.

     They are tabs and not sections under each other, because under each other
     the second one is below the fold on every screen small enough to matter,
     and a section nobody scrolls to is a section nobody uses. Side by side
     each is one click away and each starts at the top.

     A count is the one number that still moves: projects that need the user on
     the first tab, open jobs on the second, triggers that still fire on the
     third, and open jobs and triggers together on the button, because a phone
     sees nothing of the aside but that button. All of them are the one badge
     the cockpit paints a count with, `.dc-steer-badge`, out of the flow, so a
     number that comes and goes moves nothing and the row stands still while
     jobs open and close. Only where it hangs differs: the corner of the
     button's glyph, and on a tab the end of the label, which is the anchor
     because it is the one thing that ends where the word ends. There it stands
     raised, its bottom edge on the word's middle line, so it covers the upper
     half of the ink the way a corner badge covers the top of its glyph, and
     reads as a note at the word instead of a second word beside it. Raised it
     still ends inside the tab's own padding, so it leaves the row's height and
     the scroller's edge alone. The tab itself is none: it is a third of the
     aside wide with its label centered, so every corner of it stands a
     different distance from each word and would land on a seam between the
     tabs. A count still hides at zero, which spares an empty circle and moves
     nothing either way.

     Nothing else stands in this row. What makes a trigger belongs to the
     triggers, so it stands at the head of that tab and is gone with it, which
     is what a control beside the tabs could never say.

     The tabs are Bootstrap's own `nav-justified`, `flex-basis: 0` plus
     `flex-grow: 1` on every link, so they are equal by the row's width and
     never by their text; `nav-fill` divides what the text leaves and would
     hand the longest name the largest share, which is the crooked strip this
     replaces. Equal thirds hold while the longest name fits into one; on a
     phone that is the word alone, so the icons step aside below `sm`. They carry `justify-content-center` because Tabler makes a
     `.nav-link` a flex box, so `nav-justified`'s own `text-align` reaches
     nothing, and it is the class Tabler itself puts on a filled nav. There is
     no gap between them: `nav-bordered` takes the horizontal padding off a
     link, so the active tab's 2px border runs to its edges and says where the
     tab ends, and a gap would only notch that line. */}}
{{define "assistant_watching_button.gohtml"}}
<button type="button" class="btn btn-icon btn-ghost-secondary flex-shrink-0 position-relative{{if not .InTab}} d-xl-none{{end}}"{{if .InTab}} aria-haspopup="dialog"{{else}} data-bs-toggle="offcanvas" data-bs-target="#{{.DOMID}}-aside"{{end}}
        aria-label="Watching" title="Watching" data-assistant-watching-button>
  <i class="ti ti-eye" aria-hidden="true"></i>
  <dc-steer-badge class="dc-steer-badge{{if not .WatchingOpen}} d-none{{end}}" count="jobs triggers" scope="{{.DOMID}}-aside" aria-hidden="true">{{.WatchingOpen}}</dc-steer-badge>
</button>
{{end}}

{{define "assistant_watching_tabs.gohtml"}}
<div class="nav nav-bordered nav-justified mb-2" role="tablist">
  <button type="button" class="nav-link justify-content-center active" id="{{.DOMID}}-projects-tab" data-bs-toggle="tab" data-bs-target="#{{.DOMID}}-projects"
          role="tab" aria-controls="{{.DOMID}}-projects" aria-selected="true" data-assistant-projects-tab>
    <i class="ti ti-folders me-1 d-none d-sm-inline-block" aria-hidden="true"></i><span class="position-relative" data-assistant-tab-label>Projects<dc-steer-badge class="dc-steer-badge{{if not .Projects.Needs}} d-none{{end}}" count="projects" aria-hidden="true">{{.Projects.Needs}}</dc-steer-badge></span>
  </button>
  <button type="button" class="nav-link justify-content-center" id="{{.DOMID}}-coders-tab" data-bs-toggle="tab" data-bs-target="#{{.DOMID}}-coders"
          role="tab" aria-controls="{{.DOMID}}-coders" aria-selected="false" data-assistant-coders-tab>
    <i class="ti ti-steering-wheel me-1 d-none d-sm-inline-block" aria-hidden="true"></i><span class="position-relative" data-assistant-tab-label>Coders<dc-steer-badge class="dc-steer-badge{{if not .JobsOpen}} d-none{{end}}" count="jobs" aria-hidden="true">{{.JobsOpen}}</dc-steer-badge></span>
  </button>
  <button type="button" class="nav-link justify-content-center" id="{{.DOMID}}-triggers-tab" data-bs-toggle="tab" data-bs-target="#{{.DOMID}}-triggers"
          role="tab" aria-controls="{{.DOMID}}-triggers" aria-selected="false" data-assistant-triggers-tab>
    <i class="ti ti-bolt me-1 d-none d-sm-inline-block" aria-hidden="true"></i><span class="position-relative" data-assistant-tab-label>Triggers<dc-steer-badge class="dc-steer-badge{{if not .Triggers.Open}} d-none{{end}}" count="triggers" aria-hidden="true">{{.Triggers.Open}}</dc-steer-badge></span>
  </button>
</div>
{{end}}

{{/* The aside of an assistant's page, the owner's and a guest's of a link.
     A guest reads every tab and makes nothing in them. */}}
{{define "assistant_aside.gohtml"}}
{{/* The aside holds the projects the assistant works in and what it
     carries on by itself: the coders it steers and the triggers it waits
     for. Tabs of equal standing, built alike. Beside the conversation from
     xl up, below xl the sheet the head's eye opens. The memory sheet is the
     layout's, opened from the list column's head. */}}
<aside class="{{if not .InTab}}offcanvas-xl offcanvas-end {{end}}dc-assistant-aside" tabindex="-1" id="{{.DOMID}}-aside" aria-label="Watching" data-assistant-aside>
  {{/* The same head the list column and the thread wear, so all three end
       on one line; see the memory sheet in ctx_fragments.gohtml. It is
       the sheet's head alone: from xl up the aside stands beside the
       thread under the page's own head, there is nothing to close and
       the list starts at once. Off by the width (`d-xl-none`, the
       breakpoint of `offcanvas-xl`), never by the offcanvas state, the
       element is the same one in both sizes. */}}
  {{if not .InTab}}<div class="dc-ctx-head d-xl-none">
    <h2 class="dc-ctx-title">Watching</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#{{.DOMID}}-aside" aria-label="Close"></button>
  </div>{{end}}
  {{/* One list per tab, and the strip stands outside the body a list
       swaps, so a refresh leaves the chosen tab and every unfolded row
       exactly as they were. */}}
  <div class="offcanvas-body dc-assistant-aside-body{{if .InTab}} p-3{{end}}">
    {{template "assistant_watching_tabs.gohtml" .}}
    <div class="tab-content">
      {{/* A card opens in place of the cards, in the view under them, so
           the cards keep their place while it stands and Back finds them
           as they were. */}}
      <dc-assistant-list class="tab-pane active dc-assistant-projects" id="{{.DOMID}}-projects" role="tabpanel" aria-labelledby="{{.DOMID}}-projects-tab" list-url="{{.ProjectsListURL}}" watch-url="{{.ProjectsWatchURL}}" view-url="{{.ProjectViewURL}}" diff-url="{{.ProjectDiffURL}}" data-assistant-projects-list>
        {{template "assistant_projects_list.gohtml" .Projects}}
        <div hidden data-assistant-project-view></div>
      </dc-assistant-list>
      <dc-assistant-list class="tab-pane" id="{{.DOMID}}-coders" role="tabpanel" aria-labelledby="{{.DOMID}}-coders-tab" list-url="{{.JobsListURL}}" follow="terminals" data-assistant-jobs-list>
        {{template "assistant_jobs_list.gohtml" .}}
      </dc-assistant-list>
      <dc-assistant-list class="tab-pane" id="{{.DOMID}}-triggers" role="tabpanel" aria-labelledby="{{.DOMID}}-triggers-tab" list-url="{{.TriggersListURL}}" data-assistant-triggers-list>
        {{/* What makes a trigger stands at the head of the triggers, the
             plus with the word beside it. It is the tab pane's own child,
             so the tab carries it and nothing switches a visibility by
             hand, and it stands outside the body the list swaps, so an
             event of the assistant leaves it where it is. The empty state
             below says what a trigger is for and offers nothing, because
             this button is already the line above it.

             It runs the full width and carries no colour of its own: a
             coloured block beside nothing reads as a thing dropped in,
             while the full width closes the strip off above the list. Its
             weight is the aside's own, `btn btn-sm`, what a trigger row's
             Open coder and Change wear one level down, and colour is left
             to the one action that destroys something. */}}
        {{if not .Access.Guest}}<a href="{{.TriggersNewURL}}" class="btn btn-sm w-100 mb-2" data-assistant-trigger-new>
          <i class="ti ti-plus me-1" aria-hidden="true"></i>New trigger
        </a>{{end}}
        {{template "assistant_triggers_list.gohtml" .Triggers}}
      </dc-assistant-list>
    </div>
  </div>
  {{if not .InTab}}<div class="dc-ctx-resize d-none d-xl-block" data-ctx-resize="aside" aria-hidden="true"></div>{{end}}
</aside>
{{end}}
