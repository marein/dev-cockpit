{{define "docs_keys"}}{{range $ai, $alt := .}}{{if $ai}}<span class="text-secondary small mx-1">or</span>{{end}}<span class="text-nowrap">{{range $i, $cap := $alt.Parts}}{{if $i}}<span class="text-secondary small mx-1">+</span>{{end}}<kbd>{{if $cap.Icon}}<i class="ti {{$cap.Icon}} align-text-bottom" aria-hidden="true"></i><span class="visually-hidden">{{$cap.Text}}</span>{{else}}{{$cap.Text}}{{end}}</kbd>{{end}}</span>{{end}}{{end}}

{{define "docs_marks"}}{{if .HasKeys}}{{template "docs_keys" .Keys}}{{end}}{{if .Tag}}<span class="badge {{.TagClass}}">{{.Tag}}</span>{{end}}{{end}}

{{define "docs.gohtml"}}
{{template "app_start.gohtml" .}}
{{template "docs_ctx.gohtml" .}}
{{template "work_start.gohtml" .}}
<h1 class="dc-work-title">Documentation</h1>
{{template "work_body.gohtml" .}}
<div class="dc-narrow">
  <p class="text-secondary mb-4">{{.Lead}}</p>
  {{range $topic := .Topics}}
  <section class="dc-docs-topic" id="{{$topic.Key}}">
    <h2 class="h3 d-flex align-items-center gap-2 mb-1"><i class="ti {{$topic.Icon}} text-primary" aria-hidden="true"></i><span>{{$topic.Title}}</span><span class="badge bg-secondary-lt ms-auto">{{$topic.Count}}</span></h2>
    <div class="text-secondary small mb-3">{{$topic.Lead}}</div>
    {{if $topic.Intro}}<p class="text-secondary">{{$topic.Intro}}</p>{{end}}
    {{if $topic.LinkURL}}<a class="btn btn-sm btn-outline-primary mb-3" href="{{$topic.LinkURL}}">{{$topic.LinkText}}</a>{{end}}
    <div class="card">
      <div class="list-group list-group-flush">
        {{range $topic.Items}}
        <div class="list-group-item">
          <div class="dc-docs-item-head">
            <span class="fw-medium">{{.Title}}</span>
            {{if or .HasKeys .Tag}}<span class="d-flex align-items-center gap-2 flex-wrap">{{template "docs_marks" .}}</span>{{end}}
          </div>
          <div class="text-secondary small mt-1">{{.Desc}}</div>
        </div>
        {{end}}
      </div>
    </div>
  </section>
  {{end}}
</div>
{{template "app_end.gohtml" .}}
{{end}}
