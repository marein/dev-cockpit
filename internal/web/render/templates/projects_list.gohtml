{{define "projects_list.gohtml"}}
{{template "app_start.gohtml" .}}
{{template "projects_ctx.gohtml" .}}
<dc-project-list class="dc-work" role="main">
  <div class="dc-work-head">
{{if .Projects}}
    <div class="dc-filter">
      <i class="ti ti-search" aria-hidden="true"></i>
      <input type="text" class="dc-filter-input" data-project-filter placeholder="Filter projects…" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true" aria-label="Filter projects">
      <span class="dc-filter-side">
        <button type="button" class="dc-filter-clear d-none" data-project-filter-clear aria-label="Clear filter" title="Clear filter"><i class="ti ti-x" aria-hidden="true"></i></button>
      </span>
    </div>
    <div class="dropdown flex-shrink-0">
      <button type="button" class="btn btn-sm btn-ghost-secondary" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false" aria-label="Sort projects" title="Sort projects" data-project-sort-toggle>
        <i class="ti ti-arrows-sort" aria-hidden="true"></i><span class="dc-hide-xs ms-1" data-project-sort-current>Name</span>
      </button>
      <div class="dropdown-menu dropdown-menu-end">
        <button type="button" class="dropdown-item" data-project-sort-option="alpha">
          <i class="ti ti-sort-ascending-letters me-2"></i>Name
        </button>
        <button type="button" class="dropdown-item" data-project-sort-option="active">
          <i class="ti ti-activity me-2"></i>Active
        </button>
        <button type="button" class="dropdown-item" data-project-sort-option="recent">
          <i class="ti ti-history me-2"></i>Recent
        </button>
        <div class="dropdown-divider"></div>
        <div class="dropdown-item-text text-secondary small">Applies to project listings across the app.</div>
      </div>
    </div>
{{else}}
    <h1 class="dc-work-title flex-fill">Projects</h1>
{{end}}
    {{pluginSlot "projects-actions"}}
    {{template "shell_head_tools.gohtml" .}}
  </div>
  <div class="dc-work-body dc-work-pad">
    {{template "flash.gohtml" .}}
{{if .Projects}}
<div class="dc-board projects-card">
  <div class="list-group">
  {{range .Rows}}
  <div class="card list-group-item project-row{{if .Grouped}} project-row-worktree{{end}}" id="project-{{.Name}}" data-project-name="{{.Name}}"{{if .GitWorktreeOf}} data-project-worktree-of="{{.GitWorktreeOf}}"{{end}}{{if .Grouped}} data-project-grouped hidden{{end}}{{if .Worktrees}} data-project-worktrees="{{len .Worktrees}}"{{end}} data-project-active="{{if .Active}}true{{else}}false{{end}}" data-project-used="{{.LastUsedUnix}}">
    {{$delete := index $.Deleting .Name}}
    {{if $delete.Failed}}
    {{template "notice.gohtml" (dict "Level" "error" "Message" $delete.Failed "Dismiss" false)}}
    {{end}}
    {{if and (eq $.FlashProject .Name) $.Flash.Message}}
    {{template "notice.gohtml" (dict "Level" $.Flash.Level "Message" $.Flash.Message "Dismiss" true)}}
    {{end}}
    <div class="d-flex align-items-start gap-2">
      <div class="flex-fill min-w-0 d-flex align-items-baseline flex-wrap column-gap-3 row-gap-1" data-project-meta>
        <span class="dc-project-name text-break">{{if .Grouped}}<i class="ti ti-git-fork icon icon-sm text-secondary" aria-hidden="true"></i>{{end}}{{.Name}} {{template "news_dot.gohtml" (dict "Class" "ms-1" "Hidden" (not .HasNews) "Scope" true "Label" "Something new in this project")}}</span>
        {{if .Worktrees}}
        <button type="button" class="project-chip project-chip-more project-worktrees-toggle" data-worktrees-toggle="{{.WorktreeCount}}"{{if .WorktreeActive}} data-worktrees-active{{end}} aria-expanded="false" aria-controls="{{.WorktreeIDs}}" aria-label="Show its {{.WorktreeCount}}" title="Show its {{.WorktreeCount}}"><i class="ti ti-git-fork" aria-hidden="true"></i>{{len .Worktrees}}<i class="ti ti-chevron-right" aria-hidden="true"></i>{{template "news_dot.gohtml" (dict "Hidden" (not .WorktreeNews) "Scope" true "Projects" .WorktreeIDs "Label" "Something new in a worktree")}}</button>
        {{end}}
        {{if and .GitRepo .GitBranch}}
        <span class="text-secondary small text-break"><i class="ti ti-git-branch icon icon-xs" aria-hidden="true"></i> {{.GitBranch}}</span>
        {{end}}
        {{if .GitWorktree}}
        <span class="text-secondary small text-break" data-project-worktree title="Worktree of {{if .GitWorktreeOf}}{{.GitWorktreeOf}}{{else}}{{.GitWorktreeMain}}{{end}}"><i class="ti ti-git-fork icon icon-xs" aria-hidden="true"></i> {{if .GitWorktreeOf}}<a href="/projects#project-{{.GitWorktreeOf}}" class="link-secondary">{{.GitWorktreeOf}}</a>{{else}}{{.GitWorktreeMain}}{{end}}</span>
        {{else if .GitOrigin}}
        {{if .GitOriginURL}}
        <a href="{{.GitOriginURL}}" target="_blank" rel="noopener" class="link-secondary small text-decoration-none text-break"><i class="ti {{originIcon .GitOrigin}} icon icon-xs" aria-hidden="true"></i> {{.GitOrigin}}</a>
        {{else}}
        <span class="text-secondary small text-break"><i class="ti {{originIcon .GitOrigin}} icon icon-xs" aria-hidden="true"></i> {{.GitOrigin}}</span>
        {{end}}
        {{else if ne .Label .Name}}
        <span class="text-secondary small text-break">{{.Label}}</span>
        {{end}}
      </div>
      <div class="btn-list flex-nowrap flex-shrink-0">
        {{$projectName := .Name}}
        {{if $delete.Running}}
        <span class="text-secondary small d-inline-flex align-items-center gap-2" role="status" data-project-deleting>
          <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>Deleting…
        </span>
        {{else}}
        {{with index $.Docker .Name}}{{if .Stacks}}
        <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary" data-docker-project-menu data-docker-project="{{$projectName}}" aria-label="Compose actions for project {{$projectName}}" title="Compose">
          <span class="dc-term-icon{{if .AnyRunning}} running{{end}}{{if .Working}} dc-docker-working{{end}}" aria-hidden="true"><i class="ti ti-brand-docker"></i></span>
          {{range .Stacks}}<span hidden data-docker-stack data-stack-label="{{.Label}}" data-stack-running="{{.Running}}" data-stack-total="{{.Total}}"{{if .Busy}} data-stack-busy="1"{{end}}{{if .RunID}} data-stack-run="{{.RunID}}" data-stack-run-action="{{.RunAction}}"{{if .RunGoing}} data-stack-run-going="1"{{end}}{{end}}></span>{{end}}
          {{range $.DockerActions}}<span hidden data-docker-action data-action-id="{{.ID}}" data-action-icon="{{.Icon}}" data-action-label="{{.Label}}" data-action-command="{{.Command}}"{{if .Confirm}} data-action-confirm="1"{{end}}></span>{{end}}
        </button>
        {{end}}{{end}}
        {{if .GitRepo}}
        {{$editorURL := print "/projects/" .Name "/editor"}}
        <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary" data-git-project-menu data-git-project="{{$projectName}}"{{if not .GitWorktree}} data-git-worktree="/projects/new?create={{urlquery (worktreeChoice .Name)}}"{{end}} data-git-fetch="/projects/{{.Name}}/fetch" data-git-commit="{{$editorURL}}?view=commit" data-git-compare="{{$editorURL}}?view=compare" aria-label="Git actions for project {{$projectName}}" title="Git">
          <i class="ti ti-brand-git icon"></i>
        </button>
        {{end}}
        <a href="/projects/{{.Name}}/editor" class="btn btn-sm btn-icon btn-ghost-secondary" aria-label="Open editor for project {{.Name}}" title="Editor">
          <i class="ti ti-code icon"></i>
        </a>
        {{$wtNote := deleteWorktreeNote .Project}}{{$dockerNote := ""}}{{with index $.Docker .Name}}{{if .Containers}}{{$dockerNote = "Its directory goes, and its containers are brought down with compose first, volumes included."}}{{end}}{{end}}
        <form method="post" action="/projects/delete" data-project-delete data-ajax-refresh data-confirm="Delete project &quot;{{.Name}}&quot;?"{{if or $dockerNote $wtNote}} data-confirm-text="{{$dockerNote}}{{if and $dockerNote $wtNote}} {{end}}{{$wtNote}}"{{end}} data-confirm-button="Delete">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <input type="hidden" name="project" value="{{.Name}}">
          <button type="submit" class="btn btn-sm btn-icon btn-ghost-secondary tone-danger" aria-label="Delete project {{.Name}}" title="Delete">
            <i class="ti ti-trash icon"></i>
          </button>
        </form>
        {{end}}
      </div>
    </div>
    <div data-sessions-body>
      <div class="project-chips mt-2">
      <span class="project-chip-fold" data-chip-fold="terminals">
        {{range .ActiveRefs}}
        {{if eq .Kind "coder"}}
        <div class="project-chip" data-chip data-chip-kind="coder" data-chip-id="{{.ID}}" data-chip-name="{{.Name}}"
             {{- if index $.Steered .ID}} data-chip-steered="1"{{end}}{{with index $.SteerPrefill .ID}} data-chip-steer-prefill="{{.}}"{{end}}>
          <a href="/coders/{{.ID}}" class="project-chip-main" title="Attach to coder {{.Name}}" data-chip-main>
            <span class="dc-term-icon running{{if index $.Working .ID}} working{{end}}{{if .HasNews}} news{{end}}{{if index $.Steered .ID}} steered{{end}}" data-notify-target="{{.ID}}" title="{{coderLabel .Coder}}" aria-label="{{coderLabel .Coder}}">{{template "coder_icon.gohtml" .Coder}}{{template "news_dot.gohtml"}}</span>
            <span class="project-chip-name">{{.Name}}</span>
          </a>
          <form method="post" action="/coders/{{.ID}}/stop" data-confirm="Stop coder &quot;{{.Name}}&quot;?" data-confirm-button="Stop" data-ajax-refresh data-chip-x>
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <button type="submit" class="project-chip-x" aria-label="Stop coder {{.Name}}" title="Stop"><i class="ti ti-player-stop"></i></button>
          </form>
        </div>
        {{else}}
        <div class="project-chip" data-chip data-chip-kind="shell" data-chip-id="{{.ID}}" data-chip-name="{{.Name}}">
          <a href="/shells/{{.ID}}" class="project-chip-main" title="Attach to shell {{.Name}}" data-chip-main>
            <span class="dc-term-icon running{{if .HasNews}} news{{end}}" data-notify-target="{{.ID}}" aria-hidden="true"><i class="ti ti-terminal-2"></i>{{template "news_dot.gohtml"}}</span>
            <span class="project-chip-name">{{.Name}}</span>
          </a>
          <form method="post" action="/shells/{{.ID}}/delete" data-confirm="Delete shell &quot;{{.Name}}&quot;?" data-confirm-button="Delete" data-ajax-refresh data-chip-x>
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <button type="submit" class="project-chip-x" aria-label="Delete shell {{.Name}}" title="Delete"><i class="ti ti-trash"></i></button>
          </form>
        </div>
        {{end}}
        {{end}}
        {{range .InactiveCoderRefs}}
        <div class="project-chip is-idle" data-chip data-chip-kind="coder">
          <form method="post" action="/coders/{{.ID}}/resume" data-chip-main-form>
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <button type="submit" class="project-chip-main" title="Resume coder {{.Name}}">
              <span class="dc-term-icon{{if .HasNews}} news{{end}}" data-notify-target="{{.ID}}" title="{{coderLabel .Coder}}" aria-label="{{coderLabel .Coder}}">{{template "coder_icon.gohtml" .Coder}}{{template "news_dot.gohtml"}}</span>
              <span class="project-chip-name">{{.Name}}</span>
            </button>
          </form>
          <form method="post" action="/coders/{{.ID}}/delete" data-confirm="Delete inactive coder &quot;{{.Name}}&quot;?" data-confirm-button="Delete" data-ajax-refresh data-chip-x>
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <button type="submit" class="project-chip-x" aria-label="Delete coder {{.Name}}" title="Delete"><i class="ti ti-trash"></i></button>
          </form>
        </div>
        {{end}}
      </span>
      {{if not $delete.Running}}
      <a href="/coders/new?project={{urlquery .Name}}&amp;return={{urlquery (printf "/projects#project-%s" .Name)}}" class="project-chip project-chip-new" title="Start coder in project {{.Name}}" aria-label="Start coder in project {{.Name}}">
        <i class="ti ti-robot" aria-hidden="true"></i><i class="ti ti-plus" aria-hidden="true"></i>
      </a>
      <form method="post" action="/shells/new" class="project-chip-form">
        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
        <input type="hidden" name="project" value="{{.Path}}">
        <button type="submit" class="project-chip project-chip-new" title="Start shell in project {{.Name}}" aria-label="Start shell in project {{.Name}}">
          <i class="ti ti-terminal-2" aria-hidden="true"></i><i class="ti ti-plus" aria-hidden="true"></i>
        </button>
      </form>
      {{end}}
      </div>
      {{with index $.Docker .Name}}{{if .Containers}}
      <div class="project-chips mt-2">
        <span class="project-chip-fold" data-chip-fold="docker">
          {{range .Containers}}
          <div class="project-chip{{if not .Running}} is-idle{{end}}" data-chip data-chip-kind="docker" data-chip-id="{{.ID}}" data-chip-name="{{.DisplayName}}"
               data-docker-running="{{if .Running}}1{{end}}" data-docker-ports="{{.PortsLabel}}">
            <button type="button" class="project-chip-main" data-chip-main-menu title="{{if .Running}}Shell in {{.Name}}{{else}}{{.Name}}{{end}}">
              <span class="dc-term-icon{{if .Running}} running{{end}}{{if .Unwell}} text-danger{{end}}" aria-hidden="true"><i class="ti ti-brand-docker"></i></span>
              <span class="project-chip-name">{{.DisplayName}}</span>
            </button>
            <button type="button" class="project-chip-x" data-docker-logs aria-label="Logs of {{.DisplayName}}" title="Logs"><i class="ti ti-file-text"></i></button>
            {{/* One hidden span per address the container answers on, the way the compose button carries its stacks: a route names a host of its own and maybe a path, a published port names only the port. An empty scheme is the page's own. */}}
            {{range .Links}}<span hidden data-docker-link data-link-scheme="{{.Scheme}}" data-link-host="{{.Host}}" data-link-port="{{if .Port}}{{.Port}}{{end}}" data-link-path="{{.Path}}"></span>{{end}}
          </div>
          {{end}}
        </span>
      </div>
      {{end}}{{end}}
    </div>
  </div>
  {{end}}
  </div>
</div>
<div class="dc-empty d-none" data-project-filter-empty>
  <i class="ti ti-search" aria-hidden="true"></i>
  <div class="dc-empty-title">No projects match.</div>
</div>
{{else}}
<div class="dc-empty">
  <i class="ti ti-folder" aria-hidden="true"></i>
  <div class="dc-empty-title">No projects yet</div>
  <div class="mb-3">Create one, or point the cockpit at a directory that holds some.</div>
  <div class="btn-list justify-content-center">
    <a href="/projects/new" class="btn btn-primary"><i class="ti ti-plus me-1"></i> Create project</a>{{with pluginSlot "projects-empty-actions"}}
    {{.}}{{end}}
  </div>
</div>
{{end}}
  </div>
</dc-project-list>
{{template "app_close.gohtml" .}}
{{end}}
