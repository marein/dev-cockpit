{{define "coder_files_modal.gohtml"}}
<div class="modal-content">
  <div class="modal-header">
    <h3 class="modal-title" id="coder-files-modal-title-{{.Identifier}}">Files</h3>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <div class="modal-body">
    <form method="post" action="/coders/{{.Identifier}}/files" enctype="multipart/form-data" class="d-flex flex-wrap align-items-center column-gap-3 row-gap-2" data-coder-file-upload-form data-no-pe>
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="file" name="files" multiple hidden>
      <button type="submit" class="btn btn-primary coder-files-upload">
        <i class="ti ti-upload me-2"></i>Upload files
      </button>
      <div class="text-secondary small">Or drop or paste them here or on the terminal.{{if .MaxUploadSizeMB}} Up to {{.MaxUploadSizeMB}} MiB each.{{end}}</div>
    </form>
    <div class="coder-file-upload-progress mt-3" data-coder-file-upload-progress hidden></div>
    <div class="d-flex mt-3" data-coder-files-batch hidden>
      <button type="button" class="btn btn-outline-primary coder-files-insert-all" data-insert-all-files>
        <i class="ti ti-file-import me-2"></i><span data-coder-files-batch-label></span>
      </button>
    </div>
    <div class="mt-3" data-coder-files-content>
      {{template "coder_files_content.gohtml" .}}
    </div>
  </div>
</div>
{{end}}

{{define "coder_files_content.gohtml"}}
{{if .Error}}
{{template "notice.gohtml" (dict "Level" "error" "Message" .Error "Dismiss" false)}}
{{else if .Message}}
{{template "notice.gohtml" (dict "Level" "success" "Message" .Message "Dismiss" false)}}
{{end}}
{{if .Files}}
<div class="card">
  <div class="list-group list-group-flush list-group-hoverable">
    {{range .Files}}
    <div class="list-group-item coder-file-row" data-coder-file="{{.Name}}">
      <div class="coder-file-name fw-medium text-break">{{.Name}}</div>
      <div class="coder-file-meta text-secondary small"><span>{{.SizeText}}</span><span class="d-none d-sm-inline"> · </span><dc-time datetime="{{.ModTime}}" relative></dc-time></div>
      <div class="coder-file-actions btn-list flex-nowrap">
        <button type="button" class="btn btn-sm btn-icon btn-outline-primary" data-insert-file-path="{{shellWord .Path}}" aria-label="Insert into the prompt" title="Insert into the prompt">
          <i class="ti ti-file-import"></i>
        </button>
        <button type="button" class="btn btn-sm btn-icon btn-outline-secondary" data-copy-file-path="{{.Path}}" aria-label="Copy path" title="Copy path">
          <i class="ti ti-copy"></i>
        </button>
        <a class="btn btn-sm btn-icon btn-outline-secondary" href="/coders/{{$.Identifier}}/files/download?name={{urlquery .Name}}" data-no-pe aria-label="Download" title="Download">
          <i class="ti ti-download"></i>
        </a>
        <form method="post" action="/coders/{{$.Identifier}}/files/delete" data-coder-file-delete data-terminal-confirm="Delete file &quot;{{.Name}}&quot;?" data-no-pe>
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <input type="hidden" name="name" value="{{.Name}}">
          <button type="submit" class="btn btn-sm btn-icon btn-outline-danger" aria-label="Delete" title="Delete">
            <i class="ti ti-trash"></i>
          </button>
        </form>
      </div>
    </div>
    {{end}}
  </div>
</div>
{{else}}
<div class="card">
  <div class="card-body text-secondary">No files yet.</div>
</div>
{{end}}
{{end}}
