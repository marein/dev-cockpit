{{define "split_attach.gohtml"}}
{{template "app_start.gohtml" .}}
{{template "terminals_ctx.gohtml" .}}
{{template "work_start.gohtml" .}}
{{range .Members}}
{{if .Coder}}<span class="dc-term-icon running d-lg-none{{if index $.Working .ID}} working{{end}}{{if index $.Steered .ID}} steered{{end}}" data-terminal-badge="{{.ID}}" data-notify-target="{{.ID}}"{{if ne .ID $.Focus}} hidden{{end}} title="{{coderLabel .Coder}}" aria-label="{{coderLabel .Coder}}">{{template "coder_icon.gohtml" .Coder}}{{template "news_dot.gohtml"}}</span>{{else}}<span class="dc-term-icon running d-lg-none" data-terminal-badge="{{.ID}}" data-notify-target="{{.ID}}"{{if ne .ID $.Focus}} hidden{{end}} title="Shell" aria-label="Shell"><i class="ti ti-terminal-2" aria-hidden="true"></i>{{template "news_dot.gohtml"}}</span>{{end}}
{{end}}
<div class="d-flex align-items-center gap-2 min-w-0 dc-fine-only">
  <h1 class="dc-work-title dc-mono" data-split-title data-title-suffix="{{if .ProjectName}} - {{.ProjectName}}{{end}} - Dev Cockpit">{{.GroupName}}</h1>
  {{if .ProjectName}}<a class="text-secondary small dc-trunc dc-hide-xs text-decoration-none flex-shrink-0" href="/projects#project-{{.ProjectName}}" title="Back to {{.ProjectName}}">{{.ProjectName}}</a>{{end}}
</div>
{{range .Members}}{{if eq .ID $.Focus}}
<div class="d-flex align-items-center gap-2 min-w-0 dc-coarse-only">
  {{if eq .Kind "shell"}}
  <dc-inline-rename class="d-flex min-w-0" rename-url="/shells/{{.ID}}/rename" name-url="/shells/{{.ID}}/name">
    <h1 class="dc-work-title dc-mono" data-rename-label role="button" tabindex="0" title="Click to rename">{{.Name}}</h1>
    <input type="text" class="form-control form-control-sm d-none" data-rename-input maxlength="120" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" aria-label="Shell name" value="{{.Name}}">
  </dc-inline-rename>
  {{else}}
  <h1 class="dc-work-title dc-mono" data-pane-title="{{.ID}}">{{.Name}}</h1>
  {{end}}
  {{if .Project}}<a class="text-secondary small dc-trunc dc-hide-xs text-decoration-none flex-shrink-0" href="/projects#project-{{.Project}}" title="Back to {{.Project}}">{{.Project}}</a>{{end}}
</div>
{{end}}{{end}}
<span class="flex-fill"></span>
<div class="attach-settings dropdown">
  <button type="button" class="btn btn-icon btn-ghost-secondary" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Terminal settings" title="Terminal settings">
    <i class="ti ti-settings"></i>
  </button>
  <div class="dropdown-menu dropdown-menu-end terminal-settings-menu">
    {{template "terminal_settings.gohtml"}}
  </div>
</div>
{{template "work_body_fill.gohtml" .}}
<div class="attach-page min-w-0">
  <div class="attach-frame min-w-0 w-100">
    <terminal-split class="attach-split min-w-0 w-100" style="--dc-split-cols: {{.Cols}}; --dc-split-rows: {{.Rows}};">
      {{range .Members}}
      <div class="attach-split-pane min-w-0" data-pane-id="{{.ID}}" data-pane-kind="{{.Kind}}" data-pane-name="{{.Name}}" data-pane-project="{{.Project}}" data-pane-col="{{.Col}}" style="order: {{.Order}}; grid-column: {{.Col}}; grid-row: {{.Row}} / span {{.RowSpan}};"{{if .Coder}}{{with index $.SteerPrefill .ID}} data-pane-steer-prefill="{{.}}"{{end}}{{end}}>
        <div class="attach-split-head" data-pane-head title="Drag to reorder, right click for actions">
          {{if .Coder}}<dc-steered-mark class="d-inline-flex" src="/coders/{{.ID}}/steered">
            {{- template "steered_icon.gohtml" (dict "ID" .ID "Coder" .Coder "Steered" (index $.Steered .ID) "Working" (index $.Working .ID)) -}}
          </dc-steered-mark>{{else}}<span class="dc-term-icon running" data-notify-target="{{.ID}}" aria-hidden="true"><i class="ti ti-terminal-2"></i>{{template "news_dot.gohtml"}}</span>{{end}}
          <span class="attach-split-text">
            <span class="attach-split-name text-truncate" data-pane-label>{{.Name}}</span>
            {{if .Project}}<span class="attach-split-project text-truncate">{{.Project}}</span>{{end}}
          </span>
          <button type="button" class="attach-split-remove ms-auto" data-pane-close aria-label="{{if .Coder}}Stop coder{{else}}Delete shell{{end}} {{.Name}}" title="{{if .Coder}}Stop coder{{else}}Delete shell{{end}}">
            <i class="ti ti-x" aria-hidden="true"></i>
          </button>
        </div>
        <terminal-attach class="attach-terminal min-w-0 w-100 position-relative" terminal-id="{{.ID}}" split-group="{{$.GroupID}}"{{if eq .ID $.Focus}} active{{if $.FocusExplicit}} split-focused{{end}}{{end}}
                        stream-url="{{.StreamURL}}" resize-url="{{.ResizeURL}}"{{if .ScrollHistory}} scroll-history{{end}}>
          <terminal-scroll-zone active aria-hidden="false"></terminal-scroll-zone>
        </terminal-attach>
        <terminal-input terminal-id="{{.ID}}" input-url="{{.InputURL}}"{{if .ScrollHistory}} scroll-history{{end}}></terminal-input>
      </div>
      {{end}}
    </terminal-split>
    <terminal-swipe-nav aria-hidden="true"></terminal-swipe-nav>
  </div>

  {{range $m := .Members}}
  <div class="attach-footer min-w-0" data-terminal-footer="{{$m.ID}}"{{if ne $m.ID $.Focus}} hidden{{end}}>
    {{if $m.Coder}}{{template "terminal_footer_coder.gohtml" printf "#coder-files-modal-%s" $m.ID}}{{else}}{{template "terminal_footer_shell.gohtml"}}{{end}}
  </div>
  {{end}}
</div>

{{template "terminal_shortcuts_modal.gohtml"}}

{{range .Members}}{{if .FilesData}}
<div class="modal modal-blur fade" id="coder-files-modal-{{.ID}}" tabindex="-1" aria-labelledby="coder-files-modal-title-{{.ID}}" aria-hidden="true" data-coder-files-modal>
  <div class="modal-dialog modal-lg modal-dialog-centered">
    {{template "coder_files_modal.gohtml" .FilesData}}
  </div>
</div>
{{end}}{{end}}

{{template "app_end.gohtml" .}}
{{end}}
