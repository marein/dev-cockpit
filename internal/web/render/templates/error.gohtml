{{define "error.gohtml"}}{{template "html_head.gohtml" .}}
<body class="dc-body">
  <div data-page-content>
  <main class="dc-login">
    <div class="dc-login-box text-center">
      <div class="dc-login-brand"><span class="dc-rail-mark m-0"><i class="ti ti-dashboard" aria-hidden="true"></i></span><span>Dev Cockpit</span></div>
      <div class="dc-error-code mb-3">{{.Status}}</div>
      <h1 class="h2 mb-2">{{.Heading}}</h1>
      <p class="text-secondary mb-4">{{.Message}}</p>
      <a href="/" class="btn btn-primary">
        <i class="ti ti-arrow-left me-2" aria-hidden="true"></i>Back to home
      </a>
    </div>
  </main>
  </div>
</body>
</html>{{end}}
