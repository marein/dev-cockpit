{{define "theme_switch.gohtml"}}
<dc-theme-switch class="dc-theme-switch" data-boot aria-label="Color theme">
  <button type="button" class="dc-theme-switch-btn" data-theme-option="light" aria-pressed="false" title="Light theme" aria-label="Light theme"><i class="ti ti-sun" aria-hidden="true"></i></button>
  <button type="button" class="dc-theme-switch-btn" data-theme-option="auto" aria-pressed="false" title="Follow the OS theme" aria-label="Follow the OS theme"><i class="ti ti-contrast" aria-hidden="true"></i></button>
  <button type="button" class="dc-theme-switch-btn" data-theme-option="dark" aria-pressed="false" title="Dark theme" aria-label="Dark theme"><i class="ti ti-moon" aria-hidden="true"></i></button>
</dc-theme-switch>
{{end}}
