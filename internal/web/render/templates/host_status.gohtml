{{define "host_status.gohtml"}}
<dc-host-status class="dropdown"{{if not .Host.Any}} hidden{{end}}>
  <button type="button" class="btn btn-icon btn-ghost-secondary" data-bs-toggle="dropdown" data-host-toggle aria-label="Server status" title="Server status">
    <i class="ti ti-server fs-2 js-host-icon {{hostLevelClass .Host.Level}}"></i>
  </button>
  <div class="dropdown-menu dropdown-menu-end shadow p-3">
    {{/* The button already carries the server icon, the panel only needs the word. */}}
    <div class="d-flex align-items-center mb-3">
      <span class="fw-bold">Server</span>
      <button type="button" class="btn btn-sm btn-ghost-secondary ms-auto" data-host-float-open title="Keep the values floating over the page">
        <i class="ti ti-app-window me-1"></i>Float
      </button>
    </div>
    <div class="d-grid gap-3">
      {{template "host_status_row.gohtml" (dict "key" "cpu" "title" "CPU" "has" .Host.HasCPU "percent" .Host.CPUPercent "label" .Host.CPULabel)}}
      {{template "host_status_row.gohtml" (dict "key" "mem" "title" "RAM" "has" .Host.HasMem "percent" .Host.MemPercent "label" .Host.MemLabel)}}
      {{template "host_status_row.gohtml" (dict "key" "disk" "title" "Disk" "has" .Host.HasDisk "percent" .Host.DiskPercent "label" .Host.DiskLabel)}}
    </div>
  </div>
</dc-host-status>
{{end}}

{{define "host_status_row.gohtml"}}
<div data-host-row="{{.key}}"{{if not .has}} hidden{{end}}>
  <div class="d-flex align-items-baseline gap-3">
    <span class="text-secondary">{{.title}}</span>
    <span class="ms-auto fw-medium text-nowrap js-host-value">{{.percent}}%</span>
  </div>
  <div class="progress progress-sm mt-2">
    <div class="progress-bar js-host-bar {{hostBarClass .percent}}" {{hostBarStyle .percent}} role="progressbar" aria-label="{{.title}}" aria-valuenow="{{.percent}}" aria-valuemin="0" aria-valuemax="100"></div>
  </div>
  <div class="text-secondary small mt-1 text-nowrap js-host-label">{{.label}}</div>
</div>
{{end}}

{{define "host_status_float.gohtml"}}
{{/* The detached server status: three ring gauges in one slim row, the value
     inside the ring, the ring colored by the same thresholds as everything
     else, and the plain numbers riding as tooltips. The whole card is the drag
     grip. It stands next to the assistant panel and data-page-content, outside
     the region pe.js swaps, so a boosted navigation never touches it;
     dc-host-status paints the gauges along with the dropdown rows. Position and
     open state live in localStorage (dc-host-float), the element clamps itself
     back into the viewport on restore, drag and window resize. */}}
<dc-host-float class="dc-host-float card shadow" hidden>
  {{/* Layout and spacing live in the stylesheet, not in utilities: below the md
       breakpoint the rings give way to slim bars with the value underneath, and
       Bootstrap's !important paddings could not be tightened by that media
       query. */}}
  <div data-host-float-grip>
    {{template "host_status_gauge.gohtml" (dict "key" "cpu" "title" "CPU" "has" .Host.HasCPU "percent" .Host.CPUPercent "label" .Host.CPULabel)}}
    {{template "host_status_gauge.gohtml" (dict "key" "mem" "title" "RAM" "has" .Host.HasMem "percent" .Host.MemPercent "label" .Host.MemLabel)}}
    {{template "host_status_gauge.gohtml" (dict "key" "disk" "title" "Disk" "has" .Host.HasDisk "percent" .Host.DiskPercent "label" .Host.DiskLabel)}}
    <button type="button" class="btn-close" data-host-float-close aria-label="Close"></button>
  </div>
</dc-host-float>
{{end}}

{{define "host_status_gauge.gohtml"}}
{{/* Two renderings of one metric: the ring for wide screens (pathLength=100
     normalizes the circumference, so the dasharray is the bare percentage,
     capped at a full circle while the number inside keeps the real value), and
     the mini bar plus value for phones, where every vertical pixel counts. The
     stylesheet shows one of the two; the metric name rides in the tooltip so
     the phone needs no label row. */}}
<span class="dc-host-gauge" data-host-chip="{{.key}}"{{if .label}} title="{{.title}} · {{.label}}"{{end}}{{if not .has}} hidden{{end}}>
  <span class="dc-host-gauge-ring">
    <svg viewBox="0 0 40 40" aria-hidden="true">
      <circle class="dc-host-gauge-track" cx="20" cy="20" r="16"></circle>
      <circle class="dc-host-gauge-bar {{hostRingClass .percent}}" cx="20" cy="20" r="16" pathLength="100" stroke-dasharray="{{hostBar .percent}} 100"></circle>
    </svg>
    <span class="js-host-value fw-medium">{{.percent}}%</span>
  </span>
  <span class="dc-host-gauge-mini" aria-hidden="true"><span class="dc-host-gauge-mini-fill {{hostRingClass .percent}}" {{hostBarHeight .percent}}></span></span>
  <span class="dc-host-gauge-mini-value js-host-value fw-medium">{{.percent}}%</span>
  <span class="dc-host-gauge-name">{{.title}}</span>
</span>
{{end}}

