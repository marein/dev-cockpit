{{/* The server status, a wide screen's alone: three slim bars in the status
     line, CPU, RAM and disk, filled to their percent and green while quiet until a
     reading passes the warn threshold. The bars are the button of a dropup
     carrying the detail rows, and the whole element hides while the host
     reports nothing. */}}
{{define "host_status_bar.gohtml"}}
{{/* The status line scrolls sideways when it has to, which clips a menu
     placed inside it, so this one is positioned fixed. */}}
<dc-host-status class="dropdown dropup"{{if not .Host.Any}} hidden{{end}}>
  <button type="button" class="dc-status-item dc-host-meters" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' data-host-toggle aria-label="Server status">
    {{template "host_status_meter.gohtml" (dict "key" "cpu" "title" "CPU" "has" .Host.HasCPU "percent" .Host.CPUPercent "label" .Host.CPULabel)}}
    {{template "host_status_meter.gohtml" (dict "key" "mem" "title" "RAM" "has" .Host.HasMem "percent" .Host.MemPercent "label" .Host.MemLabel)}}
    {{template "host_status_meter.gohtml" (dict "key" "disk" "title" "Disk" "has" .Host.HasDisk "percent" .Host.DiskPercent "label" .Host.DiskLabel)}}
  </button>
  {{template "host_status_menu.gohtml" .}}
</dc-host-status>
{{end}}

{{define "host_status_meter.gohtml"}}
<span class="dc-host-meter" data-host-meter="{{.key}}" data-host-name="{{.title}}" role="img" aria-label="{{.title}} {{.percent}}%" title="{{.title}} {{.percent}}%{{if .label}} · {{.label}}{{end}}"{{if not .has}} hidden{{end}}>
  <span class="dc-host-meter-name" aria-hidden="true">{{.title}}</span>
  <span class="progress dc-host-meter-track" aria-hidden="true"><span class="progress-bar js-host-bar {{hostBarClass .percent}}" {{hostBarStyle .percent}}></span></span>
</span>
{{end}}

{{define "host_status_menu.gohtml"}}
<div class="dropdown-menu dropdown-menu-end p-3">
  <div class="d-grid gap-3" role="group" aria-label="Server">
    {{template "host_status_row.gohtml" (dict "key" "cpu" "title" "CPU" "has" .Host.HasCPU "percent" .Host.CPUPercent "label" .Host.CPULabel)}}
    {{template "host_status_row.gohtml" (dict "key" "mem" "title" "RAM" "has" .Host.HasMem "percent" .Host.MemPercent "label" .Host.MemLabel)}}
    {{template "host_status_row.gohtml" (dict "key" "disk" "title" "Disk" "has" .Host.HasDisk "percent" .Host.DiskPercent "label" .Host.DiskLabel)}}
  </div>
</div>
{{end}}

{{define "host_status_row.gohtml"}}
<div data-host-row="{{.key}}"{{if not .has}} hidden{{end}}>
  <div class="d-flex align-items-baseline gap-3">
    <span class="text-secondary">{{.title}}</span>
    <span class="ms-auto fw-medium text-nowrap js-host-value">{{.percent}}%</span>
  </div>
  <div class="progress progress-sm mt-2">
    <div class="progress-bar js-host-bar {{hostBarClass .percent}}" {{hostBarStyle .percent}} role="progressbar" aria-label="{{.title}}" aria-valuenow="{{.percent}}" aria-valuemin="0" aria-valuemax="100"></div>
  </div>
  <div class="text-secondary small mt-1 text-nowrap js-host-label">{{.label}}</div>
</div>
{{end}}

{{/* The phone's Cockpit tab icon: the app's own gauge, colored by the worst
     of CPU, RAM and disk, the reading in its tooltip while one passed a
     threshold. The state is spoken through the tab's name (CockpitLabel), so
     the icon itself is hidden from the accessibility tree. It stands whatever
     the host reports, a host that answers nothing leaves it in the tab's own
     color. */}}
{{define "host_status_tab.gohtml"}}
<dc-host-status class="dc-cockpit-icon" data-host-worst><i class="ti ti-dashboard icon {{hostTabClass .Host}}" data-host-worst-icon aria-hidden="true"{{with hostTabLabel .Host}} title="{{.}}"{{end}}></i></dc-host-status>
{{end}}

{{/* The server at the top of the Cockpit sheet: CPU, RAM and disk in one
     row, each a name, its percent and a thin bar, the plain numbers in the
     tooltip. No heading, the bars say what they are and the group is named
     Server for a screen reader. Read only, nothing in it is a control, and
     it hides when the host reports nothing. */}}
{{define "host_status_sheet.gohtml"}}
<dc-host-status class="d-block px-3 pt-3 pb-2" data-cockpit-section="server" role="group" aria-label="Server"{{if not .Host.Any}} hidden{{end}}>
  <div class="row g-3">
    {{template "host_status_line.gohtml" (dict "key" "cpu" "title" "CPU" "has" .Host.HasCPU "percent" .Host.CPUPercent "label" .Host.CPULabel)}}
    {{template "host_status_line.gohtml" (dict "key" "mem" "title" "RAM" "has" .Host.HasMem "percent" .Host.MemPercent "label" .Host.MemLabel)}}
    {{template "host_status_line.gohtml" (dict "key" "disk" "title" "Disk" "has" .Host.HasDisk "percent" .Host.DiskPercent "label" .Host.DiskLabel)}}
  </div>
</dc-host-status>
{{end}}

{{define "host_status_line.gohtml"}}
<div class="col dc-cockpit-meter" data-host-meter="{{.key}}" data-host-name="{{.title}}" role="img" aria-label="{{.title}} {{.percent}}%" title="{{.title}} {{.percent}}%{{if .label}} · {{.label}}{{end}}"{{if not .has}} hidden{{end}}>
  <div class="d-flex justify-content-between gap-1 small" aria-hidden="true">
    <span class="text-secondary">{{.title}}</span>
    <span class="fw-medium text-nowrap js-host-value">{{.percent}}%</span>
  </div>
  <span class="progress dc-host-meter-track mt-1" aria-hidden="true"><span class="progress-bar js-host-bar {{hostBarClass .percent}}" {{hostBarStyle .percent}}></span></span>
</div>
{{end}}
