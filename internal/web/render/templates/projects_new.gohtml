{{define "projects_new.gohtml"}}
{{template "app_start.gohtml" .}}
<div class="page-header d-print-none mb-3">
  <div class="page-pretitle">
    <a href="/projects" class="link-secondary text-decoration-none"><i class="ti ti-arrow-left me-1"></i>Projects</a>
  </div>
  <h2 class="page-title">Create project</h2>
</div>
<div class="card">
  <dc-project-new class="d-block">
  <form method="post" action="/projects">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <div class="card-body">
      <dc-project-select class="d-block mb-3">
        <label class="form-label" for="create">Create</label>
        <select class="form-select" id="create" name="create" data-project-source>
          <option value=""{{if not .Create}} selected{{end}}>An empty project</option>
          <option value="clone"{{if eq .Create "clone"}} selected{{end}}>An existing repository</option>
          {{range .Sources}}<option value="{{worktreeChoice .Name}}"{{if eq .Name $.Source}} selected{{end}} data-project-name="{{.Name}}" data-project-active="{{if .Active}}true{{else}}false{{end}}" data-project-used="{{.LastUsedUnix}}">{{.Name}} (new worktree)</option>{{end}}
        </select>
      </dc-project-select>
      {{if eq .Create "clone"}}
      <div class="mb-3">
        <label class="form-label required" for="clone_url">Repository URL</label>
        <input class="form-control" id="clone_url" name="clone_url" value="{{.Fill.CloneURL}}" required maxlength="500" autofocus autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="https://github.com/you/project.git" data-clone-url>
      </div>
      {{end}}
      {{if .Source}}
      {{if .Branches}}
      <div class="mb-3">
        <label class="form-label" for="branch_mode">Branch</label>
        <select class="form-select" id="branch_mode" name="branch_mode" data-branch-mode>
          <option value="existing"{{if not .DefaultBranch}} disabled{{end}}{{if eq .DefaultMode "existing"}} selected{{end}}>Existing branch</option>
          <option value="new"{{if eq .DefaultMode "new"}} selected{{end}}>New branch</option>
        </select>
      </div>
      <div class="mb-3" data-branch-block="existing"{{if ne .DefaultMode "existing"}} hidden{{end}}>
        <div class="d-flex align-items-center justify-content-between gap-2">
          <label class="form-label mb-1" for="branch">Check out</label>
          <span class="text-secondary small mb-1" data-branch-from hidden></span>
        </div>
        <div class="dropdown" data-branch-picker="branch" data-branch-source="{{.Source}}" data-branch-marks-taken="true">
          <input type="hidden" name="branch" value="{{.DefaultBranch}}" data-branch-value data-branch-name="{{.DefaultBranchName}}" data-branch-upstream="{{.DefaultBranchUpstream}}"{{if ne .DefaultMode "existing"}} disabled{{end}}>
          <input class="form-control" type="text" id="branch" value="{{.DefaultBranchName}}" placeholder="Branch…" role="combobox" aria-expanded="false" aria-autocomplete="list" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-branch-search{{if ne .DefaultMode "existing"}} disabled{{end}}>
          <div class="dropdown-menu w-100" data-branch-menu>
            <button type="button" class="dropdown-item d-flex align-items-center gap-2" data-branch-resync>
              <i class="ti ti-refresh flex-shrink-0" data-branch-resync-icon aria-hidden="true"></i>
              <span>Resync</span>
              <span class="text-secondary small ms-auto flex-shrink-0" data-branch-fetched></span>
            </button>
            <div class="dropdown-divider my-1"></div>
            <div class="overflow-auto" style="max-height: min(14rem, 40vh)" data-branch-list></div>
          </div>
        </div>
        <label class="form-check mt-2 mb-0" data-branch-ff{{if not .DefaultBranchUpstream}} hidden{{end}}>
          <input class="form-check-input" type="checkbox" name="fast_forward" value="1" data-branch-ff-input checked{{if or (not .DefaultBranchUpstream) (ne .DefaultMode "existing")}} disabled{{end}}>
          <span class="form-check-label" data-branch-ff-label>Fast-forward to {{.DefaultBranchUpstream}} after creating</span>
        </label>
      </div>
      <div class="mb-3" data-branch-block="new"{{if ne .DefaultMode "new"}} hidden{{end}}>
        <label class="form-label required" for="new_branch">New branch</label>
        <input class="form-control" id="new_branch" name="new_branch" value="{{$.Fill.NewBranch}}" maxlength="200" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="feature/name" data-branch-new{{if ne .DefaultMode "new"}} disabled{{end}} required>
        <label class="form-label mt-3" for="start">Starting at</label>
        <div class="dropdown" data-branch-picker="start" data-branch-source="{{.Source}}">
          <input type="hidden" name="start" value="{{.DefaultStart}}" data-branch-value data-branch-name="{{.DefaultStart}}"{{if ne .DefaultMode "new"}} disabled{{end}}>
          <input class="form-control" type="text" id="start" value="{{.DefaultStart}}" placeholder="Branch…" role="combobox" aria-expanded="false" aria-autocomplete="list" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-branch-search{{if ne .DefaultMode "new"}} disabled{{end}}>
          <div class="dropdown-menu w-100" data-branch-menu>
            <button type="button" class="dropdown-item d-flex align-items-center gap-2" data-branch-resync>
              <i class="ti ti-refresh flex-shrink-0" data-branch-resync-icon aria-hidden="true"></i>
              <span>Resync</span>
              <span class="text-secondary small ms-auto flex-shrink-0" data-branch-fetched></span>
            </button>
            <div class="dropdown-divider my-1"></div>
            <div class="overflow-auto" style="max-height: min(14rem, 40vh)" data-branch-list></div>
          </div>
        </div>
      </div>
      {{else}}
      <div class="alert alert-warning" role="alert">
        <div class="d-flex">
          <i class="ti ti-alert-circle me-2 fs-3"></i>
          <div class="text-break min-w-0">"{{.Source}}" has no branch yet, so there is nothing a worktree could stand on. Make a commit in it first.</div>
        </div>
      </div>
      {{end}}
      {{end}}
      <div class="mb-0">
        <label class="form-label required" for="project_name">Project name</label>
        <input class="form-control" id="project_name" name="project_name" value="{{.Fill.Name}}" required maxlength="120"{{if not .Create}} autofocus{{end}} autocomplete="off" data-project-name-field>
      </div>
    </div>
    <div class="card-footer">
      <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
        <a class="btn btn-ghost-secondary" href="/projects">Cancel</a>
        <button type="submit" class="btn btn-primary"{{if and .Source (not .Branches)}} disabled{{end}}>Create project</button>
      </div>
    </div>
  </form>
  </dc-project-new>
</div>
{{template "app_end.gohtml" .}}
{{end}}
