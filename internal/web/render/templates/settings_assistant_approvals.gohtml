{{define "settings_assistant_approvals.gohtml"}}
{{template "app_start.gohtml" .}}
{{template "assistant_settings_start.gohtml" .}}
<form method="post" action="/settings/assistant/approvals" id="settings-assistant-approvals">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <div class="text-secondary small mb-3">An approval asks you before any assistant takes that kind of action.</div>
  <div class="list-group list-group-flush mb-3" data-assistant-approvals>
    {{range .Approvals}}
    <label class="list-group-item d-flex align-items-center gap-3" data-assistant-approval="{{.ID}}">
      <span class="flex-fill">
        <span class="d-block">{{.Label}}</span>
        <span class="d-block small text-secondary">{{.Hint}}</span>
      </span>
      <input type="hidden" name="approval-{{.ID}}" value="0">
      <span class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" name="approval-{{.ID}}" value="1" role="switch" aria-label="{{.Label}}"{{if .Ask}} checked{{end}}>
      </span>
    </label>
    {{end}}
  </div>
  <button type="submit" class="btn btn-primary">Save</button>
</form>
{{template "assistant_settings_end.gohtml"}}
{{template "app_end.gohtml" .}}
{{end}}
