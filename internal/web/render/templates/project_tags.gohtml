{{define "project_tags.gohtml"}}
{{template "app_start.gohtml" .}}
{{template "work_start.gohtml" .}}
<a class="btn btn-icon btn-ghost-secondary" href="{{.Return}}" aria-label="Back" title="Back"><i class="ti ti-arrow-left" aria-hidden="true"></i></a>
<h1 class="dc-work-title">Tags of {{.Project}}</h1>
{{template "work_body.gohtml" .}}
<div class="dc-narrow dc-form-width">
  <div class="card">
    {{template "project_tags_form.gohtml" .}}
  </div>
</div>
{{template "app_end.gohtml" .}}
{{end}}

{{/* The project's tags stand first, each a chip whose cross takes it off.
     The field under them finds a tag or creates a new one, and every tag the
     project does not carry is offered right under it, one tap away. A tag in use posts its id, a new one its name and
     the color it shows, the next of NextColors, which is the color the save
     would give it anyway. Colors and names of every tag are the settings'
     (Settings › Projects › Tags), this form changes none. Without scripts the
     field adds what is typed and the tags stay. In the dialog the form keeps
     one height on a desktop and its body scrolls (data-form-fixed). */}}
{{define "project_tags_form.gohtml"}}
<form method="post" action="/projects/{{.Project}}/tags{{if .Modal}}?modal=1{{end}}" data-project-tags-form{{if .Modal}} class="d-flex flex-column overflow-hidden flex-fill" data-form-scrollable data-form-fixed data-form-title="Tags of {{.Project}}" data-form-wait="Saving the tags…"{{end}}>
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <dc-tag-editor class="d-block {{if .Modal}}modal-body{{else}}card-body{{end}}" data-next-colors="{{join .NextColors " "}}" data-colors="{{join .Colors " "}}">
    <div class="form-label" id="project-tags-on">On {{.Project}}</div>
    <div class="d-flex flex-wrap gap-2 align-items-center" role="group" aria-labelledby="project-tags-on" data-tags-on>
      {{range .Tags}}{{template "project_tag_on.gohtml" .}}{{end}}
      <span class="text-secondary small" data-tags-none{{if .Tags}} hidden{{end}}>No tags yet.</span>
    </div>
    <label class="form-label mt-3" for="project-tag-input">Add a tag</label>
    <div class="input-icon">
      <span class="input-icon-addon"><i class="ti ti-tag" aria-hidden="true"></i></span>
      <input type="text" class="form-control" id="project-tag-input" name="new" data-tag-input placeholder="Find or create a tag…" maxlength="40" pattern="[A-Za-z0-9_\-]+" title="A to Z, a to z, 0 to 9, - and _" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true" enterkeyhint="done">
    </div>
    <div><button type="button" class="dc-tag dc-tag-offer mt-2" data-tag-create hidden><span class="dc-tag-name">Create “<span data-tag-create-name></span>”</span></button></div>
    <div class="small text-secondary mt-2 mb-1" id="project-tags-offered" data-tags-offered-label{{if not .Offered}} hidden{{end}}>Other tags</div>
    <div class="d-flex flex-wrap gap-2" role="group" aria-labelledby="project-tags-offered" data-tags-offered>
      {{range .Offered}}{{template "project_tag_offer.gohtml" .}}{{end}}
    </div>
    <div class="form-hint mt-3">A new tag takes the next free color. Names and colors of every tag: <a href="/settings/projects/tags">Settings › Projects › Tags</a>.</div>
    <template data-tag-on-template>{{template "project_tag_on.gohtml" (dict "ID" "" "Name" "" "Color" "")}}</template>
    <template data-tag-offer-template>{{template "project_tag_offer.gohtml" (dict "ID" "" "Name" "" "Color" "")}}</template>
  </dc-tag-editor>
  {{if .Modal}}
  <div class="modal-footer">
    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="submit" class="btn btn-primary">Save</button>
  </div>
  {{else}}
  <div class="card-footer">
    <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
      <a class="btn btn-ghost-secondary" href="{{.Return}}">Cancel</a>
      <button type="submit" class="btn btn-primary">Save</button>
    </div>
  </div>
  {{end}}
</form>
{{end}}

{{define "project_tag_on.gohtml"}}<span class="dc-tag dc-tag-edit{{with .Color}} dc-tag-{{.}}{{end}}" data-tag="{{.ID}}" data-tag-color="{{.Color}}" data-tag-on>
  <input type="hidden" name="{{if .ID}}tag{{else}}new{{end}}" value="{{if .ID}}{{.ID}}{{else}}{{.Name}}{{end}}" data-tag-field>
  <input type="hidden"{{if not .ID}} name="new-color:{{.Name}}" value="{{.Color}}"{{end}} data-tag-color-field>
  <span class="dc-tag-name" data-tag-name>{{.Name}}</span>
  <button type="button" class="dc-tag-x" data-tag-remove aria-label="Remove {{.Name}}" title="Remove {{.Name}}"><i class="ti ti-x" aria-hidden="true"></i></button>
</span>{{end}}

{{define "project_tag_offer.gohtml"}}<button type="button" class="dc-tag dc-tag-offer{{with .Color}} dc-tag-{{.}}{{end}}" data-tag-offer="{{.Name}}" data-tag="{{.ID}}" data-tag-color="{{.Color}}" title="Add {{.Name}}"><span class="dc-tag-name">{{.Name}}</span></button>{{end}}
