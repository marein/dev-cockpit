{{define "docker_run.gohtml"}}
{{template "app_start.gohtml" .}}
{{template "work_start.gohtml" .}}
{{template "project_back.gohtml" .Project}}
<h1 class="dc-work-title">{{.Run.Action}}</h1>
{{if .Project}}<span class="text-secondary small dc-trunc dc-hide-xs">{{.Project}}</span>{{end}}
{{template "work_body.gohtml" .}}
<dc-docker-run class="d-block" output-url="{{.OutputURL}}" stop-url="{{.StopURL}}">
  <div class="card">
    <div class="card-body">
      <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
        <span class="badge{{if .Run.Running}} bg-blue-lt{{else if .Failed}} bg-red-lt{{else}} bg-green-lt{{end}}" data-run-status>{{.Status}}</span>
        {{if .Stack}}<span class="text-secondary small">{{.Stack}}</span>{{end}}
        <span class="text-secondary small font-monospace text-break">{{.Run.Command}}</span>
        <div class="ms-auto">
          <button type="button" class="btn btn-sm btn-ghost-danger" data-run-stop{{if not .Run.Running}} hidden{{end}}>
            <i class="ti ti-player-stop me-1"></i>Cancel
          </button>
        </div>
      </div>
      <pre class="mb-0 overflow-auto dc-run-output" data-run-output>{{.Output}}</pre>
    </div>
  </div>
</dc-docker-run>
{{template "app_end.gohtml" .}}
{{end}}
