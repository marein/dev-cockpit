{{define "terminal_shortcuts_modal.gohtml"}}
<div class="modal modal-blur fade" id="terminal-shortcuts-modal" tabindex="-1" aria-labelledby="terminal-shortcuts-modal-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title" id="terminal-shortcuts-modal-title">Keyboard shortcuts</h3>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="dc-shortcuts">
          <div class="dc-shortcuts-row">
            <span>Next terminal</span>
            <span class="dc-shortcuts-keys"><kbd>Ctrl</kbd>+<kbd>Tab</kbd></span>
          </div>
          <div class="dc-shortcuts-row">
            <span>Previous terminal</span>
            <span class="dc-shortcuts-keys"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Tab</kbd></span>
          </div>
          <div class="dc-shortcuts-note">Works only in an installed web app.</div>
          <div class="dc-shortcuts-row">
            <span>Next / previous split pane</span>
            <span class="dc-shortcuts-keys"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>→</kbd> / <kbd>←</kbd></span>
          </div>
          <div class="dc-shortcuts-row">
            <span>Session switcher</span>
            <span class="dc-shortcuts-keys">Double tap <kbd>Ctrl</kbd></span>
          </div>
          <div class="dc-shortcuts-row">
            <span>New coder or shell</span>
            <span class="dc-shortcuts-keys"><kbd>Cmd</kbd>+<kbd>T</kbd></span>
          </div>
          <div class="dc-shortcuts-note">Opens the plus menu, the arrow keys walk it.</div>
          <div class="dc-shortcuts-row">
            <span>Close the current terminal</span>
            <span class="dc-shortcuts-keys"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>X</kbd></span>
          </div>
          <div class="dc-shortcuts-note">Asks first, like the cross on the tab. On a split view it closes the whole split.</div>
          <div class="dc-shortcuts-row">
            <span>Close one pane of a split</span>
            <span class="dc-shortcuts-keys"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Backspace</kbd></span>
          </div>
          <div class="dc-shortcuts-note">Ctrl even on a Mac, the Cmd version belongs to the browser.</div>
          <div class="dc-shortcuts-row">
            <span>Fullscreen</span>
            <span class="dc-shortcuts-keys"><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>F</kbd> or <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Enter</kbd></span>
          </div>
          <div class="dc-shortcuts-note">A double click on free tab bar space toggles fullscreen too.</div>
        </div>
        <div class="mt-3">
          <a href="/docs#terminals" class="btn btn-outline-secondary w-100">All shortcuts and gestures</a>
        </div>
      </div>
    </div>
  </div>
</div>
{{end}}
