{{define "coders_new.gohtml"}}
{{template "app_start.gohtml" .}}
<div class="page-header d-print-none mb-3">
  <div class="page-pretitle">
    <a href="/projects" class="link-secondary text-decoration-none"><i class="ti ti-arrow-left me-1"></i>Projects</a>
  </div>
  <h2 class="page-title">Start coder</h2>
</div>
<div class="card">
  {{template "coders_new_form.gohtml" .}}
</div>
{{template "app_end.gohtml" .}}
{{end}}

{{/* The one form both surfaces show: the page renders it inside its card, the
     create dialog asks for the same GET with modal=1 and gets it alone. Only
     the shell around the fields differs, and the marker rides the action back
     out through the POST. The name field carries autofocus on the page alone,
     the dialog focuses on a fine pointer only, so a phone keyboard stays down. */}}
{{define "coders_new_form.gohtml"}}
<form method="post" action="/coders/new?return={{urlquery .Return}}{{if .Panel}}&amp;panel=1{{end}}{{if .Modal}}&amp;modal=1{{end}}"{{if .Modal}} data-form-title="Start coder" data-form-wait="Starting the coder…"{{end}}>
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  {{if .SplitGroup}}<input type="hidden" name="group" value="{{.SplitGroup}}">
  <input type="hidden" name="column" value="{{.SplitColumn}}">{{end}}
  <div class="{{if .Modal}}modal-body{{else}}card-body{{end}}">
    <div class="mb-3">
      <label class="form-label required" for="name">Name</label>
      <input class="form-control" id="name" name="name" required maxlength="120"{{if not .Modal}} autofocus{{end}} inputmode="text" autocomplete="off">
    </div>
    <dc-project-select class="d-block mb-3">
      <label class="form-label required" for="project">Project</label>
      <select class="form-select" id="project" name="project" required>
        {{range .Projects}}<option value="{{.Path}}" {{if eq .Path $.DefaultPath}}selected{{end}} data-project-name="{{.Name}}" data-project-active="{{if .Active}}true{{else}}false{{end}}" data-project-used="{{.LastUsedUnix}}">{{.Name}}</option>{{end}}
      </select>
    </dc-project-select>
    <dc-coder-select>
      {{if gt (len .Coders) 1}}
      <div class="mb-3">
        <label class="form-label required" for="coder">Coder</label>
        <select class="form-select" id="coder" name="coder">
          {{range .Coders}}<option value="{{.ID}}" {{if eq .ID $.SelectedCoder}}selected{{end}}>{{coderLabel .ID}}</option>{{end}}
        </select>
      </div>
      {{else}}
      <input type="hidden" name="coder" value="{{.SelectedCoder}}">
      {{end}}
      {{range $co := .Coders}}
      <div class="mb-3" data-coder-agents="{{$co.ID}}" {{if ne $co.ID $.SelectedCoder}}hidden{{end}}>
        <label class="form-label" for="agent-{{$co.ID}}">Agent</label>
        <select class="form-select" id="agent-{{$co.ID}}" name="agent" {{if ne $co.ID $.SelectedCoder}}disabled{{end}}>
          {{range $co.Agents}}<option value="{{.Value}}" {{if eq .Value $co.DefaultAgent}}selected{{end}}>{{.Label}}</option>{{end}}
        </select>
      </div>
      {{end}}
    </dc-coder-select>
    <div class="mb-2">
      <div class="form-label mb-0">Options</div>
    </div>
    <div class="row g-3">
      <div class="col-12">
        <label class="form-check">
          <input class="form-check-input" type="checkbox" name="automatic_approval" {{if .AutomaticApproval}}checked{{end}}>
          <span class="form-check-label">Automatic approval</span>
        </label>
      </div>
    </div>
  </div>
  {{if .Modal}}
  <div class="modal-footer">
    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="submit" class="btn btn-primary">Start coder</button>
  </div>
  {{else}}
  <div class="card-footer">
    <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
      <a class="btn btn-ghost-secondary" href="{{.Return}}">Cancel</a>
      <button type="submit" class="btn btn-primary">Start coder</button>
    </div>
  </div>
  {{end}}
</form>
{{end}}
