{{define "assistant_thread.gohtml"}}
{{if .EarlierCount}}
<div class="text-center mb-3">
  <a href="{{.AllURL}}" class="btn btn-sm" data-assistant-all>
    <i class="ti ti-chevron-up me-1"></i>Show {{.EarlierCount}} earlier message{{if ne .EarlierCount 1}}s{{end}}
  </a>
</div>
{{end}}
<div class="d-flex flex-column gap-3" data-assistant-log aria-live="polite" aria-label="Conversation">
  {{range .Messages}}{{template "assistant_message.gohtml" (dict "Message" .)}}{{end}}
</div>
{{if not .Messages}}
<div class="text-center py-5" data-assistant-empty>
  <div class="mb-3"><span class="dc-term-icon assistant fs-1" aria-hidden="true"><i class="ti ti-sparkles"></i></span></div>
  <p class="mb-1">Give me a task. A coder builds it, I steer it and report done or stuck.</p>
  <p class="text-secondary mb-1">Stuck somewhere? Ask me, I look at what is running and get it going again.</p>
  <p class="text-secondary mb-1">I know your projects and this machine, and you can attach a picture, a recording or a clip.</p>
  <p class="text-secondary mb-1">Start another assistant for work that has nothing to do with this one. We share what you tell us to remember, and each of us keeps its own coders.</p>
  <p class="text-secondary mb-0">All of this is customizable, just tell me when I should <em>remember something</em>.</p>
  <div class="d-inline-block border rounded text-secondary small mt-4 px-3 py-2" role="note">
    <i class="ti ti-info-circle me-1" aria-hidden="true"></i>Which model answers is picked at the ring button beside the message box, for the chat, for the checks and for the triggers.
  </div>
</div>
{{end}}
{{end}}

{{define "assistant_composer.gohtml"}}
{{if .Blocked}}
<div class="assistant-composer" data-assistant-footer role="status">
  <div class="d-flex align-items-center gap-2">
    <div class="text-secondary small flex-fill min-w-0">{{.Blocked}}</div>
    <form method="post" action="/assistants/new" class="flex-shrink-0">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="form" value="new">
      {{if .NewCoderID}}<input type="hidden" name="coder" value="{{.NewCoderID}}">{{end}}
      <button type="submit" class="btn btn-primary" data-assistant-new-context>
        <i class="ti ti-plus me-1"></i>New assistant
      </button>
    </form>
  </div>
</div>
{{else}}
{{/* The form the ring's model selects post to, beside the composer for the
     same reason the new forms stand here: the composer is itself a form. The
     selects reach it through the form attribute; the element posts it with
     fetch, and without JS the menu's Save button submits it. */}}
<form method="post" action="{{.PostURL}}" id="assistant-new-model" class="d-none" data-assistant-model-form data-no-pe>
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <input type="hidden" name="form" value="model">
</form>
<form method="post" action="{{.PostURL}}" class="assistant-composer" data-assistant-form data-assistant-footer data-no-pe>
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <input type="hidden" name="form" value="message">
  <input type="file" class="d-none" multiple data-assistant-file accept="image/*,video/*,audio/*,.pdf,.txt,.md,.json,.csv,.log,.zip">
  <div class="d-flex flex-wrap gap-2 mb-2 d-none" data-assistant-attachments aria-label="Attached files"></div>
  <div class="d-flex align-items-end gap-2">
    {{template "assistant_new_button.gohtml" (dict "Coders" .Coders "CoderID" .CoderID "Models" .Models "ContextPercent" .ContextPercent "NewClass" "btn btn-icon btn-ghost-secondary flex-shrink-0" "Prefix" "assistant-new")}}
    <button type="button" class="btn btn-icon btn-ghost-secondary flex-shrink-0" aria-label="Attach a file" title="Attach a file, or drop it anywhere on the page" data-assistant-attach>
      <i class="ti ti-paperclip"></i>
    </button>
    <div class="flex-fill min-w-0 position-relative">
      <textarea class="form-control" name="message" rows="1" data-assistant-input placeholder="What to do?" aria-label="Message" autocomplete="off" autocorrect="on" autocapitalize="sentences" spellcheck="true">{{.Draft}}</textarea>
      {{if .SttURL}}
      {{/* Stands over the message box while a recording runs: the red dot with
           the clock, Slide to cancel while a finger holds the button, the
           trash and the live level trace once the recording is locked, and for
           a moment afterwards the word that the clip was thrown away or how
           the button is held. The element paints it, nothing here decides. */}}
      <div class="position-absolute top-0 start-0 w-100 h-100 d-none align-items-center gap-2 px-2 bg-body rounded pe-none text-secondary" data-assistant-talk-hint aria-live="polite">
        <button type="button" class="btn btn-icon btn-sm btn-ghost-danger pe-auto flex-shrink-0 d-none" aria-label="Discard the recording" title="Discard the recording, Esc does the same" data-assistant-talk-discard><i class="ti ti-trash"></i></button>
        <span class="d-inline-flex align-items-center gap-2 flex-shrink-0 d-none" data-assistant-talk-timer><span class="status-dot status-dot-animated status-red"></span><span class="font-monospace" data-assistant-talk-clock>0:00</span></span>
        <span class="flex-fill min-w-0 d-inline-flex align-items-center justify-content-center gap-1 small" data-assistant-talk-slide><i class="ti ti-chevron-left" aria-hidden="true"></i><span data-assistant-talk-hint-text>Slide to cancel</span></span>
        <canvas class="flex-fill w-100 min-w-0 d-none" height="24" data-assistant-talk-wave aria-hidden="true"></canvas>
      </div>
      {{end}}
    </div>
    {{/* The button beside the box wears two faces: the microphone while nothing
         stands in the box, the send once words or a finished attachment do.
         The server renders the send, the face a host without the engine or
         without a microphone keeps, and the element paints the microphone once
         it knows both are there (syncSendFace). Over it stands the lock pill a
         held recording is slid up into, shown by the element while a finger
         holds the button. */}}
    {{if .SttURL}}
    <div class="position-relative flex-shrink-0">
      <span class="badge bg-secondary-lt text-secondary rounded-pill position-absolute bottom-100 start-50 translate-middle-x mb-3 d-inline-flex flex-column align-items-center gap-1 py-2 px-2 d-none" data-assistant-talk-lock aria-hidden="true"><i class="ti ti-lock-open"></i><i class="ti ti-chevron-up"></i></span>
      <button type="submit" class="btn btn-icon btn-primary" aria-label="Send message" data-assistant-send>
        <i class="ti ti-send"></i>
      </button>
    </div>
    {{else}}
    <button type="submit" class="btn btn-icon btn-primary flex-shrink-0" aria-label="Send message" data-assistant-send>
      <i class="ti ti-send"></i>
    </button>
    {{end}}
    <button type="button" class="btn btn-icon btn-outline-danger flex-shrink-0 d-none" aria-label="Stop answering" data-assistant-cancel>
      <i class="ti ti-player-stop"></i>
    </button>
  </div>
  <div class="text-center"><small class="form-hint d-none" data-assistant-count></small></div>
</form>
{{end}}
{{end}}

{{/* The new assistant control's button stands outside any form of its own in
     the list column head and in the empty state, the two places it still
     makes one, so it reaches its posting form by id through the form
     attribute. The prefix keeps the ids apart between the list column and
     the phone's sheet, which is that same column rendered again in the same
     document. */}}
{{define "assistant_new_forms.gohtml"}}
{{if gt (len .Coders) 1}}
{{range .Coders}}
<form method="post" action="{{$.PostURL}}" id="{{$.Prefix}}-{{.ID}}" class="d-none">
  <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
  <input type="hidden" name="form" value="new">
  <input type="hidden" name="coder" value="{{.ID}}">
</form>
{{end}}
{{else}}
<form method="post" action="{{.PostURL}}" id="{{.Prefix}}" class="d-none">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <input type="hidden" name="form" value="new">
  <input type="hidden" name="coder" value="{{.CoderID}}">
</form>
{{end}}
{{end}}

{{/* The ring around the button says how full the coder's context window is. It
     sits inside the button, not around it: the dropdown branch needs the menu to
     stay the toggle's next sibling and the plain branch reaches its posting form
     through a form attribute, so a wrapper element would break one or the other.
     The label carries the number as words, because a ring alone is not readable
     without a pointer.

     With Models the button always opens a dropdown, wears the icon of the
     coder this assistant runs on (see the ring icon template below, so the
     ring says at a glance which coder it is) and is labelled for what it now
     only does, this assistant's models: the Chat, the Checks and the
     Triggers select over that coder's list, and the coder's own note under
     them. It holds no New with entries and no divider, a new assistant is
     made from the list column's own button instead. The selects post through
     the model form beside the composer (the form attribute), the element
     saves a change with fetch, and the Save button is the way without JS,
     hidden once the element runs. Without Models (the list column, the empty
     state) the button keeps its old shape and its old job, making a new
     assistant: a dropdown with several coders and the message-plus icon, a
     plain button with one. */}}
{{define "assistant_new_button.gohtml"}}
{{$base := "New assistant, the memory comes along"}}
{{$toggleBase := $base}}{{if .Models}}{{$toggleBase = "This assistant's models"}}{{end}}
{{$label := $base}}{{if .ContextPercent}}{{$label = printf "%s. Context %d percent" $base .ContextPercent}}{{end}}
{{$toggleLabel := $toggleBase}}{{if .ContextPercent}}{{$toggleLabel = printf "%s. Context %d percent" $toggleBase .ContextPercent}}{{end}}
{{if or .Models (gt (len .Coders) 1)}}
<div class="dropdown flex-shrink-0">
  <button type="button" class="{{.NewClass}} position-relative" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" data-assistant-new-label="{{$toggleBase}}" aria-label="{{$toggleLabel}}" title="{{$toggleLabel}}">
    {{if .Models}}{{template "assistant_context_ring_icon.gohtml" .CoderID}}{{else}}<i class="ti ti-message-plus"></i>{{end}}
    {{if not .NoRing}}{{template "assistant_context_ring.gohtml" .ContextPercent}}{{end}}
  </button>
  <div class="dropdown-menu dropdown-menu-end{{if .Models}} dc-model-menu{{end}}">
    {{if .Models}}
    <div class="px-3 pb-2 pt-2" data-assistant-models>
      <label class="form-label mb-1" for="{{.Prefix}}-model-chat">Chat</label>
      {{template "assistant_model_pick.gohtml" (dict "Pick" .Models.Chat "ID" (printf "%s-model-chat" .Prefix) "Form" (printf "%s-model" .Prefix) "Small" true "Kind" "chat")}}
      <label class="form-label mb-1 mt-2" for="{{.Prefix}}-model-check">Checks</label>
      {{template "assistant_model_pick.gohtml" (dict "Pick" .Models.Check "ID" (printf "%s-model-check" .Prefix) "Form" (printf "%s-model" .Prefix) "Small" true "Kind" "check")}}
      <label class="form-label mb-1 mt-2" for="{{.Prefix}}-model-trigger">Triggers</label>
      {{template "assistant_model_pick.gohtml" (dict "Pick" .Models.Trigger "ID" (printf "%s-model-trigger" .Prefix) "Form" (printf "%s-model" .Prefix) "Small" true "Kind" "trigger")}}
      {{if .Models.Note}}<div class="form-hint mt-2" data-assistant-model-note>{{.Models.Note}}</div>{{end}}
      <button type="submit" form="{{.Prefix}}-model" class="btn btn-sm mt-2" data-assistant-model-save>Save models</button>
    </div>
    {{else}}
    {{range .Coders}}
    <button type="submit" form="{{$.Prefix}}-{{.ID}}" class="dropdown-item d-flex align-items-center gap-2" data-assistant-new="{{.ID}}">
      <span class="dc-term-icon" aria-hidden="true">{{template "coder_icon.gohtml" .ID}}</span>
      <span>New with {{.Label}}</span>
    </button>
    {{end}}
    {{end}}
  </div>
</div>
{{else}}
<button type="submit" form="{{.Prefix}}" class="{{.NewClass}} position-relative" data-assistant-new-label="{{$base}}" aria-label="{{$label}}" title="{{$label}}" data-assistant-new="{{.CoderID}}">
  <i class="ti ti-message-plus"></i>
  {{if not .NoRing}}{{template "assistant_context_ring.gohtml" .ContextPercent}}{{end}}
</button>
{{end}}
{{end}}

{{/* The circle's radius is 100/(2*pi), so its circumference is exactly 100 user
     units and the filled part is the percentage itself: no arithmetic in the
     template, and no dependence on pathLength, which browsers implement
     unevenly. The rotation puts the start at twelve o'clock, the sweep runs
     clockwise from there. The halo carries the same sweep one step wider: the
     button fills its background while it is hovered, and that fill is what the
     level colors would otherwise sink into. */}}
{{define "assistant_context_ring.gohtml"}}
<svg class="dc-context-ring" viewBox="0 0 36 36" aria-hidden="true" focusable="false" data-assistant-ring{{if ge . 95}} data-assistant-ring-level="full"{{else if ge . 85}} data-assistant-ring-level="high"{{end}}>
  <circle class="dc-context-ring-track" cx="18" cy="18" r="15.9155"></circle>
  <circle class="dc-context-ring-halo" cx="18" cy="18" r="15.9155" transform="rotate(-90 18 18)" stroke-dasharray="{{.}} 100" data-assistant-ring-halo></circle>
  <circle class="dc-context-ring-fill" cx="18" cy="18" r="15.9155" transform="rotate(-90 18 18)" stroke-dasharray="{{.}} 100" data-assistant-ring-fill></circle>
</svg>
{{end}}

{{/* The icon inside the ring is the coder this assistant runs on, the same
     glyph coder_icon.gohtml renders elsewhere: the ring says at a glance
     which coder is behind the composer. Where that glyph is an svg (claude,
     opencode) this template stays that svg itself, carrying the ring's own
     class and data attribute directly, so the centering CSS below keeps
     applying to the element it always applied to; the path data is
     coder_icon.gohtml's own, never a second copy. Never the webfont glyph
     (copilot) unwrapped: the font puts every glyph's outline flush left in
     its advance, so its ink sits off the center of its own box, and every
     platform rounds the baseline its own way too, none of which shows until
     a ring is drawn around it, while an svg's ink is centered in its viewBox
     by construction. So a font glyph is wrapped in a span carrying the same
     class and attribute, centering it the way the svg centers itself. */}}
{{define "assistant_context_ring_icon.gohtml"}}{{if eq . "claude"}}<svg class="dc-context-ring-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" data-assistant-ring-icon>{{template "coder_icon_claude_paths.gohtml"}}</svg>{{else if eq . "opencode"}}<svg class="dc-context-ring-icon" viewBox="0 0 256 320" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" data-assistant-ring-icon>{{template "coder_icon_opencode_paths.gohtml"}}</svg>{{else if eq . "copilot"}}<span class="dc-context-ring-icon" aria-hidden="true" data-assistant-ring-icon><i class="ti ti-brand-github-copilot"></i></span>{{else}}<span class="dc-context-ring-icon" aria-hidden="true" data-assistant-ring-icon>{{coderLabel .}}</span>{{end}}{{end}}
