{{define "settings_editor_search.gohtml"}}
{{template "app_start.gohtml" .}}
{{template "editor_page_start.gohtml" .}}
<form method="post" action="/settings/editor/search" id="settings-editor-search">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <div class="text-secondary small mb-3">Go to file, Find in files and Replace in files read the whole project, so what they must not read is the only thing to configure. All three answer from the same list.</div>
  <div class="mb-3 row">
    <div class="col-12 col-lg-8">
      <label class="form-label" for="editor-search-exclusions">Exclude these folders</label>
      <textarea class="form-control font-monospace" id="editor-search-exclusions" name="exclusions" rows="8" spellcheck="false" placeholder="vendor&#10;node_modules&#10;tests/_output">{{.Exclusions}}</textarea>
      <div class="form-text">
        One per line. A bare name like <code>vendor</code> excludes every folder with that name, wherever it sits.
        A path like <code>tests/_output</code> excludes only that one, counted from the project root.
        An excluded folder is not descended into at all, so nothing inside it is found, and a replacement never reaches it either.
        Leave the box empty to search everything.
      </div>
    </div>
  </div>
  <button type="submit" class="btn btn-primary">Save</button>
</form>
{{template "editor_page_end.gohtml"}}
{{template "app_end.gohtml" .}}
{{end}}
