{{/* The bell with its menu. The context is the dropdown's extra class, so the
     rail opens its menu to the side (dropend) and a head opens it downwards.
     The rail clips what leaves its column, so its menu is positioned fixed. */}}
{{define "notify_bell.gohtml"}}<div class="dropdown{{if .}} {{.}}{{end}}">
  <button type="button" class="btn btn-icon dc-notify-bell" data-bs-toggle="dropdown" data-bs-auto-close="outside"{{if eq . "dropend"}} data-bs-popper-config='{"strategy":"fixed"}'{{end}} aria-label="Notifications" title="Notifications">
    <i class="ti ti-bell fs-2"></i>
    <span class="dc-notify-badge d-none" aria-hidden="true">0</span>
  </button>
  <div class="dropdown-menu dropdown-menu-end dc-notify-menu shadow">
    <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">
      <span class="fw-bold">Notifications</span>
      <button type="button" class="btn btn-link btn-sm ms-auto p-0 dc-notify-read-all">Mark all read</button>
    </div>
    <div class="list-group list-group-flush dc-notify-list"></div>
  </div>
</div>{{end}}
