{{/* The settings column: one row per section, the coders indented under their
     label when more than one is active, the backup with its review count. Every
     settings page renders it through settings_ctx.gohtml, which takes the page
     and reads .SettingsNav. */}}
{{define "settings_ctx.gohtml"}}
{{template "ctx_start.gohtml" (dict "Title" "Settings")}}
{{template "ctx_body.gohtml"}}
{{template "settings_nav" .SettingsNav}}
{{template "ctx_end.gohtml"}}
{{end}}

{{define "settings_nav"}}
<nav class="list-group list-group-flush dc-rows" data-settings-nav aria-label="Settings sections">
  <a href="/settings/general" class="list-group-item list-group-item-action{{if eq .Active "general"}} active{{end}}" data-dc-focus="work">
    <i class="ti ti-adjustments" aria-hidden="true"></i><span class="flex-fill dc-trunc">General</span>
  </a>
  <a href="/settings/editor/search" class="list-group-item list-group-item-action{{if eq .Active "editor"}} active{{end}}" data-dc-focus="work">
    <i class="ti ti-code" aria-hidden="true"></i><span class="flex-fill dc-trunc">Editor</span>
  </a>
  <a href="/settings/docker" class="list-group-item list-group-item-action{{if eq .Active "docker"}} active{{end}}" data-dc-focus="work">
    <i class="ti ti-brand-docker" aria-hidden="true"></i><span class="flex-fill dc-trunc">Docker</span>
  </a>
  <a href="/settings/notifications" class="list-group-item list-group-item-action{{if eq .Active "notifications"}} active{{end}}" data-dc-focus="work">
    <i class="ti ti-bell" aria-hidden="true"></i><span class="flex-fill dc-trunc">Notifications</span>
  </a>
  <a href="/settings/assistant" class="list-group-item list-group-item-action{{if eq .Active "assistant"}} active{{end}}" data-dc-focus="work">
    <i class="ti ti-sparkles" aria-hidden="true"></i><span class="flex-fill dc-trunc">Assistant</span>
  </a>
  {{if .Multi}}
  <div class="dc-section-head"><i class="ti ti-robot" aria-hidden="true"></i>Coder</div>
  {{$selected := .Selected}}
  {{range .Coders}}
  <a href="{{.URL}}" class="list-group-item list-group-item-action is-nested{{if eq .ID $selected}} active{{end}}" data-settings-coder="{{.ID}}" data-dc-focus="work">
    {{template "coder_icon.gohtml" .ID}}<span class="flex-fill dc-trunc">{{coderLabel .ID}}</span>
  </a>
  {{end}}
  {{else}}
  {{$active := .Active}}
  {{range .Coders}}
  <a href="{{.URL}}" class="list-group-item list-group-item-action{{if eq $active "coder"}} active{{end}}" data-settings-coder="{{.ID}}" data-dc-focus="work">
    <i class="ti ti-robot" aria-hidden="true"></i><span class="flex-fill dc-trunc">Coder</span>
  </a>
  {{end}}
  {{end}}
  <a href="/settings/backup" class="list-group-item list-group-item-action{{if eq .Active "backup"}} active{{end}}" data-dc-focus="work">
    <i class="ti ti-database-export" aria-hidden="true"></i>
    <span class="d-flex flex-column dc-min0 flex-fill">
      <span>Backup</span>
      <span class="text-warning dc-row-note">Experimental</span>
    </span>
    {{if .Reviews}}<span class="badge bg-primary-lt" title="Backup files to resolve">{{.Reviews}}</span>{{end}}
  </a>
</nav>
{{end}}
