{{/* The coders one assistant steers, the first of the aside's two tabs. A row
     is folded: the coder, where it works, how it stands. What it was sent,
     what it is measured against and what came back are three named parts of
     the fold, because three grey lines under each other are one text nobody
     reads.

     The fold holds that text and nothing else. The actions stand below it and
     outside it, so opening a coder, its editor, a trigger on it or taking it
     back is one press from a closed row: reading what it was sent is a
     question somebody asks now and then, acting on it is the everyday case,
     and a closed row that answers neither is a row that has to be opened
     before it is of any use. The row is taller for it, deliberately. */}}
{{define "assistant_jobs_list.gohtml"}}
<div data-assistant-body data-assistant-jobs-open="{{.JobsOpen}}">
  {{if .Jobs}}
  <div class="list-group list-group-flush" data-assistant-jobs>
    {{range .Jobs}}
    <div class="list-group-item px-0" data-assistant-job="{{.Terminal}}">
      <div class="d-flex align-items-center gap-2">
        {{template "assistant_job_state.gohtml" .}}
        {{/* The two names are the two things behind the row, so they are the
             way there: the coder's name opens the coder, the project's name
             opens the project. */}}
        <div class="min-w-0 flex-fill">
          <div class="fw-medium text-truncate">{{if .URL}}<a class="text-reset text-decoration-none" href="{{.URL}}" data-assistant-job-coder-link>{{.Name}}</a>{{else}}{{.Name}}{{end}}</div>
          {{/* Only a list of everybody's jobs names the assistant; on one
               assistant's own page the answer is always the same. */}}
          <div class="text-secondary small text-truncate">{{if .Owner}}{{.Owner}}{{if .Project}} · {{end}}{{end}}{{if and .Project $.Access.Guest}}{{.Project}}{{else if .Project}}<a class="link-secondary text-decoration-none" href="/projects#project-{{.Project}}" data-assistant-job-project-link>{{.Project}}</a>{{end}}</div>
        </div>
        <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary flex-shrink-0" data-bs-toggle="collapse" data-bs-target="#assistant-job-{{.OwnerID}}-{{.Terminal}}-details" aria-expanded="false" aria-controls="assistant-job-{{.OwnerID}}-{{.Terminal}}-details" aria-label="Details" title="Details" data-assistant-job-fold><i class="ti ti-chevron-down" aria-hidden="true"></i></button>
      </div>
      <div class="collapse" id="assistant-job-{{.OwnerID}}-{{.Terminal}}-details" data-assistant-fold data-assistant-job-details>
        {{if .Task}}
        <div class="mt-2">
          <div class="datagrid-title mb-1">Prompt</div>
          <div class="small text-break" data-assistant-job-task>{{.Task}}</div>
        </div>
        {{end}}
        <div class="mt-2">
          <div class="datagrid-title mb-1">Done when</div>
          <div class="small text-break" data-assistant-job-done-when>{{if .DoneWhen}}{{.DoneWhen}}{{else}}What the session's own task says{{end}}</div>
        </div>
        {{if .Note}}
        <div class="mt-2">
          <div class="datagrid-title mb-1">Last report</div>
          <div class="small text-break" data-assistant-job-note>{{.Note}}</div>
        </div>
        {{end}}
        <div class="text-secondary small mt-2">{{.Wakes}} of {{.MaxWakes}} checks{{if and .Open .Expires}} · until <dc-time datetime="{{.Expires}}"></dc-time>{{end}}</div>
      </div>
      {{/* Two ways to look at a steered coder, the screen it types on and the
           files it writes; the editor is offered where the coder works in a
           project, and then the coder is handed back or taken on again. A
           stopped coder has no screen to look at, so its row resumes it. The
           row wraps, so the actions stand side by side in the inline aside and
           under each other in the phone's sheet. They sit outside the fold
           above them, so they stand whether it is open or shut. A guest
           only looks, where the link opens the coder or its project. */}}
      {{if or .URL .EditorURL (not $.Access.Guest)}}
      <div class="d-flex flex-wrap gap-2 mt-2">
        {{if and .Stopped (not $.Access.Guest)}}
        {{template "assistant_job_resume.gohtml" (dict "Job" . "CSRF" $.CSRFToken)}}
        {{else if .URL}}
        <a href="{{.URL}}" class="btn btn-sm flex-fill" data-assistant-job-open>
          <i class="ti ti-terminal-2 me-1"></i>Open coder
        </a>
        {{end}}
        {{if .EditorURL}}
        <a href="{{.EditorURL}}" class="btn btn-sm flex-fill" data-assistant-job-editor>
          <i class="ti ti-code me-1"></i>Open editor
        </a>
        {{end}}
        {{if not $.Access.Guest}}
        {{if .Open}}
        <form method="post" action="{{$.JobsURL}}" class="flex-fill d-flex" data-ajax-refresh
              data-confirm="Release &#34;{{.Name}}&#34;? The coder keeps working, nothing checks on it any more. It is yours again."
              data-confirm-button="Release">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <input type="hidden" name="form" value="release">
          <input type="hidden" name="terminal" value="{{.Terminal}}">
          <button type="submit" class="btn btn-sm btn-outline-warning flex-fill" data-assistant-job-stop>
            <i class="ti ti-steering-wheel-off me-1"></i>Release
          </button>
        </form>
        {{else}}
        <form method="post" action="{{$.JobsURL}}" class="flex-fill d-flex" data-ajax-refresh>
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <input type="hidden" name="form" value="steer">
          <input type="hidden" name="terminal" value="{{.Terminal}}">
          <input type="hidden" name="assistant" value="{{.OwnerID}}">
          <input type="hidden" name="task" value="{{.Task}}">
          <input type="hidden" name="done_when" value="{{.DoneWhen}}">
          <button type="submit" class="btn btn-sm btn-outline-primary flex-fill" data-assistant-job-again>
            <i class="ti ti-steering-wheel me-1"></i>Steer again
          </button>
        </form>
        {{end}}
        {{end}}
      </div>
      {{end}}
    </div>
    {{end}}
    {{if .JobsOlder}}
    <button type="button" class="btn btn-link btn-sm link-secondary px-0 align-self-start dc-tap" data-assistant-older>and {{.JobsOlder}} older</button>
    {{end}}
  </div>
  {{else}}
  <div class="text-secondary small py-2" data-assistant-jobs-empty>Nothing steered.{{if not $.Access.Guest}} Ask the assistant to keep an eye on a coder and say when it is done, then it stands here.{{end}}</div>
  {{end}}
</div>
{{end}}

{{/* The resume of a stopped coder, which lands on the coder once it runs:
     the Coders tab's button, a card's row with Row. */}}
{{define "assistant_job_resume.gohtml"}}
<form method="post" action="/coders/{{.Job.Terminal}}/resume" class="d-flex{{if not .Row}} flex-fill{{end}}"{{if .Row}} data-assistant-project-job="{{.Job.Terminal}}"{{end}}>
  <input type="hidden" name="csrf_token" value="{{.CSRF}}">
  {{- if .Row}}
  <button type="submit" class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-2 px-3 py-1 small" title="Resume coder" data-assistant-job-resume>
    {{template "assistant_job_state.gohtml" .Job}}<span class="text-truncate min-w-0">{{.Job.Name}}</span>
  </button>
  {{- else}}
  <button type="submit" class="btn btn-sm flex-fill" data-assistant-job-resume>
    <i class="ti ti-terminal-2 me-1"></i>Resume coder
  </button>
  {{- end}}
</form>
{{end}}

{{/* The coder's own icon, the one its terminal tab wears, and what the job
     alone knows on top of it: purple while the job is open, the dot running
     along its edge while a check is on it too, red where the job closed
     blocked or expired, also while the coder runs. The word names the job and,
     where the colour is the session's, the session. A job's row and a project
     card's row wear the same. */}}
{{define "assistant_job_state.gohtml"}}
{{- $tone := ""}}{{$word := "Released"}}
{{- if .Open}}{{$word = "Steering"}}{{if .Checking}}{{$word = "Checking"}}{{end}}
{{- else if eq .State "blocked"}}{{$tone = "text-danger"}}{{$word = "Blocked"}}
{{- else if eq .State "expired"}}{{$tone = "text-danger"}}{{$word = "Expired"}}
{{- else}}{{if eq .State "done"}}{{$word = "Done"}}{{end}}{{$word = printf "%s, %s" $word (or (and .Running "running") "stopped")}}{{end -}}
{{template "steered_icon.gohtml" (dict "ID" .Terminal "Coder" .Coder "Launcher" .Launcher "Steered" .Open "Working" .Working "Stopped" (not .Running) "News" .News "Tone" $tone "Held" .Checking "Label" $word "Job" .State)}}
{{- end}}
