{{/* The period's bars and its running total under them, one column per
     step spanning both as its hit area. A column's tooltip is rendered once
     here as a template, the page shows a copy of it. */}}
{{define "cost_chart.gohtml"}}
{{$board := .}}
{{with .Chart}}
<div class="card mb-3" data-cost-chart>
  <div class="card-header flex-wrap gap-2">
    <div class="me-auto">
      <h3 class="card-title">{{.Title}}</h3>
      <div class="text-secondary small">{{$board.RangeLabel}}, <span data-cost-chart-total>{{$board.RangeTotal}}</span></div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <div class="btn-group" role="group" aria-label="Stack by">
        {{range .Dims}}<a href="{{.URL}}" class="btn btn-sm{{if .Active}} active{{end}}"{{if .Active}} aria-current="true"{{end}} data-cost-by="{{.Label}}">{{.Label}}</a>{{end}}
      </div>
      <div class="btn-group" role="group" aria-label="Unit">
        {{range .Units}}<a href="{{.URL}}" class="btn btn-sm{{if .Active}} active{{end}}"{{if .Active}} aria-current="true"{{end}} data-cost-unit="{{.Label}}">{{.Label}}</a>{{end}}
      </div>
    </div>
  </div>
  <div class="card-body">
    <div class="dc-cost-frame{{if .Empty}} empty{{end}}" style="--n: {{len .Columns}}" data-cost-frame data-top="{{.Top}}">
      <div class="dc-cost-plot dc-cost-plot-bars" aria-hidden="true">
        {{range .Grid}}<div class="dc-cost-grid" style="--b: {{printf "%.2f" .Bottom}}"><span>{{.Label}}</span></div>{{end}}
        {{if .Empty}}<div class="dc-cost-nothing text-secondary small">Nothing in this period.</div>{{end}}
      </div>
      <div class="dc-cost-plot-label text-secondary small" aria-hidden="true">Running total</div>
      <div class="dc-cost-plot dc-cost-plot-cum" aria-hidden="true">
        <div class="dc-cost-grid" style="--b: 100"><span>{{.CumTop}}</span></div>
        {{if .CumLine}}<svg viewBox="0 0 100 100" preserveAspectRatio="none" data-cost-cum><polygon class="dc-cost-cum-area" points="{{.CumArea}}"></polygon><polyline class="dc-cost-cum-line" points="{{.CumLine}}" vector-effect="non-scaling-stroke"></polyline></svg>{{end}}
      </div>
      <div class="dc-cost-cols" role="group" aria-label="{{.Title}}, {{$board.RangeLabel}}">
        {{range .Columns}}<button type="button" class="dc-cost-col{{if .Current}} current{{end}}" data-cost-col="{{.Key}}"{{with .Drill}} data-drill="{{.}}"{{end}} aria-label="{{.Label}}: {{.Value}}"><span class="dc-cost-stack" style="--h: {{printf "%.2f" .Height}}">{{range .Segments}}<span class="dc-cost-seg {{.Color}}" data-series="{{.Series}}" data-v="{{printf "%.6f" .V}}" style="flex-grow: {{printf "%.6f" .V}}"></span>{{end}}</span>{{if not .Future}}<span class="dc-cost-dot" style="--c: {{printf "%.2f" .Cum}}"></span>{{end}}</button>{{end}}
      </div>
      <div class="card card-sm dc-cost-tip" role="tooltip" hidden data-cost-tip></div>
    </div>
    <div class="dc-cost-axis small text-secondary" aria-hidden="true">{{range .Labels}}<span class="{{.Anchor}}{{if .Minor}} minor{{end}}" style="--l: {{printf "%.2f" .Left}}">{{.Label}}</span>{{end}}</div>
    {{if .Legend}}<div class="d-flex flex-wrap gap-2 mt-3" role="group" aria-label="Series, a click hides or shows one" data-cost-legend>
      {{range .Legend}}<button type="button" class="btn btn-sm dc-cost-key" aria-pressed="true" data-series="{{.Key}}"><span class="dc-cost-swatch {{.Color}}" aria-hidden="true"></span><span class="text-break">{{.Label}}</span><span class="text-secondary">{{.Value}}</span></button>{{end}}
    </div>{{end}}
    {{range .Columns}}<template data-cost-tipbody="{{.Key}}">
      <div class="text-secondary small">{{.Label}}</div>
      <div class="fw-bold fs-3">{{.Value}}</div>
      {{range .Tips}}<div class="dc-cost-tiprow" data-series="{{.Series}}"><span class="dc-cost-linekey {{.Color}}" aria-hidden="true"></span><span class="fw-medium text-nowrap">{{.Value}}</span><span class="text-secondary text-break">{{.Label}}</span></div>{{end}}
      {{if not .Future}}<div class="text-secondary small mt-1">Running total {{.CumValue}}</div>{{end}}
      {{if .Drill}}<a href="{{.Drill}}" class="small d-inline-block mt-1" data-cost-tipdrill>{{.DrillLabel}}</a>{{end}}
    </template>{{end}}
  </div>
</div>
{{end}}
{{end}}
