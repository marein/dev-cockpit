HOME = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
INDEX = os.path.join(HOME, "session_index.jsonl")


def say(text):
    sys.stdout.write(text + "\r\n")
    sys.stdout.flush()


def now():
    return datetime.datetime.now(datetime.timezone.utc)


def stamp():
    return now().isoformat().replace("+00:00", "Z")


def find_rollout(session):
    found = glob.glob(os.path.join(HOME, "sessions", "*", "*", "*", "rollout-*-%s.jsonl" % session))
    return found[0] if found else None


def name_session(session, name):
    os.makedirs(HOME, exist_ok=True)
    with open(INDEX, "a") as f:
        f.write(json.dumps({"id": session, "thread_name": name, "updated_at": stamp()}) + "\n")


def forget_names(session):
    if not os.path.exists(INDEX):
        return
    with open(INDEX) as f:
        kept = [line for line in f if json.loads(line).get("id") != session]
    with open(INDEX, "w") as f:
        f.writelines(kept)


def delete(args):
    session = args[-1]
    path = find_rollout(session)
    if "--force" not in args or not path:
        sys.stderr.write("Error: failed to delete session\n")
        return 1
    os.remove(path)
    forget_names(session)
    print("Deleted session %s." % session)
    return 0


