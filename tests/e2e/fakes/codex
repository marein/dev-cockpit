def emit(record):
    sys.stdout.write(json.dumps(record) + "\n")
    sys.stdout.flush()


def app_servers():
    me = os.path.realpath(__file__)
    count = 0
    for pid in os.listdir("/proc"):
        try:
            with open("/proc/%s/cmdline" % pid, "rb") as f:
                argv = [a.decode() for a in f.read().split(b"\0") if a]
        except (OSError, ValueError):
            continue
        if "app-server" in argv and any(os.path.realpath(a) == me for a in argv if a.endswith("codex")):
            count += 1
    return count


def restart_server():
    """Kills the cockpit that started this turn and starts it again the way it
    was, like the fake claude's restart_server: the turn is detached and keeps
    writing. The new server inherits none of this turn's descriptors, its lock
    among them."""
    pid, serve = os.getppid(), 0
    while pid > 1:
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                argv = [a.decode() for a in f.read().split(b"\0") if a]
            with open("/proc/%d/stat" % pid) as f:
                parent = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return
        if "serve" in argv:
            serve = pid
            break
        pid = parent
    if not serve:
        return
    cwd = os.readlink("/proc/%d/cwd" % serve)
    os.kill(serve, 15)
    for _ in range(100):
        if not os.path.exists("/proc/%d" % serve):
            break
        time.sleep(0.1)
    log = open(os.environ.get("DC_RESTART_LOG", "/tmp/dc-e2e-restart.log"), "ab")
    subprocess.Popen(argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True, close_fds=True)


def permit(hooks, tool, session):
    """Asks the turn's PreToolUse hook about one call of an MCP tool, the way
    codex does before it runs one, and answers what came of it."""
    if not tool.startswith("mcp__"):
        return "ran unasked"
    for group in hooks:
        if not re.search(group.get("matcher", ""), tool):
            continue
        for hook in group.get("hooks", []):
            call = {"session_id": session.id, "cwd": session.cwd, "hook_event_name": "PreToolUse", "permission_mode": "bypassPermissions",
                    "tool_name": tool, "tool_input": {"query": "general", "limit": 5}, "tool_use_id": "exec-" + str(uuid.uuid4())}
            done = subprocess.run(hook["command"], shell=True, input=json.dumps(call), capture_output=True, text=True, timeout=hook.get("timeout", 60))
            try:
                decision = json.loads(done.stdout)["hookSpecificOutput"]
            except (ValueError, KeyError, TypeError):
                continue
            if decision.get("permissionDecision") == "deny":
                return "denied: " + decision.get("permissionDecisionReason", "")
        return "allowed"
    return "no hook asked"


def turn(args):
    """One turn of an assistant, `codex exec resume --json ... -- <id> <prompt>`,
    in the events codex 0.172.0 writes: thread.started, the two warnings of the
    hook trust flag, turn.started, every agent message as one item, a tool as
    an item that starts and completes, and turn.completed or turn.failed. Its
    argv is noted under $CODEX_HOME/argv, one file per turn. The rollout gets the turn the way a session records one, with the model and
    what the context holds, 68 of 100 thousand tokens, 96 with CONTEXT_HIGH
    and 95 for a check. Prompts steer it like the other fakes: MAGIC, TURNS
    (which turn of the session this is), TOOL, SLOW, FAIL (once per session),
    MODEL, RESTART_CHAT, ECHO_ANSWER (the answer is the rest of the prompt),
    FILELINK (writes assistant-files/proof.txt into the workspace and links it),
    IMAGE (writes assistant-files/pic.png, 40 by 30 pixels, and shows it),
    COCKPIT:<words> (runs `./cockpit <words>` and answers what it printed),
    OWNER (`./cockpit assistant-list`), UNKNOWN (records no version knows,
    around the answer), PERMIT:<tool> (asks the PreToolUse hook about that
    tool, with RESTART_WAIT the cockpit restarts while it waits), COMPACTIONS
    (how many compactions reached codex with the model of each, whether the
    rollout holds a summary and how many app servers of this fake still run)
    and the WAKE_ and EVENT_ words of a check and a reaction."""
    if "--help" in args:
        print(EXEC_HELP)
        return 0
    notes = os.path.join(HOME, "argv")
    os.makedirs(notes, exist_ok=True)
    with open(os.path.join(notes, "%d.json" % time.time_ns()), "w") as f:
        json.dump(["exec", "resume"] + args, f)
    model, hooks, trust_bypassed, positional = "", [], False, []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            positional = args[i + 1:]
            break
        if arg == "-c" and i + 1 < len(args):
            if args[i + 1].startswith("hooks.PreToolUse="):
                hooks = tomllib.loads("v = " + args[i + 1].split("=", 1)[1])["v"]
            i += 2
            continue
        if arg.startswith("--model="):
            model = arg[len("--model="):]
        elif arg == "--dangerously-bypass-hook-trust":
            trust_bypassed = True
        i += 1
    if "--json" not in args or len(positional) != 2:
        sys.stderr.write("error: unexpected argument\n")
        return 2
    session_id, prompt = positional
    if not find_rollout(session_id):
        sys.stderr.write("Error: no rollout found for thread id %s\n" % session_id)
        return 1
    session = Session(session_id, os.getcwd())
    emit({"type": "thread.started", "thread_id": session.id})
    if trust_bypassed:
        for n in range(2):
            emit({"type": "item.completed", "item": {"id": "item_%d" % n, "type": "error",
                  "message": "`--dangerously-bypass-hook-trust` is enabled. Enabled hooks may run without review for this invocation."}})
    emit({"type": "turn.started"})
    if model == "no-such-model":
        words = "The 'no-such-model' model is not supported when using Codex with a ChatGPT account."
        emit({"type": "error", "message": words})
        emit({"type": "turn.failed", "error": {"message": words}})
        return 1

    rollout_turn = begin(session, prompt)
    session.record({"timestamp": stamp(), "type": "turn_context", "payload": {"turn_id": rollout_turn, "cwd": session.cwd, "model": model or "gpt-fake-sol"}})
    items = [10]

    def say_block(text):
        items[0] += 1
        emit({"type": "item.completed", "item": {"id": "item_%d" % items[0], "type": "agent_message", "text": text}})
        item(session, rollout_turn, {"type": "AgentMessage", "id": "msg_" + uuid.uuid4().hex, "content": [{"type": "Text", "text": text}]})

    def tool(command):
        items[0] += 1
        body = {"id": "item_%d" % items[0], "type": "command_execution", "command": "/bin/bash -lc " + json.dumps(command),
                "aggregated_output": "", "exit_code": None, "status": "in_progress"}
        emit({"type": "item.started", "item": body})
        return body

    def tool_done(body):
        emit({"type": "item.completed", "item": dict(body, exit_code=0, status="completed")})

    steering = "you are steering" in prompt
    answer_text = "Fake codex answer."
    if prompt.startswith("ECHO_ANSWER"):
        answer_text = prompt.split("\n", 1)[1] if "\n" in prompt else ""
    elif "SLOW" in prompt:
        if not steering:
            say_block("## Working\n\nstill working")
        if "TOOL" in prompt:
            tool("make all")
        time.sleep(120)
    elif "FAIL" in prompt:
        marker = os.path.join(HOME, "failed-" + session.id)
        if not os.path.exists(marker):
            open(marker, "w").close()
            emit({"type": "turn.failed", "error": {"message": "stream disconnected before completion"}})
            return 1
        answer_text = "Recovered after the retry."
    elif "RESTART_CHAT" in prompt:
        say_block("before the restart")
        restart_server()
        time.sleep(3)
        answer_text = "and after it"
    elif "PERMIT:" in prompt:
        name = re.search(r"PERMIT:(\S+)", prompt).group(1)
        items[0] += 1
        emit({"type": "item.started", "item": {"id": "item_%d" % items[0], "type": "mcp_tool_call", "server": "slack", "tool": name.rsplit("__", 1)[-1],
              "arguments": {}, "result": None, "error": None, "status": "in_progress"}})
        if "RESTART_WAIT" in prompt:
            verdict = []
            asking = threading.Thread(target=lambda: verdict.append(permit(hooks, name, session)))
            asking.start()
            time.sleep(6)
            restart_server()
            asking.join()
            answer_text = "Tool %s: %s" % (name, verdict[0])
        else:
            answer_text = "Tool %s: %s" % (name, permit(hooks, name, session))
    elif "UNKNOWN" in prompt:
        sys.stdout.write("this line is no record at all\n")
        emit({"type": "future.event", "payload": [1, 2, 3]})
        emit({"type": "item.completed", "item": {"id": "item_9", "type": "future_item", "text": "nothing a turn says"}})
        emit({"type": "item.completed", "item": "a string where an object stood"})
        emit({"type": "error", "message": "Reconnecting... 1/5 (stream disconnected)"})
        answer_text = "Read past what nobody knows."
    elif "TOOL" in prompt:
        say_block("Looking at the project.")
        running = tool("ls")
        time.sleep(0.3)
        tool_done(running)
        answer_text = "I looked at the project."
    elif "TURNS" in prompt:
        with open(find_rollout(session.id)) as f:
            asked = sum(1 for line in f if '"UserMessage"' in line)
        answer_text = "turn %d of session %s" % (asked, session.id)
    elif "FILELINK" in prompt:
        os.makedirs(os.path.join(session.cwd, "assistant-files"), exist_ok=True)
        with open(os.path.join(session.cwd, "assistant-files", "proof.txt"), "w") as f:
            f.write("proof from %s\n" % session.cwd)
        answer_text = "Here it is: [the proof](assistant-files/proof.txt)"
    elif "IMAGE" in prompt:
        os.makedirs(os.path.join(session.cwd, "assistant-files"), exist_ok=True)
        with open(os.path.join(session.cwd, "assistant-files", "pic.png"), "wb") as f:
            f.write(base64.b64decode(PNG))
        answer_text = "Here it is:\n\n![the picture](assistant-files/pic.png)"
    elif "COCKPIT:" in prompt:
        words = prompt.split("COCKPIT:", 1)[1].split()
        done = subprocess.run([os.path.join(session.cwd, "cockpit")] + words, capture_output=True, text=True)
        answer_text = "```\n%s\n```" % (done.stdout + done.stderr).strip()
    elif "OWNER" in prompt:
        listed = subprocess.run([os.path.join(session.cwd, "cockpit"), "assistant-list"], capture_output=True, text=True)
        answer_text = "```\n%s\n```" % (listed.stdout + listed.stderr).strip()
    elif "MODEL" in prompt:
        answer_text = "model: " + (model or "default")
    elif "COMPACTIONS" in prompt:
        notes = os.path.join(HOME, "compactions-" + session.id)
        models = open(notes).read().split() if os.path.exists(notes) else []
        with open(find_rollout(session.id)) as f:
            summary = "yes" if any('"type":"compacted"' in line for line in f) else "no"
        answer_text = "compactions: %d (%s), summary: %s, app servers: %d" % (len(models), " ".join(models), summary, app_servers())
    elif "MAGIC" in prompt:
        answer_text = "AIRPORT"
    elif "EVENT_NOTHING" in prompt:
        answer_text = "NOTHING"
    if steering:
        if "WAKE_DONE" in prompt:
            answer_text = "DONE: the job is finished, the file is there."
        elif "WAKE_BLOCKED" in prompt:
            answer_text = "BLOCKED: it needs a decision from you."
        elif "WAKE_NOTHING" in prompt:
            answer_text = "NOTHING"
        else:
            answer_text = "WORKING: still going."

    say_block(answer_text)
    tokens = 95000 if steering else 96000 if "CONTEXT_HIGH" in prompt else 68000
    event(session, "token_count", rollout_turn, info={
        "total_token_usage": {"input_tokens": 3 * tokens}, "last_token_usage": {"input_tokens": tokens, "cached_input_tokens": tokens - 100},
        "model_context_window": 100000})
    event(session, "task_complete", rollout_turn, last_agent_message=answer_text)
    emit({"type": "turn.completed", "usage": {"input_tokens": 3 * tokens, "cached_input_tokens": 2 * tokens, "output_tokens": 5}})
    return 0


def main():
    args = sys.argv[1:]
    if args[:1] == ["--version"]:
        print("codex-cli 0.172.0")
        return 0
    if args[:1] == ["delete"]:
        return delete(args[1:])
    if args[:1] == ["app-server"]:
        return app_server()
    if args[:2] == ["debug", "models"]:
        return debug_models()
    if args[:2] == ["exec", "resume"]:
        return turn(args[2:])
    return interactive(args)


if __name__ == "__main__":
    sys.exit(main())
