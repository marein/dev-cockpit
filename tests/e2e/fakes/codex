def app_server():
    loaded, model = "", "default"
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if "id" not in msg:
            continue
        if msg.get("method") == "thread/start":
            params = msg.get("params") or {}
            session = Session(str(uuid.uuid4()), params.get("cwd", os.getcwd()))
            session.source = params.get("threadSource") or "user"
            session.record({"timestamp": stamp(), "type": "thread_started"})
            answer = {"id": msg["id"], "result": {"thread": {"id": session.id, "path": find_rollout(session.id), "threadSource": session.source}}}
        elif msg.get("method") == "thread/name/set":
            params = msg.get("params") or {}
            if not find_rollout(params.get("threadId", "")):
                answer = {"id": msg["id"], "error": {"code": -32600, "message": "thread not found"}}
            else:
                name_session(params["threadId"], params.get("name", ""))
                answer = {"id": msg["id"], "result": {}}
        elif msg.get("method") == "thread/resume":
            params = msg.get("params") or {}
            loaded = params.get("threadId", "")
            model = params.get("model") or "default"
            if not find_rollout(loaded):
                answer = {"id": msg["id"], "error": {"code": -32600, "message": "no rollout found for thread id %s" % loaded}}
            else:
                answer = {"id": msg["id"], "result": {"thread": {"id": loaded}, "model": model}}
        elif msg.get("method") == "thread/compact/start":
            params = msg.get("params") or {}
            if params.get("threadId") != loaded:
                answer = {"id": msg["id"], "error": {"code": -32600, "message": "thread not found: %s" % params.get("threadId")}}
            else:
                emit({"id": msg["id"], "result": {}})
                compact_thread(loaded, model)
                continue
        else:
            answer = {"id": msg["id"], "result": {"codexHome": HOME}}
        emit(answer)
    return 0


def compact_thread(session_id, model):
    """thread/compact/start the way 0.172.0 runs it: a turn of its own in the
    rollout with the compacted record and a token count that takes in
    nothing, reported as turn/started, an item of type contextCompaction and
    turn/completed. Each one notes the model it ran on in compactions-<id>.
    The prompt of the turn before steers it: COMPACT_LONG takes 6 seconds,
    COMPACT_RESTART restarts the cockpit meanwhile and COMPACT_REFUSE fails the
    turn in codex's words. Every other one takes a second and a half, codex
    takes seconds."""
    with open(find_rollout(session_id)) as f:
        asked = [json.loads(line)["payload"]["item"]["content"][0]["text"] for line in f if '"UserMessage"' in line]
    with open(os.path.join(HOME, "compactions-" + session_id), "a") as f:
        f.write(model + "\n")
    session = Session(session_id, os.getcwd())
    turn = str(uuid.uuid4())
    event(session, "task_started", turn, started_at=int(now().timestamp()))
    emit({"method": "turn/started", "params": {"threadId": session_id, "turn": {"id": turn, "status": "inProgress", "error": None}}})
    emit({"method": "item/started", "params": {"threadId": session_id, "turnId": turn, "item": {"type": "contextCompaction", "id": "c-" + turn}}})
    time.sleep(6 if "COMPACT_LONG" in asked[-1] else 1.5)
    if "COMPACT_RESTART" in asked[-1]:
        restart_server()
        time.sleep(3)
    if "COMPACT_REFUSE" in asked[-1]:
        words = "Compaction failed: the summary was too long."
        event(session, "error", turn, message=words)
        event(session, "task_complete", turn, last_agent_message=None)
        emit({"method": "turn/completed", "params": {"threadId": session_id, "turn": {"id": turn, "status": "failed", "error": {"message": words}}}})
        return
    session.record({"timestamp": stamp(), "ordinal": 1, "type": "compacted", "payload": {"message": "", "replacement_history": [
        {"type": "message", "role": "user", "content": [{"type": "input_text", "text": text}]} for text in asked] + [
        {"type": "compaction", "encrypted_content": "summary of %d turns" % len(asked)}]}})
    event(session, "token_count", turn, info={"last_token_usage": {"input_tokens": 0, "total_tokens": 21000}, "model_context_window": 100000})
    item(session, turn, {"type": "ContextCompaction", "id": "c-" + turn})
    event(session, "task_complete", turn, last_agent_message=None)
    emit({"method": "item/completed", "params": {"threadId": session_id, "turnId": turn, "item": {"type": "contextCompaction", "id": "c-" + turn}}})
    emit({"method": "turn/completed", "params": {"threadId": session_id, "turn": {"id": turn, "status": "completed", "error": None}}})


class Session:
    def __init__(self, session, cwd, bell=False):
        self.id = session
        self.cwd = cwd
        self.bell = bell
        self.file = None
        self.source = "user"

    def record(self, entry):
        if self.file is None:
            path = find_rollout(self.id)
            if path is None:
                day = now()
                folder = os.path.join(HOME, "sessions", day.strftime("%Y"), day.strftime("%m"), day.strftime("%d"))
                os.makedirs(folder, exist_ok=True)
                path = os.path.join(folder, "rollout-%s-%s.jsonl" % (day.strftime("%Y-%m-%dT%H-%M-%S"), self.id))
                self.file = open(path, "a")
                self.write({"timestamp": stamp(), "type": "session_meta", "payload": {
                    "id": self.id, "session_id": self.id, "cwd": self.cwd, "originator": "codex-tui",
                    "cli_version": "0.172.0", "source": "cli", "thread_source": self.source}})
            else:
                self.file = open(path, "a")
        self.write(entry)

    def write(self, entry):
        self.file.write(json.dumps(entry, separators=(",", ":")) + "\n")
        self.file.flush()

    def forget(self):
        path = find_rollout(self.id)
        if path:
            os.remove(path)
        forget_names(self.id)


def background():
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    answer = b""
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\x1b]11;?\x1b\\")
        sys.stdout.flush()
        while not answer.endswith((b"\x1b\\", b"\x07")) and select.select([fd], [], [], 2)[0]:
            answer += os.read(fd, 64)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
    found = re.search(rb"\]11;([^\x07\x1b]*)", answer)
    return found.group(1).decode() if found else "none"


def ring(session):
    if session.bell:
        sys.stdout.write("\x07")
        sys.stdout.flush()


def event(session, kind, turn, **rest):
    session.record({"timestamp": stamp(), "type": "event_msg", "payload": dict({"type": kind, "turn_id": turn}, **rest)})


def item(session, turn, body):
    event(session, "item_completed", turn, thread_id=session.id, item=body)


def begin(session, text):
    turn = str(uuid.uuid4())
    event(session, "task_started", turn, started_at=int(now().timestamp()))
    session.record({"timestamp": stamp(), "type": "response_item", "payload": {
        "type": "message", "role": "user", "content": [{"type": "input_text", "text": "# AGENTS.md instructions nobody typed"}]}})
    session.record({"timestamp": stamp(), "type": "response_item", "payload": {
        "type": "message", "role": "user", "content": [{"type": "input_text", "text": text}]}})
    item(session, turn, {"type": "UserMessage", "id": str(uuid.uuid4()), "content": [{"type": "text", "text": text, "text_elements": []}]})
    return turn


def answer(session, turn, text):
    item(session, turn, {"type": "AgentMessage", "id": "msg_" + uuid.uuid4().hex,
                         "content": [{"type": "Text", "text": text}], "phase": "final_answer"})
    event(session, "task_complete", turn, last_agent_message=text)
    ring(session)


def call(session, command):
    call_id = "call_" + uuid.uuid4().hex
    session.record({"timestamp": stamp(), "type": "response_item", "payload": {
        "type": "custom_tool_call", "call_id": call_id, "name": "exec",
        "input": "text(await tools.exec_command({cmd:%s}))" % json.dumps(command)}})
    return call_id


def ran(session, turn, call_id, command):
    item(session, turn, {"type": "CommandExecution", "id": "exec-" + str(uuid.uuid4()),
                         "command": ["/bin/bash", "-lc", command], "cwd": "file://" + session.cwd,
                         "status": "completed", "aggregated_output": "", "exit_code": 0})
    session.record({"timestamp": stamp(), "type": "response_item", "payload": {
        "type": "custom_tool_call_output", "call_id": call_id, "output": [{"type": "input_text", "text": "Script completed"}]}})


def work(session, turn):
    """Keeps the turn open until Enter (True) or Escape (False)."""
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        beat = 0
        while True:
            if not select.select([fd], [], [], 0.4)[0]:
                beat += 1
                sys.stdout.write("\x1b]0;%d working\x07." % beat)
                sys.stdout.flush()
                continue
            data = os.read(fd, 64)
            if data.startswith(b"\x1b") and not data.startswith(b"\x1b["):
                return False
            if b"\n" in data or b"\r" in data:
                return True
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        say("")


def message(session, mode, text):
    if text == "BG":
        say("BACKGROUND " + background())
        return
    if text == "HOME":
        say("HOMEFILES " + json.dumps(sorted(os.listdir(HOME))))
        return
    if text.startswith("/rename "):
        session.record({"timestamp": stamp(), "type": "renamed"})
        name_session(session.id, text[len("/rename "):].strip())
        say("RENAMED " + text[len("/rename "):].strip())
        return
    turn = begin(session, text)
    say("USER " + json.dumps(text))
    if text == "FORGET":
        session.forget()
        say("FORGOTTEN")
        return
    if text == "LS":
        say("FILES " + json.dumps(sorted(os.listdir(session.cwd))))
        answer(session, turn, "listed")
        return
    if text == "ASK":
        call_id = call(session, "touch /outside")
        if mode == "ask":
            ring(session)
            say("Allow command? (y/n)")
            approved = sys.stdin.readline().strip().lower() == "y"
            ran(session, turn, call_id, "touch /outside")
            say("APPROVED" if approved else "DENIED")
            answer(session, turn, "approved" if approved else "denied")
        else:
            ran(session, turn, call_id, "touch /outside")
            say("RAN without asking")
            answer(session, turn, "ran")
        return
    if text == "WORK":
        call_id = call(session, "make all")
        say("WORKING")
        if work(session, turn):
            ran(session, turn, call_id, "make all")
            say("FINISHED")
            answer(session, turn, "The work is finished.")
        else:
            event(session, "turn_aborted", turn, reason="interrupted")
            say("INTERRUPTED")
        return
    say("ANSWER pong")
    answer(session, turn, "pong")


def interactive(args):
    argv = list(args)
    resume = bool(args) and args[0] == "resume"
    if resume:
        args = args[1:]
    mode, trust, theme, positional = "ask", "", "none", []
    bells = set()
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            positional = args[i + 1:]
            break
        if arg == "-c" and i + 1 < len(args):
            if args[i + 1].startswith("projects="):
                trust = args[i + 1]
            elif args[i + 1].startswith("tui.theme="):
                theme = args[i + 1][len("tui.theme="):]
            elif args[i + 1].startswith("tui.notification"):
                bells.add(args[i + 1])
            i += 2
            continue
        if arg == "--dangerously-bypass-approvals-and-sandbox":
            mode = "yolo"
        elif not arg.startswith("-"):
            positional.append(arg)
        i += 1
    cwd = os.getcwd()
    trusted = (json.dumps(cwd) + '={trust_level="trusted"}') in trust
    say("FAKE CODEX")
    say("ARGV " + json.dumps(argv))
    say("CWD " + cwd)
    say("TRUST " + ("yes" if trusted else "no"))
    say("MODE " + mode)
    say("COLORS %s %s" % (os.environ.get("TERM", ""), os.environ.get("COLORTERM", "unset")))
    say("THEME " + theme)
    bell = bells == {"tui.notifications=true", 'tui.notification_method="bel"', 'tui.notification_condition="always"'}
    say("BELL " + ("on" if bell else "off"))
    if not trusted:
        say("Trust this folder?")
        sys.stdin.readline()
    prompt = ""
    if resume:
        if not positional or not find_rollout(positional[0]):
            say("ERROR: No saved session found with ID %s." % (positional[0] if positional else ""))
            return 1
        session = Session(positional[0], cwd, bell)
        say("RESUMED " + session.id)
        with open(find_rollout(session.id)) as f:
            for line in f:
                body = (json.loads(line).get("payload") or {}).get("item") or {}
                if body.get("type") == "UserMessage":
                    say("HISTORY " + json.dumps(body["content"][0]["text"]))
        session.record({"timestamp": stamp(), "type": "resumed"})
    else:
        session = Session(str(uuid.uuid4()), cwd, bell)
        prompt = positional[0] if positional else ""
    if prompt:
        message(session, mode, prompt)
    while True:
        line = sys.stdin.readline()
        if not line:
            return 0
        text = re.sub(r"\x1b\[20[01]~", "", line).strip()
        if text:
            message(session, mode, text)


