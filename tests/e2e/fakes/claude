#!/bin/bash
# Fake claude for the chats e2e runner: emits the documented stream-json shape,
# persists a minimal session transcript so the cockpit can resume it, and never
# spends a model request.
set -u

print_mode=0
prompt=""
name=""
session=""
resume=0
tools=""
stream=0
partial=0

while [ $# -gt 0 ]; do
  case "$1" in
    --help)
      cat <<'HELP'
Usage: claude [options] [command] [prompt]
Options:
  -p, --print
  --output-format <format>
  --include-partial-messages
  --verbose
  --session-id <uuid>
  -r, --resume [value]
  --tools <tools...>
  --name <name>
  --permission-mode <mode>
  --settings <file-or-json>
HELP
      exit 0
      ;;
    -p|--print)
      print_mode=1
      shift
      if [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; then prompt="$1"; shift; fi
      ;;
    --session-id) session="$2"; shift 2 ;;
    -r|--resume) session="${2:-}"; resume=1; shift 2 ;;
    --tools) tools="$2"; shift 2 ;;
    --output-format) [ "$2" = "stream-json" ] && stream=1; shift 2 ;;
    --include-partial-messages) partial=1; shift ;;
    --verbose) shift ;;
    --name) name="$2"; shift 2 ;;
    --permission-mode) shift 2 ;;
    --settings) shift 2 ;;
    --)
      # The cockpit puts the prompt behind the end of options separator, because
      # claude reads a positional starting with a dash as an option. Everything
      # behind it is text.
      shift
      [ $# -gt 0 ] && [ -z "$prompt" ] && prompt="$1"
      break
      ;;
    -*) shift ;;
    *)
      # A positional argument is the first prompt of an interactive session.
      [ -z "$prompt" ] && prompt="$1"
      shift
      ;;
  esac
done

store="$HOME/.claude/projects/$(printf '%s' "$PWD" | tr '/.' '--')"
mkdir -p "$store"
transcript="$store/$session.jsonl"

json() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }

# record writes one message the way claude does: the session metadata a store
# scan needs plus the message itself. The transcript is what a check reads, so a
# fake that lies about its shape would test nothing.
record() {
  printf '{"type":"%s","sessionId":"%s","cwd":"%s","timestamp":"%s","message":{"role":"%s","content":%s}}\n' \
    "$1" "$session" "$PWD" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" >> "$transcript"
}
record_user() { record user "$(json "$1")"; }
# claude records the name a session was started with, and the cockpit reads it
# back out of the transcript. A check names its own session, which is how a
# session a killed process left behind is recognized afterwards.
record_name() {
  [ -n "$1" ] || return 0
  printf '{"type":"agent-name","sessionId":"%s","cwd":"%s","sessionName":%s}\n' \
    "$session" "$PWD" "$(json "$1")" >> "$transcript"
}
record_assistant() { record assistant "[{\"type\":\"text\",\"text\":$(json "$1")}]"; }

if [ "$print_mode" = "0" ]; then
  echo "fake claude interactive"
  # A task arrives in the argv, never typed into the pane. Printing it is how a
  # test can see that it survived the start.
  [ -n "$prompt" ] && echo "task: $prompt"
  if [ -f "$transcript" ]; then
    python3 -c '
import json,sys
for line in open(sys.argv[1]):
    try: entry = json.loads(line)
    except Exception: continue
    if entry.get("type") == "user" and isinstance(entry.get("message", {}).get("content"), str):
        print("> " + entry["message"]["content"])' "$transcript"
  fi
  echo "resumed $session"
  # The session records what it was asked and what it answered, and then sits
  # there: a coder whose turn is over. With LEAVE_WORKING it never records an
  # answer at all: the last thing is a tool call it still owes a result, which is
  # what a running turn looks like. Writing the answer first and the tool call
  # after would leave a window in which the transcript says the turn is over, and
  # a check landing in that window would be right to call it a standstill.
  [ -n "$prompt" ] && record_user "$prompt"
  case "$prompt" in
    *LEAVE_WORKING*)
      printf '{"type":"assistant","sessionId":"%s","cwd":"%s","timestamp":"%s","message":{"role":"assistant","content":[{"type":"tool_use","name":"Bash","input":{}}]}}\n' \
        "$session" "$PWD" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$transcript"
      ;;
    *) record_assistant "fake claude worked on it." ;;
  esac
  # ALT_SCREEN puts the session where claude lives, on the alternate screen. A
  # program there has no scrollback of its own, so the cockpit scrolls it by
  # sending it the keys it pages with, which is the case the handover rule turns
  # on.
  case "$prompt" in
    *ALT_SCREEN*)
      printf '\033[?1049h'
      echo "fake claude on the alternate screen"
      [ -n "$prompt" ] && echo "task: $prompt"
      ;;
  esac
  # QUESTION leaves the session where a real coder leaves it when it asks: a
  # chooser on the screen and nothing in the transcript, because the tool call of
  # a question is written only once it was answered. The dialog is drawn the way
  # the cockpit recognizes one, a marked option plus the hint line, and the keys
  # are read from the pane, so an answer really has to be pressed.
  case "$prompt" in
    *QUESTION*)
      echo ""
      echo "Do you want me to run the tests now?"
      echo "❯ 1. No, stop here"
      echo "  2. Yes, run them"
      echo "Enter to confirm · Esc to cancel"
      choice=1
      while IFS= read -r -s -n1 key; do
        case "$key" in
          $'\033')
            rest=""
            read -r -s -n2 -t 0.2 rest || true
            case "$rest" in
              "[B") choice=$((choice + 1)) ;;
              "[A") [ "$choice" -gt 1 ] && choice=$((choice - 1)) ;;
            esac
            ;;
          "")
            echo "answered: option $choice"
            record_user "chose option $choice"
            record_assistant "fake claude ran with option $choice."
            break
            ;;
        esac
      done
      ;;
  esac
  while true; do sleep 3600; done
fi

if [ "$stream" = "0" ] || [ "$partial" = "0" ]; then
  echo "Error: When using --print, --output-format=stream-json requires --verbose" >&2
  exit 1
fi

emit() { printf '%s\n' "$1"; }

# restart_server kills the cockpit that started this turn and puts it back the
# way it was. A turn is a detached process writing into a file of its own, so it
# keeps running while its server dies; the server's command line, environment
# and working directory are readable through /proc, which is what makes the
# restart reproducible from inside a turn. The direct parent is the turn host
# holding the turn's lock, killing that one would end the turn itself, so the
# walk climbs the chain until it stands on the serve process.
restart_server() {
  local pid=$PPID parent=""
  while [ -n "$pid" ] && [ "$pid" != "1" ] && [ -r "/proc/$pid/cmdline" ]; do
    if tr '\0' '\n' < "/proc/$pid/cmdline" | grep -qx "serve"; then parent=$pid; break; fi
    pid=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null)
  done
  [ -n "$parent" ] || return 0
  local cwd
  cwd=$(readlink "/proc/$parent/cwd") || return 0
  local argv=() arg
  while IFS= read -r -d '' arg; do argv+=("$arg"); done < "/proc/$parent/cmdline"
  [ ${#argv[@]} -gt 0 ] || return 0
  kill "$parent" 2>/dev/null || return 0
  local waited=0
  while kill -0 "$parent" 2>/dev/null && [ $waited -lt 100 ]; do sleep 0.1; waited=$((waited+1)); done
  (
    cd "$cwd" || exit 0
    # The new server must not inherit this turn's descriptors: the turn's lock
    # travels down from the host as an open fd, and a server holding it would
    # keep the turn alive forever. A server started by cron inherits nothing
    # either, so closing everything is also the honest restart.
    local fds fd
    fds=$(ls /proc/self/fd)
    for fd in $fds; do
      case "$fd" in ''|*[!0-9]*) continue ;; esac
      [ "$fd" -le 2 ] && continue
      eval "exec $fd>&-" 2>/dev/null
    done
    setsid "${argv[@]}" >>"${DC_RESTART_LOG:-/tmp/dc-e2e-restart.log}" 2>&1 &
  )
}

# claude writes the session file as soon as the turn starts, so a turn that is
# killed still leaves its session behind. That is the case the cockpit sweeps at
# startup, so the fake has to leave one too.
record_name "$name"

emit "{\"type\":\"system\",\"subtype\":\"init\",\"tools\":[\"Read\",\"Edit\",\"Write\",\"Bash\",\"Glob\",\"Grep\"],\"session_id\":\"$session\",\"model\":\"fake\"}"
emit '{"type":"system","subtype":"status","status":"working"}'

answer="Fake claude answer."
case "$prompt" in
  *SLOW*)
    # A wake check answers under a contract that covers its whole answer, so the
    # partial line only goes out for a chat turn: prefixed to a verdict it would
    # be a different verdict.
    case "$prompt" in
      *"you are steering"*) : ;;
      *) emit "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"## Working\\n\\nstill working\"}}}" ;;
    esac
    sleep 120
    ;;
  *FAIL*)
    # Fails once per session, so a retry after a failure can succeed.
    if [ ! -f "$store/failed-$session" ]; then
      : > "$store/failed-$session"
      emit "{\"type\":\"result\",\"subtype\":\"error_during_execution\",\"is_error\":true,\"session_id\":\"$session\"}"
      exit 0
    fi
    answer="Recovered after the retry."
    ;;
  *MARKDOWN*)
    # The fenced block is wider than a phone on purpose: an answer full of
    # commands is the normal case, and it must scroll inside its bubble.
    answer='# Heading

`code` and <img src=x onerror=alert(1)> and [link](https://example.com)

```
git log --oneline --graph --decorate --all --since=2020-01-01 --author="a name nobody would ever pick" | head -40
```'
    ;;
  *TOOL*)
    emit "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"content_block\":{\"type\":\"tool_use\",\"name\":\"Edit\"}}}"
    sleep 0.3
    answer="I looked at the project."
    ;;
  *LATER*)
    # Answers only after the caller had time to navigate away, so a test can
    # observe news that nobody has read yet.
    sleep 3
    answer="FLUGHAFEN"
    ;;
  *PAUSE_CHAT*)
    # Half the answer, then nothing at all for longer than the page's watchdog
    # waits, then the rest. That gap is what thinking and a running tool look
    # like on the stream, and what stands on screen has to survive it.
    emit "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"before the pause \"}}}"
    sleep 12
    answer="and after it"
    ;;
  *RESTART_CHAT*)
    # Half the answer, then the server that started this turn is killed and
    # started again. The turn keeps writing, which is the whole point.
    emit "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"before the restart \"}}}"
    restart_server
    sleep 3
    answer="and after it"
    ;;
  *MAGIC*) answer="FLUGHAFEN" ;;
esac

# A check on a watched job. The criterion travels in the prompt, so the test
# steers the verdict with it.
case "$prompt" in
  *"you are steering"*)
    case "$prompt" in
      *WAKE_DONE*)    answer="DONE: the job is finished, the file is there." ;;
      *WAKE_BLOCKED*) answer="BLOCKED: it needs a decision from you." ;;
      *WAKE_NOTHING*) answer="NOTHING" ;;
      # The check survives a restart of the cockpit as well: it is killed
      # halfway through and its verdict still reaches the job.
      *WAKE_RESTART*)
        restart_server
        sleep 3
        answer="DONE: the job is finished, checked across a restart."
        ;;
      # Thinking out loud before the verdict. Everything before it has to be
      # gone by the time the user reads the note.
      *WAKE_PREAMBLE*) answer="I will check the actual state rather than trust the summary.BLOCKED: it needs a decision from you." ;;
      # A coder waiting in a dialog looks like a coder whose turn is over, so
      # the check is the one that finds the dialog and presses the keys. It
      # reports WORKING, because the coder is going again: pressing keys is
      # input like any other, so the standstill rule is satisfied by it.
      *WAKE_ANSWER*)
        # The prompt spells the key-press command out with the executable and the
        # directories of this instance, so the fake runs what it was told to run
        # instead of guessing a cockpit on PATH.
        press=$(printf '%s' "$prompt" | grep -o '`[^`]*coder-send-control-keys [^`]*`' | head -1 | tr -d '`' | sed 's/<key>\.\.\.//')
        [ -n "$press" ] && eval "$press arrow-down enter" >/dev/null 2>&1
        answer="WORKING: pressed enter on \"Yes, run them\", it is running the tests."
        ;;
      # The other honest answer to a coder that stands still: steer it, then
      # report WORKING. The terminal id is read out of the prompt and the
      # credential out of the environment, so this takes the route the prompt
      # describes.
      *WAKE_STEER*)
        term=$(printf '%s' "$prompt" | sed -n 's/^- terminal: //p' | head -1)
        [ -n "$term" ] && dev-cockpit assistant coder-send-prompt "$term" "keep going" >/dev/null 2>&1
        answer="WORKING: nudged it."
        ;;
      *)              answer="WORKING: still going." ;;
    esac
    ;;
esac

half=$(( ${#answer} / 2 ))
for part in "${answer:0:half}" "${answer:half}"; do
  esc=$(printf '%s' "$part" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read())[1:-1])')
  emit "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"$esc\"}}}"
  sleep 0.1
done

record_user "$prompt"
record_assistant "$answer"

# claude reports what the turn consumed on its assistant record and the window of
# every model it used on the result record, so the cockpit never has to guess the
# window for a claude turn. The fake carries the same shape: 68 of 100 thousand
# tokens, a ring two thirds full and still quiet, and CONTEXT_HIGH pushes it to
# 96, where it turns red. A check runs in a session of its own and reports a
# number of its own on purpose: it must never reach the conversation's ring.
context_tokens=68000
case "$prompt" in
  *"you are steering"*) context_tokens=95000 ;;
  *CONTEXT_HIGH*) context_tokens=96000 ;;
esac
emit "{\"type\":\"assistant\",\"message\":{\"model\":\"fake\",\"usage\":{\"input_tokens\":$context_tokens,\"cache_read_input_tokens\":0,\"cache_creation_input_tokens\":0},\"content\":[]}}"

emit "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"session_id\":\"$session\",\"total_cost_usd\":0,\"modelUsage\":{\"fake\":{\"contextWindow\":100000,\"canonicalModel\":\"fake\"}}}"
